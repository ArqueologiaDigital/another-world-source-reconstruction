PRISON_TELEPORT_DOWN_ENTRY:
	mov [0x63], 0x0064
	mov [HERO_Y], [0x52]
	sub [HERO_Y], 0x001E
	play id=0x0057, freq=0x1C, vol=0x40, channel=0x00
	call PRISON_TELEPORT_DOWN_POSE_BY_FACING
	break
	mov [HERO_Y], [0x52]
	call PRISON_TELEPORT_DOWN_POSE_BY_FACING
	setup channel=0x1A, address=PRISON_TELEPORT_LOWER_PAD_SETTLE_LOOP
	jmp LABEL_7E68
LABEL_7E11:
	db 0x11

PRISON_TELEPORT_UP_ENTRY:
	mov [0x63], 0x0064
	mov [HERO_Y], [0x51]
	add [HERO_Y], 0x001E
	play id=0x0057, freq=0x1C, vol=0x40, channel=0x00
	call PRISON_TELEPORT_UP_POSE_BY_FACING
	break
	mov [HERO_Y], [0x51]
	call PRISON_TELEPORT_UP_POSE_BY_FACING
	setup channel=0x1A, address=PRISON_TELEPORT_UPPER_PAD_SETTLE_LOOP
	jmp LABEL_7E68
LABEL_7E34:
	db 0x11

PRISON_TELEPORT_UP_POSE_BY_FACING:
	mov [0xF8], [0x04]
	and [0xF8], 0x0010
	jne [0xF8], 0x00, DRAW_CIN_552
	video offset=CINEMATIC_TELEPORT_UP_BEAM, x=[HERO_X], y=[HERO_Y]
	ret
