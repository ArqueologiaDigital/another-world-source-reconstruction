TEARDOWN_CHANS_AND_KILL_LANDING:
	deleteChannels first=0x00, last=0x08
	deleteChannels first=0x34, last=0x37
	setup channel=0x3B, address=KILL_CHANNEL_LANDING
	ret


PRISON_HERO_UPPER_FLOOR_FLAG_UPDATE:
	mov [0x23], 0x0001
	jl [HERO_Y], [0x41], PRISON_HERO_UPPER_FLOOR_FLAG_UPDATE_RET
	mov [0x23], 0x0000

PRISON_HERO_UPPER_FLOOR_FLAG_UPDATE_RET:
	ret


LABEL_86ED:
	mov [HERO_Y], [0x40]
	je [0x23], 0x00, LABEL_86F9
	mov [HERO_Y], [0x44]

LABEL_86F9:
	ret


PRISON_SCREEN_ENTRY_DISPATCH:
	setup channel=0x10, address=LABEL_12D8
	call LIKELY_A_COPY_PROTECTION_MECHANISM
	setup channel=0x18, address=PRISON_SHIELD_TICK_SLOT_0_ENTRY
	setup channel=0x2F, address=PRISON_DRAW_CIN505_AT_X21_Y27_L17
	setup channel=0x3B, address=KILL_CHANNEL_LANDING
	setup channel=0x3C, address=BLIT_PAGE_00_TO_FF_AND_BREAK
	call PRISON_HERO_UPPER_FLOOR_FLAG_UPDATE
	call INIT_RANGE_48_TO_4D_TO_MAX
	call INIT_VARS_A1_A4_A7_AA_PLUS4
	mov [0x27], [SCREEN_NUM]
	call PRISON_SCREEN_FLOOR_Y_LOOKUP_CASE_01
	je [SCREEN_NUM], 0x65, PRISON_SCREEN_65_ENTRY
	je [SCREEN_NUM], 0x01, PRISON_SCREEN_01_ENTRY
	je [SCREEN_NUM], 0x02, PRISON_SCREEN_02_ENTRY
	je [SCREEN_NUM], 0x03, PRISON_SCREEN_03_ENTRY
	je [SCREEN_NUM], 0x04, PRISON_SCREEN_04_ENTRY
	je [SCREEN_NUM], 0x05, PRISON_SCREEN_05_ENTRY
	je [SCREEN_NUM], 0x23, PRISON_SCREEN_23_ENTRY
	je [SCREEN_NUM], 0x24, PRISON_SCREEN_24_ENTRY
	je [SCREEN_NUM], 0x25, PRISON_SCREEN_25_ENTRY
	je [SCREEN_NUM], 0x44, PRISON_SCREEN_44_ENTRY
	je [SCREEN_NUM], 0x45, PRISON_SCREEN_45_ENTRY

PRISON_REPAINT_BACKDROP_IF_SCREEN_CHANGED:
	je [CACHED_SCREEN_NUM], [SCREEN_NUM], CACHE_SCREEN_NUM_RET
	mov [0xF8], [CACHED_SCREEN_NUM]
	and [0xF8], 0x001F
	jne [0xF8], 0x05, COPY_PAGE0_TO_PAGE_FF
	jl [HERO_X], 0x8C, COPY_PAGE0_TO_PAGE_FF
	jl [HERO_X], 0xBE, CACHE_SCREEN_NUM_RET
