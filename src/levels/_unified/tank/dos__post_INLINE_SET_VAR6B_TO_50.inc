TANK_ARENA_COUNTDOWN_DELAY_THEN_PASS_INIT:
	break
	djnz [0x6B], TANK_ARENA_COUNTDOWN_DELAY_THEN_PASS_INIT
	mov [0x6A], 0x0040
	mov [0x6C], 0x008F
	mov [0x6F], 0x00A0
	jne [0x6E], 0x01, TANK_ARENA_COUNTDOWN_PASS_START_SHRINK_ANIM
	mov [0x6F], 0x0078

TANK_ARENA_COUNTDOWN_PASS_START_SHRINK_ANIM:
	setup channel=0x34, address=TANK_STAGE_EXIT_CAPSULE_LAUNCH_TO_BATHS
	mov [0x6B], 0x000A

TANK_ARENA_COUNTDOWN_SHRINK_PHASE_1_LOOP:
	break
	jg [0x6B], 0x03, TANK_ARENA_COUNTDOWN_SHRINK_PHASE_1_STEP
	je [0x70], 0x01, TANK_ARENA_COUNTDOWN_DROP_ANIM_THEN_CANCEL

TANK_ARENA_COUNTDOWN_SHRINK_PHASE_1_STEP:
	sub [0x6A], 0x0003
	djnz [0x6B], TANK_ARENA_COUNTDOWN_SHRINK_PHASE_1_LOOP
	mov [0x6B], 0x000A

TANK_ARENA_COUNTDOWN_SHRINK_PHASE_2_LOOP:
	break
	je [0x70], 0x01, TANK_ARENA_COUNTDOWN_CANCEL_AFTER_SALVO
	sub [0x6A], 0x0002
	djnz [0x6B], TANK_ARENA_COUNTDOWN_SHRINK_PHASE_2_LOOP
	mov [0x6B], 0x000A

TANK_ARENA_COUNTDOWN_SHRINK_PHASE_3_LOOP:
	break
	sub [0x6A], 0x0001
	jne [0x6E], 0x02, TANK_ARENA_COUNTDOWN_PASS_END_PICK_WRECK_STAMP
	je [0x6B], 0x05, TANK_ARENA_COUNTDOWN_EXPIRED_START_DESTRUCTION

TANK_ARENA_COUNTDOWN_PASS_END_PICK_WRECK_STAMP:
	djnz [0x6B], TANK_ARENA_COUNTDOWN_SHRINK_PHASE_3_LOOP
	setup channel=0x34, address=TANK_ARENA_STAMP_WRECK_CENTRE_ONTO_BACKDROP
	jne [0x6E], 0x01, TANK_ARENA_COUNTDOWN_FLASH_THEN_NEXT_PASS
	setup channel=0x34, address=TANK_ARENA_STAMP_WRECK_LEFT_ONTO_BACKDROP

TANK_ARENA_COUNTDOWN_FLASH_THEN_NEXT_PASS:
	setup channel=0x3C, address=PALETTE_FLASH_1F_TO_01
	mov [0x6B], 0x0002
	add [0x6E], 0x0001
	jl [0x6E], 0x03, TANK_ARENA_COUNTDOWN_DELAY_THEN_PASS_INIT
	setup channel=0x34, address=RESET_PAGES_AND_SETUP_CH_0A
	killChannel

TANK_ARENA_COUNTDOWN_EXPIRED_START_DESTRUCTION:
	setup channel=0x34, address=TANK_DESTROYED_CUTSCENE_BLAST_ENTRY
	killChannel
