TANK_BACKDROP_SWAY_RIGHT_LOOP:
	add [0x0A], 0x0001
	break
	djnz [0x0B], TANK_BACKDROP_SWAY_RIGHT_LOOP
	mov [0x0B], 0x0032

TANK_BACKDROP_SWAY_LEFT_LOOP:
	sub [0x0A], 0x0001
	break
	djnz [0x0B], TANK_BACKDROP_SWAY_LEFT_LOOP
