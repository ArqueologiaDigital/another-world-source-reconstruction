; STAGE ENDING: final cinematic + escape on the pteranodon-creature.
;
; Gameplay role: closing cinematic after all gameplay stages
; complete. The alien friend rescues Lester one last time and they
; ride off together on a giant flying creature.
;
; Branches that ship ENDING:
;   chahi_amiga_1991, dos_1992, cartridge_1992 (genesis_eu).
;
; Structure: only 28 folded bodies. Mostly DRAW_CIN_<N>_TO_<M>
; sequences and PALETTE_FADE animations. Like CAVES, has empty
; post-fold chunks blocking the cleanup pass.
;
; Engine-managed special-purpose VM variables (HERO_POS_*, RANDOM_SEED, PAUSE_SLICES, etc.).
.include "../_common_vars.inc"

; Cross-stage helper EQUs (LABEL_<HEX> / ADDR_AT_* placeholders shared between levels).
.include "_helpers/_helpers_equ_aliases.inc"

; Level-entry bytecode (level start through the first shared folded routine).
.if BRANCH == "chahi_amiga_1991"
.include "ending/amiga__entry.inc"
.elif BRANCH == "cartridge_1992"
.include "ending/cart__entry.inc"
.else
.include "ending/dos__entry.inc"
.endif

; Shared helper: kill-channel landing pad — common cleanup point for many channels.
.include "_helpers/KILL_CHANNEL_LANDING.inc"

; Port-specific body chunk after the shared `KILL_CHANNEL_LANDING` routine.
.if BRANCH == "chahi_amiga_1991"
.include "ending/amiga__post_KILL_CHANNEL_LANDING.inc"
.elif BRANCH == "cartridge_1992"
.include "ending/cart__post_KILL_CHANNEL_LANDING.inc"
.else
.include "ending/dos__post_KILL_CHANNEL_LANDING.inc"
.endif

; ENDING channel teardown — DELETE_ALL_CHANS_AND_KILL + PRELOAD_RESOURCES_8_TO_1.
.include "ending/ending_channel_cleanup.inc"

; ENDING credits cinematic-draw loops — DRAW_CIN_97_TO_100, _101_102, _103_LOOP, _58_ANIM, _59_TO_64. The credits sequence is the alien-natives celebration + spaceship ascent + freeze-frame credits roll.
.include "ending/ending_credits_cinematics.inc"

; ENDING tail: drift / delay helpers (DRIFT_VAR_4_PLUS_10, DRIFT_VAR_3_MINUS_1 variants, DELAY_VAR6_THEN_*) — utility loops that step state vars and gate channel transitions during the credits.
.include "ending/ending_drift_and_delay_helpers.inc"

; ENDING var setups (INIT_VARE_TO_12 et al.).
.include "ending/ending_var_setups.inc"

; ENDING palette-fade sequence (cross-fades between cinematic shots).
.include "ending/ending_palette_fades.inc"

; ENDING palette + var setup (SET_VAR_E6_5_PAL_B et al.).
.include "ending/ending_pal_var_setup.inc"
