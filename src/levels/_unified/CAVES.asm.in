HERO_X		EQU 0x01
HERO_Y		EQU 0x02
; STAGE CAVES: ventilation shafts + cave system + floor-mauler maze.
;
; Gameplay role: after dropping into the vents in PRISON, Lester:
;   1. Rolls through ventilation shafts dodging timed gas-bursts.
;   2. Drops out of the vents into a cave system.
;   3. Falls down successive pits into a graveyard of bones.
;   4. Navigates falling-boulder corridors (timing-based).
;   5. Battles "stranglers" (ceiling vines) and "floor maulers"
;      (suction holes) across multiple screens.
;   6. Super-blasts a wall to set up a later flooding event,
;      then back-tracks. Eventually meets up with the alien friend
;      again to flood the cave system.
;
; Branches that ship CAVES:
;   chahi_amiga_1991, dos_1992, cartridge_1992 (genesis_eu).
;
; This is the largest unified stage by chunk count (264 folded
; bodies) — many routines handle per-screen physics, so the chunk
; tree is deep. CAVES + ENDING currently have empty post-fold chunks
; that block the empty-chunk removal pass (issue tracked).
;
; Engine-managed special-purpose VM variables (HERO_POS_*, RANDOM_SEED, PAUSE_SLICES, etc.).
.include "../_common_vars.inc"

; Per-stage EQU aliases (mid-routine entry points / jump-table arms).
.include "caves/caves_equ_aliases.inc"

; Level-entry bytecode (level start through the first shared folded routine).
.if BRANCH == "chahi_amiga_1991"
.include "caves/amiga__entry.inc"
.elif BRANCH == "cartridge_1992"
.include "caves/cart__entry.inc"
.else
.include "caves/dos__entry.inc"
.endif

; CAVES resource preload (PRELOAD_RES_6A_77_6D_6E_74_76_78_7C — 8 resources).
.include "caves/caves_preload_resources.inc"

; CAVES inline setters / small init helpers (var-derivation chains).
.include "caves/caves_inline_setters_and_init.inc"

; CAVES inline setters cluster (INIT_VARS_E6_68_69_6B et al.).
.include "caves/caves_inline_setters_part1c.inc"

; CAVES scroll setup + scroll-blit helpers (SCROLL_BLIT_P83_TO_PFF).
.include "caves/caves_scroll_setup_and_helpers.inc"

; CAVES scroll init + SFX setup — INIT_VARS_2F_29_12 + PLAY_SFX_005C_CH00 + DEDUP_CAVES_5B_003 (kill-channel teardown). Mostly heavy `;@include "_helpers/*.inc"` of shared math/projection helpers (COMPUTE_VAR26 / INCREMENT_VAR21 / etc.) with arm-specific tails — the fold output of the scroll-init phase.
.include "caves/caves_scroll_init_and_sfx.inc"

; CAVES deduplicated short-body routines (DEDUP_CAVES_6B_*) — auto-salvaged from match_arms rounds.
.include "caves/caves_dedup_helpers_cluster.inc"

; CAVES var22 setters + projection helpers (state-machine bookkeeping).
.include "caves/caves_var22_setters_and_projections.inc"

; CAVES gameplay action helpers — INIT_VARS_E6_EA / LOAD_RES44 / COPY_PAGE0_TO_3_LOAD_RES45 (resource-load helpers); DELETE_GAME_AND_FX_CHANNELS (teardown); INIT_AI_VARS_AT_280_10 (AI-position init); DEDUP_CAVES_5B_035/036 (folded short-body helpers).
.include "caves/caves_action_helpers.inc"

; CAVES animation step-draws — SET_VAR18_TO_0122 var setter, STEP_LEFT4_DRAW_CV140_LEFT4 (multistep walking helper), STEP_DRAW_CV336_THEN_CV340 / STEP_DRAW_CV329_THEN_CV335 (paired-frame draws with walking offsets), and 3 INLINE_BREAK_035 single-instruction break helpers. Filename understates — the "inline breaks" are only 3 of 7 routines.
.include "caves/caves_inline_breaks.inc"
