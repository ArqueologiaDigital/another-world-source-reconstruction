; Unified source for CAVES with one folded shared body.
;
; Architecture: each per-arm `.inc` file is split into `_pre` and
; `_post` chunks separated by the byte address of the shared
; routine. Shared bodies live at the top level and are emitted into
; the assembled output for each branch at the natural assembled
; layout's byte address (no `org` directive needed).
;
; Currently folded routines (in byte-address order within the file):
;   PRELOAD_CAVES_RESOURCES  (58 bytes — amiga+dos only, NOT cart)
;   COPY_HASH_VAR_37_TO_RANGE  (117 bytes — also in CAPSULE, PRISON, 3-arm)
;   INIT_HASH_VARS_67_66_65_68_69  (97 bytes — amiga+cart only, NOT dos)
;   DERIVE_VAR12_11_10_FROM_VAR9  (69 bytes — also in CAPSULE, PRISON, 3-arm)
;   INIT_RANGE_48_TO_4D_TO_MAX  (61 bytes — also in CAPSULE, PRISON, 3-arm)
;
; Per-arm split layout:
;   amiga: pre_a, pre_b, post_a, post_b, post_c, post_d
;   cart:  pre,                post_a, post_b, post_c, post_d  (no pre split — PRELOAD absent)
;   dos:   pre_a, pre_b, post_a,         post_c, post_d        (no post_b — INIT_HASH_67 absent)

;@if BRANCH == "cartridge_1992"
;@include "caves/cart_pre.inc"
;@elif BRANCH == "dos_1992"
;@include "caves/dos_pre_a.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "caves/amiga_pre_a.inc"
;@endif

;@if BRANCH in ("dos_1992", "chahi_amiga_1991")
PRELOAD_CAVES_RESOURCES:
	load id=0x006B	;@raw=0x19,0x00,0x6B
	load id=0x0055	;@raw=0x19,0x00,0x55
	load id=0x0056	;@raw=0x19,0x00,0x56
	load id=0x0057	;@raw=0x19,0x00,0x57
	load id=0x005E	;@raw=0x19,0x00,0x5E
	load id=0x005F	;@raw=0x19,0x00,0x5F
	load id=0x006B	;@raw=0x19,0x00,0x6B
	load id=0x006C	;@raw=0x19,0x00,0x6C
	load id=0x006D	;@raw=0x19,0x00,0x6D
	load id=0x0075	;@raw=0x19,0x00,0x75
	load id=0x0074	;@raw=0x19,0x00,0x74
	load id=0x0078	;@raw=0x19,0x00,0x78
	load id=0x007A	;@raw=0x19,0x00,0x7A
	load id=0x0077	;@raw=0x19,0x00,0x77
	load id=0x0066	;@raw=0x19,0x00,0x66
	load id=0x0088	;@raw=0x19,0x00,0x88
	load id=0x0070	;@raw=0x19,0x00,0x70
	load id=0x0071	;@raw=0x19,0x00,0x71
	load id=0x0072	;@raw=0x19,0x00,0x72
	ret	;@raw=0x05
;@endif

;@if BRANCH == "dos_1992"
;@include "caves/dos_pre_b.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "caves/amiga_pre_b.inc"
;@endif
; (cart has no chunk here — cart_pre above already spans through to COPY_HASH)

COPY_HASH_VAR_37_TO_RANGE:
	mov [0x38], [0x37]	;@raw=0x01,0x38,0x37
	mov [0x39], [0x37]	;@raw=0x01,0x39,0x37
	mov [0x3A], [0x37]	;@raw=0x01,0x3A,0x37
	mov [0x3B], [0x37]	;@raw=0x01,0x3B,0x37
	mov [RANDOM_SEED], [0x37]	;@raw=0x01,0x3C,0x37
	mov [0x3D], [0x37]	;@raw=0x01,0x3D,0x37
	mov [0x3E], [0x37]	;@raw=0x01,0x3E,0x37
	mov [0x3F], [0x37]	;@raw=0x01,0x3F,0x37
	and [0x38], 0x0001	;@raw=0x14,0x38,0x00,0x01
	and [0x39], 0x0002	;@raw=0x14,0x39,0x00,0x02
	and [0x3A], 0x0004	;@raw=0x14,0x3A,0x00,0x04
	and [0x3B], 0x0008	;@raw=0x14,0x3B,0x00,0x08
	and [RANDOM_SEED], 0x0010	;@raw=0x14,0x3C,0x00,0x10
	and [0x3D], 0x0020	;@raw=0x14,0x3D,0x00,0x20
	and [0x3E], 0x0040	;@raw=0x14,0x3E,0x00,0x40
	and [0x3F], 0x0080	;@raw=0x14,0x3F,0x00,0x80
	shl [0x38], 0x0007	;@raw=0x16,0x38,0x00,0x07
	shl [0x39], 0x0002	;@raw=0x16,0x39,0x00,0x02
	shl [0x3A], 0x0003	;@raw=0x16,0x3A,0x00,0x03
	shl [0x3B], 0x0003	;@raw=0x16,0x3B,0x00,0x03
	shr [RANDOM_SEED], 0x0003	;@raw=0x17,0x3C,0x00,0x03
	shr [0x3D], 0x0001	;@raw=0x17,0x3D,0x00,0x01
	shr [0x3E], 0x0006	;@raw=0x17,0x3E,0x00,0x06
	shl [0x3F], 0x0005	;@raw=0x16,0x3F,0x00,0x05
	and [0x37], 0xFF01	;@raw=0x14,0x37,0xFF,0x01
	add [0x37], [0x38]	;@raw=0x02,0x37,0x38
	add [0x37], [0x39]	;@raw=0x02,0x37,0x39
	add [0x37], [0x3A]	;@raw=0x02,0x37,0x3A
	add [0x37], [0x3B]	;@raw=0x02,0x37,0x3B
	add [0x37], [RANDOM_SEED]	;@raw=0x02,0x37,0x3C
	add [0x37], [0x3D]	;@raw=0x02,0x37,0x3D
	add [0x37], [0x3E]	;@raw=0x02,0x37,0x3E
	add [0x37], [0x3F]	;@raw=0x02,0x37,0x3F
	ret	;@raw=0x05

;@if BRANCH == "cartridge_1992"
;@include "caves/cart_post_a.inc"
;@elif BRANCH == "dos_1992"
;@include "caves/dos_post_a.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "caves/amiga_post_a.inc"
;@endif

;@if BRANCH in ("cartridge_1992", "chahi_amiga_1991")
INIT_HASH_VARS_67_66_65_68_69:
	mov [HACK_VAR_67], 0x0001	;@raw=0x00,0x67,0x00,0x01
	mov [0x66], 0x0001	;@raw=0x00,0x66,0x00,0x01
	mov [0x65], 0x0001	;@raw=0x00,0x65,0x00,0x01
	mov [0x68], 0x00C8	;@raw=0x00,0x68,0x00,0xC8
	mov [0x69], 0x00B6	;@raw=0x00,0x69,0x00,0xB6
	mov [0x6A], 0x0001	;@raw=0x00,0x6A,0x00,0x01
	mov [0x6B], 0x3000	;@raw=0x00,0x6B,0x30,0x00
	mov [0x6C], 0x0000	;@raw=0x00,0x6C,0x00,0x00
	mov [0x6D], 0x0000	;@raw=0x00,0x6D,0x00,0x00
	mov [0x30], 0x0064	;@raw=0x00,0x30,0x00,0x64
	mov [0x32], 0x0000	;@raw=0x00,0x32,0x00,0x00
	mov [0xB4], 0x0001	;@raw=0x00,0xB4,0x00,0x01
	mov [0x70], 0x0118	;@raw=0x00,0x70,0x01,0x18
	mov [0x71], 0x00B6	;@raw=0x00,0x71,0x00,0xB6
	mov [0x72], 0x0003	;@raw=0x00,0x72,0x00,0x03
	mov [0x73], 0x2000	;@raw=0x00,0x73,0x20,0x00
	mov [0x74], 0x2008	;@raw=0x00,0x74,0x20,0x08
	mov [0x75], 0x0811	;@raw=0x00,0x75,0x08,0x11
	mov [0x78], 0x0122	;@raw=0x00,0x78,0x01,0x22
	mov [0x79], 0x00B6	;@raw=0x00,0x79,0x00,0xB6
	mov [0x7A], 0x000A	;@raw=0x00,0x7A,0x00,0x0A
	mov [0x7B], 0x2000	;@raw=0x00,0x7B,0x20,0x00
	mov [0x7C], 0x2000	;@raw=0x00,0x7C,0x20,0x00
	mov [0x7D], 0x0800	;@raw=0x00,0x7D,0x08,0x00
	ret	;@raw=0x05
;@endif

;@if BRANCH == "cartridge_1992"
;@include "caves/cart_post_b.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "caves/amiga_post_b.inc"
;@endif
; (dos has no chunk here — dos_post_a above already spans through to DERIVE)

DERIVE_VAR12_11_10_FROM_VAR9:
	and [0x09], 0x03FF	;@raw=0x14,0x09,0x03,0xFF
	mov [0x12], [0x09]	;@raw=0x01,0x12,0x09
	shr [0x12], 0x0007	;@raw=0x17,0x12,0x00,0x07
	mov [0x11], [0x12]	;@raw=0x01,0x11,0x12
	shr [0x11], 0x0001	;@raw=0x17,0x11,0x00,0x01
	mov [0x10], [0x11]	;@raw=0x01,0x10,0x11
	shr [0x10], 0x0001	;@raw=0x17,0x10,0x00,0x01
	and [0x12], 0x0001	;@raw=0x14,0x12,0x00,0x01
	and [0x11], 0x0001	;@raw=0x14,0x11,0x00,0x01
	mov [0x13], [0x10]	;@raw=0x01,0x13,0x10
	add [0x13], [0x11]	;@raw=0x02,0x13,0x11
	add [0x13], [0x12]	;@raw=0x02,0x13,0x12
	and [0x09], 0x007F	;@raw=0x14,0x09,0x00,0x7F
	mov [0x0E], [0x09]	;@raw=0x01,0x0E,0x09
	shr [0x0E], 0x0003	;@raw=0x17,0x0E,0x00,0x03
	mov [0x0D], [0x0E]	;@raw=0x01,0x0D,0x0E
	shr [0x0D], 0x0002	;@raw=0x17,0x0D,0x00,0x02
	and [0x0E], 0x0003	;@raw=0x14,0x0E,0x00,0x03
	and [0x09], 0x0007	;@raw=0x14,0x09,0x00,0x07
	ret	;@raw=0x05

;@if BRANCH == "cartridge_1992"
;@include "caves/cart_post_c.inc"
;@elif BRANCH == "dos_1992"
;@include "caves/dos_post_c.inc"
;@elif BRANCH == "chahi_amiga_1991"
