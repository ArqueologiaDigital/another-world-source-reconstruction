INIT_RANGE_48_TO_4D_TO_MAX:
	mov [0x48], 0x7FFF	;@raw=0x00,0x48,0x7F,0xFF
	mov [0x49], 0x7FFF	;@raw=0x00,0x49,0x7F,0xFF
	mov [0x4A], 0x7FFF	;@raw=0x00,0x4A,0x7F,0xFF
	mov [0x4B], 0x7FFF	;@raw=0x00,0x4B,0x7F,0xFF
	mov [0x4C], 0x7FFF	;@raw=0x00,0x4C,0x7F,0xFF
	mov [0x4D], 0x7FFF	;@raw=0x00,0x4D,0x7F,0xFF
	mov [0x4E], 0x2000	;@raw=0x00,0x4E,0x20,0x00
	mov [0x4F], 0x2000	;@raw=0x00,0x4F,0x20,0x00
	mov [0x50], 0x0FA0	;@raw=0x00,0x50,0x0F,0xA0
	mov [0x88], 0xFFFF	;@raw=0x00,0x88,0xFF,0xFF
	mov [0x89], 0xFFFF	;@raw=0x00,0x89,0xFF,0xFF
	mov [0x8A], 0xFFFF	;@raw=0x00,0x8A,0xFF,0xFF
	mov [0x8B], 0xFFFF	;@raw=0x00,0x8B,0xFF,0xFF
	mov [0x8C], 0xFFFF	;@raw=0x00,0x8C,0xFF,0xFF
	mov [0x8D], 0xFFFF	;@raw=0x00,0x8D,0xFF,0xFF
	ret	;@raw=0x05

