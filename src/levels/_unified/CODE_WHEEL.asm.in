; STAGE CODE_WHEEL: anti-piracy code-wheel protection screen.
;
; Gameplay role: shown before INTRO on amiga 1991 and dos 1992. The
; player rotated a paper code-wheel that came with the game and
; entered the matching symbols on screen. NOT present on cartridge
; ports (snes/genesis) or GBA — those use ROM-baked content with no
; protection layer.
;
; Branches that ship CODE_WHEEL:
;   chahi_amiga_1991, dos_1992 (cartridge ports skip this stage).
;
; Structure: 14 folded bodies dominated by palette fades
; (PAL_FADE_*) and resource loads — the actual code-check logic is
; small. Resource 13 holds the wheel imagery.
;
; Engine-managed special-purpose VM variables (HERO_POS_*, RANDOM_SEED, PAUSE_SLICES, etc.).
.include "../_common_vars.inc"

; Cross-stage helper EQUs (LABEL_<HEX> / ADDR_AT_* placeholders shared between levels).
.include "_helpers/_helpers_equ_aliases.inc"

; Level-entry bytecode (level start through the first shared folded routine).
.if BRANCH == "chahi_amiga_1991"
.include "code_wheel/amiga__entry.inc"
.else
.include "code_wheel/dos__entry.inc"
.endif

	org 0x0000

ENTRY_POINT_OF_CODE_WHEEL:
	call CLEAR_PAGES_1_2_AND_BLIT
	mov [PAUSE_SLICES], 0x0002
	setup channel=0x3C, address=BLITTER_LOOP_WITH_VAR1B_2B
	break
	fill page=0x00, color=0x07
	setup channel=0x14, address=ENTRY_CALL_INIT_4A
	killChannel

; The previous `killChannel` already terminates this task so this
; second one can't execute. No label references this address.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
.endif

INIT_PROGRESS_HASH_VARS:
	add [0x63], 0x0001
	add [0x5A], 0x000D
	add [0x4F], 0x0005
	add [0x68], 0x0007
	add [0x69], 0x0204
	add [0x6A], 0x0002
	add [0x70], 0x1A0C
	add [0x71], 0x004F
	add [0x82], 0x0001
	or [0x83], 0x000F
	or [0x90], 0x0059
	and [0x96], 0x1BD6
	shl [0x4E], 0x0001
	ret


INIT_GAME_STATE_VARS:
	mov [0x31], 0x0000
	mov [0x1B], 0x0000
	mov [0x64], 0x0001
	mov [0x6E], 0x007D
	mov [0x33], 0x2202
	mov [0x34], 0x002D
	mov [0x4E], 0x002E
	mov [0xB4], 0x001A
	mov [0xC5], 0x0236
	mov [0xBE], 0x1ED1
	mov [0x53], 0x004E
.if BRANCH == "dos_1992"
	mov [0x32], 0x0000
.endif
	ret


; INIT_GAME_STATE_VARS ends with `ret` and nothing references this
; address; the next labeled routine GAME_INTRO_PHASE_DRAW_CIN_076 below
; is entered directly. Original disasm: amiga `LABEL_0077: db 0x00,
; 0x54, 0x00, 0x01` (LABEL_0077 was unreferenced); dos has the same
; 4 bytes already decoded as a `mov` with imm 0x0080. Likely leftover
; from a prior HACK_VAR_54 init scheme replaced by the `jl 0x80`
; branching below.
.if INCLUDE_UNREACHABLE_CODE == on
.if BRANCH == "chahi_amiga_1991"
	mov [HACK_VAR_54], 0x0001
.else
	mov [HACK_VAR_54], 0x0080
.endif
.endif

GAME_INTRO_PHASE_DRAW_CIN_076:
	jl [HACK_VAR_54], 0x80, CODEWHEEL_INIT_PALETTE_17_LOAD_RES_47
	fill page=0xFF, color=0x00
	setPalette 0x00
	load id=0x0012
	selectVideoPage 0x00
	video offset=CINEMATIC_INTRO_PHASE_TITLE_SCREEN, x=160, y=100
	selectVideoPage 0xFF
	setup channel=0x2C, address=PAL_FADE_DOWN_1A_TO_4
	mov [0x03], 0x0028

CODEWHEEL_INTRO_DELAY_LOOP_1:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], CODEWHEEL_INTRO_DELAY_LOOP_1
	setup channel=0x2C, address=PAL_FADE_4_TO_18_AND_BACK
	mov [0x03], 0x000A

CODEWHEEL_INTRO_DELAY_LOOP_2:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], CODEWHEEL_INTRO_DELAY_LOOP_2
	jmp CODEWHEEL_INIT_PALETTE_17_LOAD_RES_47

CODEWHEEL_INIT_PALETTE_17_LOAD_RES_47:
	setPalette 0x17
	fill page=0xFF, color=0x00
.if BRANCH == "chahi_amiga_1991"
	fill page=0x00, color=0x00
.elif BRANCH == "dos_1992"
	load id=0x0047
.endif
	setup channel=0x2C, address=PAL_FADE_DOWN_17_TO_11
	mov [0x03], 0x0014

CODEWHEEL_INTRO_DELAY_LOOP_3:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], CODEWHEEL_INTRO_DELAY_LOOP_3
	jmp CODEWHEEL_INIT_PHASE_2_FADE_E_TO_8

CODEWHEEL_INIT_PHASE_2_FADE_E_TO_8:
	fill page=0xFF, color=0x00
	setPalette 0x0E
	jge [HACK_VAR_54], 0x80, LOAD_RESOURCE_13
	load id=0x0053
	selectVideoPage 0x00
	video offset=CINEMATIC_INTRO_PHASE_ALT_TITLE, x=160, y=100
	jmp CODEWHEEL_INTRO_AFTER_TITLE

LOAD_RESOURCE_13:
	load id=0x0013

CODEWHEEL_INTRO_AFTER_TITLE:
	selectVideoPage 0xFF
	setup channel=0x2C, address=PAL_FADE_DOWN_E_TO_8
.if BRANCH == "chahi_amiga_1991"
	mov [0x03], 0x0028
.elif BRANCH == "dos_1992"
	mov [0x03], 0x0050
.endif

; Per-tick blit + (dos only) check HERO_ACTION; if non-zero, branch to
; BANK1_INTRO_TRANSITION ("press any key to continue"). amiga forces
; the player to wait out the timer.
WAIT_FOR_HERO_ACTION_LOOP:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], WAIT_FOR_HERO_ACTION_LOOP
	setup channel=0x2C, address=PAL_FADE_UP_9_TO_F
	mov [0x03], 0x000A

CODEWHEEL_CREDITS_FADE_1_WAIT:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], CODEWHEEL_CREDITS_FADE_1_WAIT
	fill page=0x00, color=0x00
	selectVideoPage 0x00
	text id=0x0181, x=18, y=80, color=0x02 ; " BY"
	text id=0x0182, x=15, y=100, color=0x03 ; "ERIC CHAHI"
	selectVideoPage 0xFF
	break
	setPalette 0x1B
	mov [0x03], 0x003C

CODEWHEEL_CREDITS_PAGE_1_WAIT:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], CODEWHEEL_CREDITS_PAGE_1_WAIT
	break
	fill page=0x00, color=0x00
	selectVideoPage 0x00
	text id=0x0183, x=1, y=80, color=0x04 ; "         MUSIC AND SOUND EFFECTS"
	text id=0x0184, x=20, y=100, color=0x05 ; " "
	text id=0x0185, x=11, y=120, color=0x06 ; "JEAN-FRANCOIS FREITAS"
	selectVideoPage 0xFF
	mov [0x03], 0x003C
	and [HACK_VAR_54], 0x0001
	je [HACK_VAR_54], 0x00, CODEWHEEL_WAIT_LOOP_BREAK_ON_ACTION

CODEWHEEL_CREDITS_PAGE_2_WAIT:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], CODEWHEEL_CREDITS_PAGE_2_WAIT
	break
	fill page=0x00, color=0x00
	selectVideoPage 0x00
	text id=0x0186, x=14, y=80, color=0x04 ; "IBM PC VERSION"
	text id=0x0187, x=14, y=100, color=0x06 ; "      BY"
	text id=0x0188, x=14, y=120, color=0x05 ; " DANIEL MORAIS"
	selectVideoPage 0xFF
	break
	mov [0x03], 0x003C

CODEWHEEL_WAIT_LOOP_BREAK_ON_ACTION:
	break
.if BRANCH == "dos_1992"
	jne [HERO_ACTION], 0x00, BANK1_INTRO_TRANSITION
.endif
	djnz [0x03], CODEWHEEL_WAIT_LOOP_BREAK_ON_ACTION

BANK1_INTRO_TRANSITION:
	fill page=0x00, color=0x00
	break
	break
	bankSwitch 1;  Intro Sequence
	killChannel

; Shared palette-fade helpers used during code-wheel screen transitions.
.include "code_wheel/code_wheel_palette_fades.inc"

; Port-specific body chunk after the shared `PAL_FADE_UP_9_TO_F` routine.
.if BRANCH == "chahi_amiga_1991"
.include "code_wheel/amiga__post_PAL_FADE_UP_9_TO_F.inc"
.else
.include "code_wheel/dos__post_PAL_FADE_UP_9_TO_F.inc"
.endif

COPY_HERO_VARS_TO_29_2A_2B_2C:
	mov [0x0A], [0x29]
	mov [0x0C], [0x2A]
	mov [0x14], [0x2B]
	mov [0x17], [0x2C]
	mov [0x21], 0x0000

CW_COPY_HERO_VARS_TO_29_2A_2B_2C_L0:
	je [0x21], 0x07, INCREMENT_VAR21_MOD_15
	je [0x21], 0x06, INCREMENT_VAR21_MOD_15
	jg [0x21], 0x0D, INCREMENT_VAR21_MOD_15
	mov [0x22], [0x21]
	call SAVE_VAR0A_TO_VAR1D
	call CW_COPY_HERO_VARS_TO_29_2A_2B_2C_L1
	mov [0x22], [0x21]
	call RESTORE_VAR0A_FROM_VAR1D

INCREMENT_VAR21_MOD_15:
	add [0x21], 0x0001
	jl [0x21], 0x0F, CW_COPY_HERO_VARS_TO_29_2A_2B_2C_L0
	mov [0x21], 0x0000

CW_COPY_HERO_VARS_TO_29_2A_2B_2C_L2:
	je [0x21], 0x07, INCREMENT_VAR21_LOOP_TO_16
	je [0x21], 0x06, INCREMENT_VAR21_LOOP_TO_16
	jg [0x21], 0x0D, INCREMENT_VAR21_LOOP_TO_16
	call SUM_HASH_VARS_TO_VAR_37
	mov [0x24], [0x37]
	mov [0x22], [0x24]
	and [0x22], 0x000F
	je [0x22], 0x07, INCREMENT_VAR21_LOOP_TO_16
	je [0x22], 0x06, INCREMENT_VAR21_LOOP_TO_16
	jg [0x22], 0x0D, INCREMENT_VAR21_LOOP_TO_16
	call SAVE_VAR0A_TO_VAR1D
	mov [0x23], [0x1D]
	mov [0x22], [0x21]
	call SAVE_VAR0A_TO_VAR1D
	mov [0x22], [0x24]
	and [0x22], 0x000F
	call RESTORE_VAR0A_FROM_VAR1D
	mov [0x22], [0x21]
	mov [0x1D], [0x23]
	call RESTORE_VAR0A_FROM_VAR1D

INCREMENT_VAR21_LOOP_TO_16:
	add [0x21], 0x0001
	jl [0x21], 0x10, CW_COPY_HERO_VARS_TO_29_2A_2B_2C_L2
	ret


CW_COPY_HERO_VARS_TO_29_2A_2B_2C_L3:
	db 0x11

CW_COPY_HERO_VARS_TO_29_2A_2B_2C_L1:
	jne [0x1D], 0x00, SHARED_RET
	mov [0x30], [0x37]
	and [0x30], 0x001D
	add [0x30], 0x0001

CLEAR_VAR_22:
	mov [0x22], 0x0000

CW_CLEAR_VAR_22_L0:
	call SAVE_VAR0A_TO_VAR1D
	jne [0x1D], [0x30], CW_CLEAR_VAR_22_L1
	add [0x30], 0x0001
	jl [0x30], 0x1F, CLEAR_VAR_22
	mov [0x30], 0x0001
	jmp CLEAR_VAR_22

CW_CLEAR_VAR_22_L1:
	add [0x22], 0x0001
	jl [0x22], 0x0F, CW_CLEAR_VAR_22_L0
	mov [0x1D], [0x30]
	ret


SAVE_VAR0A_TO_VAR1D:
	jne [0x22], 0x00, CW_CLEAR_VAR_22_L2
	mov [0x1D], [0x0A]
	ret


CW_CLEAR_VAR_22_L2:
	jne [0x22], 0x01, CW_CLEAR_VAR_22_L3
	mov [0x1D], [0x0B]
	ret


CW_CLEAR_VAR_22_L3:
	jne [0x22], 0x02, CW_CLEAR_VAR_22_L4
	mov [0x1D], [0x0C]
	ret


CW_CLEAR_VAR_22_L4:
	jne [0x22], 0x03, CW_CLEAR_VAR_22_L5
	mov [0x1D], [0x0D]
	ret


CW_CLEAR_VAR_22_L5:
	jne [0x22], 0x04, CW_CLEAR_VAR_22_L6
	mov [0x1D], [0x0E]
	ret


CW_CLEAR_VAR_22_L6:
	jne [0x22], 0x05, CW_CLEAR_VAR_22_L7
	mov [0x1D], [0x0F]
	ret


CW_CLEAR_VAR_22_L7:
	jne [0x22], 0x06, CW_CLEAR_VAR_22_L8
	mov [0x1D], [0x10]
	ret


CW_CLEAR_VAR_22_L8:
	jne [0x22], 0x07, CW_CLEAR_VAR_22_L9
	mov [0x1D], [0x11]
	ret


CW_CLEAR_VAR_22_L9:
	jne [0x22], 0x08, CW_CLEAR_VAR_22_L10
	mov [0x1D], [0x12]
	ret


CW_CLEAR_VAR_22_L10:
	jne [0x22], 0x09, CW_CLEAR_VAR_22_L11
	mov [0x1D], [0x13]
	ret


CW_CLEAR_VAR_22_L11:
	jne [0x22], 0x0A, CW_CLEAR_VAR_22_L12
	mov [0x1D], [0x14]
	ret


CW_CLEAR_VAR_22_L12:
	jne [0x22], 0x0B, CW_CLEAR_VAR_22_L13
	mov [0x1D], [0x15]
	ret


CW_CLEAR_VAR_22_L13:
	jne [0x22], 0x0C, CW_CLEAR_VAR_22_L14
	mov [0x1D], [0x16]
	ret


CW_CLEAR_VAR_22_L14:
	jne [0x22], 0x0D, CW_CLEAR_VAR_22_L15
	mov [0x1D], [0x17]
	ret


CW_CLEAR_VAR_22_L15:
	jne [0x22], 0x0E, CW_CLEAR_VAR_22_L16
	mov [0x1D], [0x18]
	ret


CW_CLEAR_VAR_22_L16:
	jne [0x22], 0x0F, SHARED_RET
	mov [0x1D], [0x19]
	ret


CW_CLEAR_VAR_22_L17:
	db 0x11

RESTORE_VAR0A_FROM_VAR1D:
	jne [0x22], 0x00, CW_CLEAR_VAR_22_L18
	mov [0x0A], [0x1D]
	ret


CW_CLEAR_VAR_22_L18:
	jne [0x22], 0x01, CW_CLEAR_VAR_22_L19
	mov [0x0B], [0x1D]
	ret


CW_CLEAR_VAR_22_L19:
	jne [0x22], 0x02, CW_CLEAR_VAR_22_L20
	mov [0x0C], [0x1D]
	ret


CW_CLEAR_VAR_22_L20:
	jne [0x22], 0x03, CW_CLEAR_VAR_22_L21
	mov [0x0D], [0x1D]
	ret


CW_CLEAR_VAR_22_L21:
	jne [0x22], 0x04, CW_CLEAR_VAR_22_L22
	mov [0x0E], [0x1D]
	ret


CW_CLEAR_VAR_22_L22:
	jne [0x22], 0x05, CW_CLEAR_VAR_22_L23
	mov [0x0F], [0x1D]
	ret


CW_CLEAR_VAR_22_L23:
	jne [0x22], 0x06, CW_CLEAR_VAR_22_L24
	mov [0x10], [0x1D]
	ret


CW_CLEAR_VAR_22_L24:
	jne [0x22], 0x07, CW_CLEAR_VAR_22_L25
	mov [0x11], [0x1D]
	ret


CW_CLEAR_VAR_22_L25:
	jne [0x22], 0x08, CW_CLEAR_VAR_22_L26
	mov [0x12], [0x1D]
	ret


CW_CLEAR_VAR_22_L26:
	jne [0x22], 0x09, CW_CLEAR_VAR_22_L27
	mov [0x13], [0x1D]
	ret


CW_CLEAR_VAR_22_L27:
	jne [0x22], 0x0A, CW_CLEAR_VAR_22_L28
	mov [0x14], [0x1D]
	ret


CW_CLEAR_VAR_22_L28:
	jne [0x22], 0x0B, CW_CLEAR_VAR_22_L29
	mov [0x15], [0x1D]
	ret


CW_CLEAR_VAR_22_L29:
	jne [0x22], 0x0C, CW_CLEAR_VAR_22_L30
	mov [0x16], [0x1D]
	ret


CW_CLEAR_VAR_22_L30:
	jne [0x22], 0x0D, CW_CLEAR_VAR_22_L31
	mov [0x17], [0x1D]
	ret


CW_CLEAR_VAR_22_L31:
	jne [0x22], 0x0E, CW_CLEAR_VAR_22_L32
	mov [0x18], [0x1D]
	ret


CW_CLEAR_VAR_22_L32:
	jne [0x22], 0x0F, SHARED_RET
	mov [0x19], [0x1D]
	ret


CW_CLEAR_VAR_22_L33:
	db 0x11

CW_CLEAR_VAR_22_L34:
	call DERIVE_VAR07_VAR08_FROM_VAR05
	call DRAW_CODEWHEEL_SYMBOL_BY_VAR06
	ret


SUM_HASH_VARS_TO_VAR_37:
	add [0x37], [HERO_ACTION]
	add [0x37], [HERO_POS_JUMP_DOWN]
	add [0x37], [HACK_VAR_F7]
	add [0x37], [HERO_ACTION_POS_MASK]
	add [0x37], [0x0A]
	add [0x37], [0x14]
	add [0x37], [0x0B]
	add [0x37], [0x28]
	add [0x37], [0x01]
	add [0x37], [0x04]
	add [0x37], [RANDOM_SEED]
	ret


ALL_BANK_VARS_CHECK_ZERO:
	je [0x0A], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x0B], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x0C], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x0D], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x0E], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x12], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x13], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x14], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x15], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x16], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x17], 0x00, RESUME_GAME_INIT_CHANNELS
	ret


ALL_BANK_VARS_CHECK_PAIRWISE_EQ:
	je [0x0A], [0x0B], RESUME_GAME_INIT_CHANNELS
	je [0x0B], [0x0C], RESUME_GAME_INIT_CHANNELS
	je [0x0C], [0x0D], RESUME_GAME_INIT_CHANNELS
	je [0x0D], [0x0E], RESUME_GAME_INIT_CHANNELS
	je [0x0E], [0x0F], RESUME_GAME_INIT_CHANNELS
	je [0x12], [0x0E], RESUME_GAME_INIT_CHANNELS
	je [0x13], [0x0F], RESUME_GAME_INIT_CHANNELS
	je [0x14], [0x0F], RESUME_GAME_INIT_CHANNELS
	je [0x15], [0x14], RESUME_GAME_INIT_CHANNELS
	je [0x16], [0x14], RESUME_GAME_INIT_CHANNELS
	je [0x17], [0x14], RESUME_GAME_INIT_CHANNELS
	ret


CHECK_HASH_AND_CODE_DIGITS_ZERO:
	mov [0x97], [0x37]
	jne [0x37], [0x97], RESUME_GAME_INIT_CHANNELS
	je [0x29], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x2A], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x2B], 0x00, RESUME_GAME_INIT_CHANNELS
	ret


.if BRANCH == "dos_1992"
; dos-only digit-validation: each entered slot (var1E..21)
; must be nonzero for digit-position var02 <= 4. Any slot
; that's zero short-circuits to RESUME_GAME_INIT_CHANNELS
; (treated as a failed code).
CODEWHEEL_VALIDATE_PARTIAL_INPUT:
	je [0x02], 0x04, SHARED_RET
	jne [0x21], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x02], 0x03, SHARED_RET
	jne [0x20], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x02], 0x02, SHARED_RET
	jne [0x1F], 0x00, RESUME_GAME_INIT_CHANNELS
	je [0x02], 0x01, SHARED_RET
	jne [0x1E], 0x00, RESUME_GAME_INIT_CHANNELS
	ret


.endif

SAVE_HERO_INPUT_AND_HASH:
.if BRANCH == "dos_1992"
	mov [HERO_POS_JUMP_DOWN], [HERO_POS_UP_DOWN]
.endif
	call SUM_HASH_VARS_TO_VAR_37
	call CHECK_HASH_AND_CODE_DIGITS_ZERO
	call ALL_BANK_VARS_CHECK_PAIRWISE_EQ
	call ALL_BANK_VARS_CHECK_ZERO
	call INIT_PROGRESS_HASH_VARS
	mov [0xBF], [0x37]
	add [0xC1], [HERO_ACTION_POS_MASK]
	or [0x50], 0x0001
	jne [HERO_ACTION], 0x00, CODEWHEEL_PROCESS_ENTERED_DIGIT
	mov [0x23], [0x01]
	jne [HERO_POS_JUMP_DOWN], 0x01, CODEWHEEL_INPUT_DOWN_KEY_BRANCH
	jg [0x01], 0x07, HANDLE_RIGHT_KEY_EDGE_CHECK
	add [0x01], 0x0008
	jmp HANDLE_RIGHT_KEY_EDGE_CHECK

CODEWHEEL_INPUT_DOWN_KEY_BRANCH:
	jne [HERO_POS_JUMP_DOWN], 0xFFFF, HANDLE_RIGHT_KEY_EDGE_CHECK
	jl [0x01], 0x08, HANDLE_RIGHT_KEY_EDGE_CHECK
	sub [0x01], 0x0008

HANDLE_RIGHT_KEY_EDGE_CHECK:
	jne [HERO_POS_LEFT_RIGHT], 0x01, CODEWHEEL_INPUT_NOT_RIGHT_BRANCH
	je [0x01], 0x07, DERIVE_FOUR_POS_25_26_27_28
	je [0x01], 0x0F, DERIVE_FOUR_POS_25_26_27_28

CODEWHEEL_INPUT_NOT_RIGHT_BRANCH:
	jne [HERO_POS_LEFT_RIGHT], 0xFFFF, CODEWHEEL_INPUT_NOT_LEFT_BRANCH
	je [0x01], 0x00, DERIVE_FOUR_POS_25_26_27_28
	je [0x01], 0x08, DERIVE_FOUR_POS_25_26_27_28

CODEWHEEL_INPUT_NOT_LEFT_BRANCH:
	add [0x01], [HERO_POS_LEFT_RIGHT]
	and [0x01], 0x000F
	jne [0x01], 0x06, CODEWHEEL_POSITION_WRAPAROUND_CHECK
	add [0x01], [HERO_POS_LEFT_RIGHT]

CODEWHEEL_POSITION_WRAPAROUND_CHECK:
	jne [0x01], 0x0E, DERIVE_FOUR_POS_25_26_27_28
	add [0x01], [HERO_POS_LEFT_RIGHT]

DERIVE_FOUR_POS_25_26_27_28:
	mov [0x05], [0x01]
	mov [0x25], [0x07]
	mov [0x26], [0x08]
	call DERIVE_VAR07_VAR08_FROM_VAR05
	mov [0x27], [0x07]
	mov [0x28], [0x08]
	jne [0x25], [0x27], CODEWHEEL_CURSOR_SMOOTH_MOVE_INIT
	jne [0x26], [0x28], CODEWHEEL_CURSOR_SMOOTH_MOVE_INIT
	video offset=CINEMATIC_CODEWHEEL_CURSOR, x=[0x07], y=[0x08]
	break
	jmp SAVE_HERO_INPUT_AND_HASH

; Filler byte (`db 0x11` in original disasm, decoded as killChannel);
; preceding unconditional `jmp` never falls through and no label
; references this address.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
.endif

; Entry point. Copies current cursor position (var25, var26)
; into the draw vars (var07, var08), sets var24 to the
; per-step pixel delta (3 on amiga, 8 on dos), and falls
; into the loop top.
CODEWHEEL_CURSOR_SMOOTH_MOVE_INIT:
	mov [0x07], [0x25]
	mov [0x08], [0x26]
.if BRANCH == "chahi_amiga_1991"
	mov [0x24], 0x0003
.elif BRANCH == "dos_1992"
	mov [0x24], 0x0008
.endif

; One iteration of the interpolation. Dispatches to X-
; direction handler if current > target X.
CODEWHEEL_CURSOR_SMOOTH_MOVE_LOOP_TOP:
	jg [0x25], [0x27], CODEWHEEL_CURSOR_MOVE_X_DEC_STEP
	add [0x07], [0x24]
	jl [0x07], [0x27], CODEWHEEL_CURSOR_MOVE_X_DEC_STEP
	mov [0x07], [0x27]

CODEWHEEL_CURSOR_MOVE_X_DEC_STEP:
	jl [0x25], [0x27], CODEWHEEL_CURSOR_MOVE_Y_INC_STEP
	sub [0x07], [0x24]
	jg [0x07], [0x27], CODEWHEEL_CURSOR_MOVE_Y_INC_STEP
	mov [0x07], [0x27]

CODEWHEEL_CURSOR_MOVE_Y_INC_STEP:
	jg [0x26], [0x28], CODEWHEEL_CURSOR_MOVE_Y_DEC_STEP
	add [0x08], [0x24]
	jl [0x08], [0x28], CODEWHEEL_CURSOR_MOVE_Y_DEC_STEP
	mov [0x08], [0x28]

CODEWHEEL_CURSOR_MOVE_Y_DEC_STEP:
	jl [0x26], [0x28], CODEWHEEL_CURSOR_MOVE_CHECK_ARRIVED
	sub [0x08], [0x24]
	jg [0x08], [0x28], CODEWHEEL_CURSOR_MOVE_CHECK_ARRIVED
	mov [0x08], [0x28]

; If current draw-pos == target, finish (dos additionally
; draws the final cursor frame at the target before
; committing; amiga skips the final draw and commits
; immediately).
CODEWHEEL_CURSOR_MOVE_CHECK_ARRIVED:
	jne [0x07], [0x27], CODEWHEEL_CURSOR_MOVE_INTERMEDIATE_DRAW
	jne [0x08], [0x28], CODEWHEEL_CURSOR_MOVE_INTERMEDIATE_DRAW
.if BRANCH == "dos_1992"
	video offset=CINEMATIC_CODEWHEEL_CURSOR, x=[0x07], y=[0x08]
	break
.endif
	jmp SAVE_HERO_INPUT_AND_HASH

CODEWHEEL_CURSOR_MOVE_INTERMEDIATE_DRAW:
	video offset=CINEMATIC_CODEWHEEL_CURSOR, x=[0x07], y=[0x08]
	break
	jmp CODEWHEEL_CURSOR_SMOOTH_MOVE_LOOP_TOP

; Filler byte (`db 0x11` in original disasm); the preceding
; unconditional `jmp` doesn't fall through.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
.endif

CODEWHEEL_CHECK_ENTERED_CODE:
	setPalette 0x00
.if BRANCH == "chahi_amiga_1991"
	je [0x29], [0x1E], SETUP_CODEWHEEL_CHANNELS
	je [0x29], [0x1F], SETUP_CODEWHEEL_CHANNELS
	je [0x29], [0x20], SETUP_CODEWHEEL_CHANNELS
	je [0x29], [0x21], SETUP_CODEWHEEL_CHANNELS
	jmp SETUP_CODEWHEEL_CHANNELS
.elif BRANCH == "dos_1992"
	shr [0x38], 0x0004
	jne [0x29], [0x38], RESUME_GAME_INIT_CHANNELS
	shr [0x43], 0x0003
	jne [0x2A], [0x43], RESUME_GAME_INIT_CHANNELS
	shr [0x3A], 0x0002
	jne [0x2B], [0x3A], RESUME_GAME_INIT_CHANNELS
	je [0x29], [0x1E], CHECK_VAR2A_OR_DISPATCH_RANGE
	je [0x29], [0x1F], CHECK_VAR2A_OR_DISPATCH_RANGE
	je [0x29], [0x20], CHECK_VAR2A_OR_DISPATCH_RANGE
	je [0x29], [0x21], CHECK_VAR2A_OR_DISPATCH_RANGE
	jmp RESUME_GAME_INIT_CHANNELS
.endif

; 81-byte 3-digit-check chain. Live in dos (called from
; CODEWHEEL_CHECK_ENTERED_CODE above). Also present in amiga's
; bytecode as dead bytes (LABEL_0A17 in the original disasm) — amiga's
; simpler 4-way `[0x29]` match doesn't call into it, but the original
; compiler emitted the chain anyway. Strong evidence that both ports
; share an upstream codebase where the 3-digit codewheel was the
; default, and amiga's build disabled it after compilation.
;
; Reads the entered code digits (var 0x2A, 0x2B, 0x2C) and compares
; each against the per-puzzle expected values (var 0x1E, 0x1F, 0x20,
; 0x21). Any digit that matches any expected slot chains to the next
; digit's check; the final var 0x2C check that matches lands on
; SETUP_CODEWHEEL_CHANNELS (success). Any digit that fails to match
; any slot jumps to RESUME_GAME_INIT_CHANNELS (failure).
.if BRANCH == "dos_1992" or INCLUDE_UNREACHABLE_CODE == on
CHECK_VAR2A_OR_DISPATCH_RANGE:
	je [0x2A], [0x1E], CHECK_VAR2B_OR_DISPATCH_RANGE
	je [0x2A], [0x1F], CHECK_VAR2B_OR_DISPATCH_RANGE
	je [0x2A], [0x20], CHECK_VAR2B_OR_DISPATCH_RANGE
	je [0x2A], [0x21], CHECK_VAR2B_OR_DISPATCH_RANGE
	jmp RESUME_GAME_INIT_CHANNELS

CHECK_VAR2B_OR_DISPATCH_RANGE:
	je [0x2B], [0x1E], CHECK_VAR2C_RANGE_OR_RESUME
	je [0x2B], [0x1F], CHECK_VAR2C_RANGE_OR_RESUME
	je [0x2B], [0x20], CHECK_VAR2C_RANGE_OR_RESUME
	je [0x2B], [0x21], CHECK_VAR2C_RANGE_OR_RESUME
	jmp RESUME_GAME_INIT_CHANNELS

CHECK_VAR2C_RANGE_OR_RESUME:
	je [0x2C], [0x1E], SETUP_CODEWHEEL_CHANNELS
	je [0x2C], [0x1F], SETUP_CODEWHEEL_CHANNELS
	je [0x2C], [0x20], SETUP_CODEWHEEL_CHANNELS
	je [0x2C], [0x21], SETUP_CODEWHEEL_CHANNELS
	jmp RESUME_GAME_INIT_CHANNELS
.endif

SETUP_CODEWHEEL_CHANNELS:
	call SUM_HASH_VARS_TO_VAR_37
	setup channel=0x0A, address=CODEWHEEL_PIN_VAR31_TO_1
	setup channel=0x1E, address=ZERO_VAR31_LOOP
	je [0x31], 0x01, CODEWHEEL_FINALIZE_VAR31_SUCCESS_PATH
	mov [0x31], 0x0001
	mov [0xBC], [0x37]
	or [0xBC], 0x0010
	jmp CODEWHEEL_ERROR_SCREEN_INIT

; Filler byte (`db 0x11` in original disasm); preceding unconditional
; `jmp` doesn't fall through.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
.endif

CODEWHEEL_FINALIZE_VAR31_SUCCESS_PATH:
	jne [0x1B], 0x15, RESUME_GAME_INIT_CHANNELS
	and [0x32], 0x001F
.if BRANCH == "chahi_amiga_1991"
	jl [0x32], 0x03, RESUME_GAME_INIT_CHANNELS
.elif BRANCH == "dos_1992"
	jl [0x32], 0x06, RESUME_GAME_INIT_CHANNELS
.endif
	jl [0x64], 0x14, RESUME_GAME_INIT_CHANNELS
	call SUM_HASH_VARS_TO_VAR_37
	call INIT_PROGRESS_HASH_VARS
	mov [0xC6], [0x37]
	or [0xC6], 0x0080
	call INIT_PROGRESS_HASH_VARS
	setup channel=0x32, address=MARK_VAR67_AND_KILL
	setup channel=0x3F, address=CODEWHEEL_PIN_HACK_VAR67_TO_0
.if BRANCH == "dos_1992"
	mov [0xE4], [0x68]
.endif
	break
	break
	call INIT_PROGRESS_HASH_VARS
.if BRANCH == "chahi_amiga_1991"
	mov [0xF2], 0x1770
	break
	jmp GAME_INTRO_PHASE_DRAW_CIN_076
.else
	mov [0xF2], 0x0FA0
	break
	call INIT_PROGRESS_HASH_VARS
	call SUM_HASH_VARS_TO_VAR_37
	call CODEWHEEL_SUCCESS_SET_E4_OR_14
	jmp GAME_INTRO_PHASE_DRAW_CIN_076
.endif

; Preceding `jmp` doesn't fall through.
.if INCLUDE_UNREACHABLE_CODE == on
	bankSwitch 1
	killChannel
.endif

.if BRANCH == "dos_1992"
CODEWHEEL_SUCCESS_SET_E4_OR_14:
	call CALL_LABEL_0D2E_AND_RET
	or [0xE4], 0x0014
	ret


CALL_LABEL_0D2E_AND_RET:
	call LABEL_0D2E
	ret


LABEL_0D2E:
	call LABEL_0D36
	and [0xE4], 0xFFC3
	ret


LABEL_0D36:
	call WRAP_SUM_HASH_VARS_TO_VAR_37
	call INIT_PROGRESS_HASH_VARS
	ret


WRAP_SUM_HASH_VARS_TO_VAR_37:
	call SUM_HASH_VARS_TO_VAR_37
	ret


.endif

MARK_VAR67_AND_KILL:
	mov [HACK_VAR_67], 0x0001
	killChannel

; `mov [HACK_VAR_67], 0x0000 / break / jmp self`. A
; background channel that continuously pins HACK_VAR_67
; to 0, used as a scene-state marker while the codewheel
; entry is active.
CODEWHEEL_PIN_HACK_VAR67_TO_0:
	mov [HACK_VAR_67], 0x0000
	break
	jmp CODEWHEEL_PIN_HACK_VAR67_TO_0

; Filler byte (`db 0x11` in original disasm, decoded as killChannel).
; The preceding `jmp` is an infinite self-loop so this byte can't
; execute.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
.endif

RESUME_GAME_INIT_CHANNELS:
	deleteChannels first=0x00, last=0x3F
.if BRANCH == "dos_1992"
	mov [0x02], [0x37]
	call INIT_PROGRESS_HASH_VARS
.endif
	setup channel=0x0E, address=CODEWHEEL_INIT_PAGES_AND_PALETTE_1
	setup channel=0x1E, address=BLITTER_LOOP_WITH_VAR1B_2B
	killChannel

CODEWHEEL_INIT_PAGES_AND_PALETTE_1:
.if BRANCH == "chahi_amiga_1991"
	fill page=0x00, color=0x00
.endif
	copyVideoPage src=0x03, dst=0x00
	fill page=0x03, color=0x00
	setPalette 0x01
	mov [0xC9], 0x0001
	killChannel

; Tiny background tasks: `mov [0x31], <const> / break /
; jmp self`. Continuously pin var31 to 0 or 1 each tick;
; set up as separate channels to maintain a "pressed" or
; "released" state visible to the main code-check loop.
CODEWHEEL_PIN_VAR31_TO_1:
	mov [0x31], 0x0001
	break
	jmp CODEWHEEL_PIN_VAR31_TO_1

ZERO_VAR31_LOOP:
	mov [0x31], 0x0000
	break
	jmp ZERO_VAR31_LOOP

CODEWHEEL_PROCESS_ENTERED_DIGIT:
	mov [0x05], [0x01]
.if BRANCH == "chahi_amiga_1991"
	call CODEWHEEL_LOOKUP_VAR06_FROM_VAR_TABLE_BY_VAR05
.elif BRANCH == "dos_1992"
	selectVideoPage 0x00
	video offset=CINEMATIC_074, x=160, y=100
	selectVideoPage 0xFF
	call CODEWHEEL_VALIDATE_PARTIAL_INPUT
	call CODEWHEEL_LOOKUP_VAR06_FROM_VAR_TABLE_BY_VAR05
.endif
	mov [0x22], [0x02]
	je [0x06], 0x63, CODEWHEEL_CHECK_ENTERED_CODE
	jne [0x06], 0x62, CODEWHEEL_INPUT_NOT_DELETE_BRANCH
	and [0x32], 0x003F
	add [0x32], 0x0001
	mov [0x06], 0x0000
	sub [0x22], 0x0001
	jg [0x22], 0x00, CODEWHEEL_CAPTURE_DIGIT_INTO_SLOT
	mov [0x22], 0x0000
	jmp CODEWHEEL_CAPTURE_DIGIT_INTO_SLOT

CODEWHEEL_INPUT_NOT_DELETE_BRANCH:
	je [0x02], 0x04, CODEWHEEL_WAIT_ACTION_RELEASE_LOOP
	add [0x32], 0x0001
	or [0x32], 0x0060
	add [0x22], 0x0001
	add [0x02], 0x0001

; Branch-table that writes var06 (the current entered digit)
; into var1E, var1F, var20, or var21 depending on var02
; (the digit position, 1-4). The "store the digit the
; player just confirmed into the right slot of the four-
; digit code buffer."
CODEWHEEL_CAPTURE_DIGIT_INTO_SLOT:
	jne [0x02], 0x01, CODEWHEEL_CAPTURE_DIGIT_2_INTO_VAR1F
	mov [0x1E], [0x06]

CODEWHEEL_CAPTURE_DIGIT_2_INTO_VAR1F:
	jne [0x02], 0x02, CODEWHEEL_CAPTURE_DIGIT_3_INTO_VAR20
	mov [0x1F], [0x06]

CODEWHEEL_CAPTURE_DIGIT_3_INTO_VAR20:
	jne [0x02], 0x03, CODEWHEEL_CAPTURE_DIGIT_4_INTO_VAR21
	mov [0x20], [0x06]

CODEWHEEL_CAPTURE_DIGIT_4_INTO_VAR21:
	jne [0x02], 0x04, CODEWHEEL_AFTER_CAPTURE
	mov [0x21], [0x06]

CODEWHEEL_AFTER_CAPTURE:
	call CODEWHEEL_DRAW_4_DIGIT_DISPLAY
	mov [0x02], [0x22]

; Compute cursor draw-position from var01 via DERIVE_VAR07_-
; VAR08_FROM_VAR05, draw the cursor sprite, break, and loop
; until HERO_ACTION is released; then jmp SAVE_HERO_INPUT_-
; AND_HASH. The "key-debounce" wait between presses.
CODEWHEEL_WAIT_ACTION_RELEASE_LOOP:
	mov [0x05], [0x01]
	call DERIVE_VAR07_VAR08_FROM_VAR05
	video offset=CINEMATIC_CODEWHEEL_CURSOR, x=[0x07], y=[0x08]
	break
	jne [HERO_ACTION], 0x00, CODEWHEEL_WAIT_ACTION_RELEASE_LOOP
	jmp SAVE_HERO_INPUT_AND_HASH

; Filler byte (`db 0x11` in original disasm); preceding unconditional
; `jmp` doesn't fall through.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
.endif

CODEWHEEL_DRAW_4_DIGIT_DISPLAY:
	mov [0x07], 0x0064
	mov [0x08], 0x0019
	selectVideoPage 0x00
	video offset=CINEMATIC_CODEWHEEL_DIGIT_SLOTS, x=[0x07], y=[0x08]
	mov [0x06], [0x1E]
	call DRAW_CODEWHEEL_SYMBOL_BY_VAR06
	add [0x07], 0x0028
	mov [0x06], [0x1F]
	call DRAW_CODEWHEEL_SYMBOL_BY_VAR06
	add [0x07], 0x0028
	mov [0x06], [0x20]
	call DRAW_CODEWHEEL_SYMBOL_BY_VAR06
	add [0x07], 0x0028
	mov [0x06], [0x21]
	call DRAW_CODEWHEEL_SYMBOL_BY_VAR06
	selectVideoPage 0xFF
	ret


DERIVE_VAR07_VAR08_FROM_VAR05:
	mov [0x07], [0x05]
	mov [0x08], [0x05]
	and [0x07], 0x0007
	and [0x08], 0x0008
	jne [0x08], 0x00, INIT_VAR08_TO_178
	mov [0x08], 0x0086
	jmp COMPUTE_VAR07_TIMES_44_PLUS_20

INIT_VAR08_TO_178:
	mov [0x08], 0x00B2

COMPUTE_VAR07_TIMES_44_PLUS_20:
	shl [0x07], 0x0003
	mov [0xF8], [0x07]
	shl [0xF8], 0x0002
	add [0x07], [0xF8]
	add [0x07], 0x0014
	ret


; --- Shared CODEWHEEL_SYMBOL_BY_VAR06 dispatcher prefix ---
;
; var06 is the codewheel position the player has rotated to;
; this routine draws whatever symbol sits at that position
; (alien glyph, alphanumeric code, OK button, or DEL button).
; The chain handles cases var06 = 0x01..0x1D plus 0x62 (DEL)
; and 0x63 (OK), then falls through to per-arm code for case
; 0x1E (the last shared case in amiga; msdos extends with 10
; more cases for its larger glyph set).
DRAW_CODEWHEEL_SYMBOL_BY_VAR06:
	jne [0x06], 0x01, CODEWHEEL_SYMBOL_DISPATCH_CASE_02
	video offset=CINEMATIC_ALIEN_GLYPH_00, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_02:
	jne [0x06], 0x02, CODEWHEEL_SYMBOL_DISPATCH_CASE_03
	video offset=CINEMATIC_ALIEN_GLYPH_01, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_03:
	jne [0x06], 0x03, CODEWHEEL_SYMBOL_DISPATCH_CASE_04
	video offset=CINEMATIC_ALIEN_GLYPH_02, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_04:
	jne [0x06], 0x04, CODEWHEEL_SYMBOL_DISPATCH_CASE_05
	video offset=CINEMATIC_ALIEN_GLYPH_03, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_05:
	jne [0x06], 0x05, CODEWHEEL_SYMBOL_DISPATCH_CASE_06
	video offset=CINEMATIC_ALIEN_GLYPH_04, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_06:
	jne [0x06], 0x06, CODEWHEEL_SYMBOL_DISPATCH_CASE_07
	video offset=CINEMATIC_ALIEN_GLYPH_05, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_07:
	jne [0x06], 0x07, CODEWHEEL_SYMBOL_DISPATCH_CASE_08
	video offset=CINEMATIC_ALIEN_GLYPH_06, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_08:
	jne [0x06], 0x08, CODEWHEEL_SYMBOL_DISPATCH_CASE_09
	video offset=CINEMATIC_ALIEN_GLYPH_07, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_09:
	jne [0x06], 0x09, CODEWHEEL_SYMBOL_DISPATCH_CASE_0A
	video offset=CINEMATIC_ALIEN_GLYPH_08, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_0A:
	jne [0x06], 0x0A, CODEWHEEL_SYMBOL_DISPATCH_CASE_0B
	video offset=CINEMATIC_ALIEN_GLYPH_09, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_0B:
	jne [0x06], 0x0B, CODEWHEEL_SYMBOL_DISPATCH_CASE_0C
	video offset=CINEMATIC_ALIEN_GLYPH_10, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_0C:
	jne [0x06], 0x0C, CODEWHEEL_SYMBOL_DISPATCH_CASE_0D
	video offset=CINEMATIC_ALIEN_GLYPH_11, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_0D:
	jne [0x06], 0x0D, CODEWHEEL_SYMBOL_DISPATCH_CASE_0E
	video offset=CINEMATIC_ALIEN_GLYPH_12, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_0E:
	jne [0x06], 0x0E, CODEWHEEL_SYMBOL_DISPATCH_CASE_0F
	video offset=CINEMATIC_ALIEN_GLYPH_13, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_0F:
	jne [0x06], 0x0F, CODEWHEEL_SYMBOL_DISPATCH_CASE_10
	video offset=CINEMATIC_ALIEN_GLYPH_14, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_10:
	jne [0x06], 0x10, CODEWHEEL_SYMBOL_DISPATCH_CASE_62
	video offset=CINEMATIC_ALIEN_GLYPH_15, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_62:
	jne [0x06], 0x62, CODEWHEEL_SYMBOL_DISPATCH_CASE_63
	video offset=CINEMATIC_DEL_BUTTON, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_63:
	jne [0x06], 0x63, CODEWHEEL_SYMBOL_DISPATCH_CASE_11
	video offset=CINEMATIC_OK_BUTTON, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_11:
	jne [0x06], 0x11, CODEWHEEL_SYMBOL_DISPATCH_CASE_12
	video offset=CINEMATIC_ALIEN_GLYPH_16, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_12:
	jne [0x06], 0x12, CODEWHEEL_SYMBOL_DISPATCH_CASE_13
	video offset=CINEMATIC_ALIEN_GLYPH_17, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_13:
	jne [0x06], 0x13, CODEWHEEL_SYMBOL_DISPATCH_CASE_14
	video offset=CINEMATIC_ALIEN_GLYPH_18, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_14:
	jne [0x06], 0x14, CODEWHEEL_SYMBOL_DISPATCH_CASE_15
	video offset=CINEMATIC_ALIEN_GLYPH_19, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_15:
	jne [0x06], 0x15, CODEWHEEL_SYMBOL_DISPATCH_CASE_16
	video offset=CINEMATIC_ALIEN_GLYPH_20, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_16:
	jne [0x06], 0x16, CODEWHEEL_SYMBOL_DISPATCH_CASE_17
	video offset=CINEMATIC_ALIEN_GLYPH_21, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_17:
	jne [0x06], 0x17, CODEWHEEL_SYMBOL_DISPATCH_CASE_18
	video offset=CINEMATIC_ALIEN_GLYPH_22, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_18:
	jne [0x06], 0x18, CODEWHEEL_SYMBOL_DISPATCH_CASE_19
	video offset=CINEMATIC_ALIEN_GLYPH_23, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_19:
	jne [0x06], 0x19, CODEWHEEL_SYMBOL_DISPATCH_CASE_1A
	video offset=CINEMATIC_ALIEN_GLYPH_24, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_1A:
	jne [0x06], 0x1A, CODEWHEEL_SYMBOL_DISPATCH_CASE_1B
	video offset=CINEMATIC_ALIEN_GLYPH_25, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_1B:
	jne [0x06], 0x1B, CODEWHEEL_SYMBOL_DISPATCH_CASE_1C
	video offset=CINEMATIC_ALIEN_GLYPH_26, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_1C:
	jne [0x06], 0x1C, CODEWHEEL_SYMBOL_DISPATCH_CASE_1D
	video offset=CINEMATIC_ALIEN_GLYPH_27, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_1D:
	jne [0x06], 0x1D, CODEWHEEL_SYMBOL_DISPATCH_CASE_1E
	video offset=CINEMATIC_ALIEN_GLYPH_28, x=[0x07], y=[0x08], zoom=[0x04]
	ret


; Dispatcher case 0x1E and beyond — diverges per port. amiga's
; codewheel has 30 glyphs (cases up to 0x1E), msdos's has 40
; (continues through 0x28).
.if BRANCH == "chahi_amiga_1991"
CODEWHEEL_SYMBOL_DISPATCH_CASE_1E:
	jne [0x06], 0x1E, SHARED_RET
	video offset=CINEMATIC_ALIEN_GLYPH_29, x=[0x07], y=[0x08], zoom=[0x04]
	ret


.elif BRANCH == "dos_1992"
CODEWHEEL_SYMBOL_DISPATCH_CASE_1E:
	jne [0x06], 0x1E, CODEWHEEL_SYMBOL_DISPATCH_CASE_1F
	video offset=CINEMATIC_ALIEN_GLYPH_29, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_1F:
	jne [0x06], 0x1F, CODEWHEEL_SYMBOL_DISPATCH_CASE_20
	video offset=CINEMATIC_ALIEN_GLYPH_30, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_20:
	jne [0x06], 0x20, CODEWHEEL_SYMBOL_DISPATCH_CASE_21
	video offset=CINEMATIC_ALIEN_GLYPH_31, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_21:
	jne [0x06], 0x21, CODEWHEEL_SYMBOL_DISPATCH_CASE_22
	video offset=CINEMATIC_ALIEN_GLYPH_32, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_22:
	jne [0x06], 0x22, CODEWHEEL_SYMBOL_DISPATCH_CASE_23
	video offset=CINEMATIC_ALIEN_GLYPH_33, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_23:
	jne [0x06], 0x23, CODEWHEEL_SYMBOL_DISPATCH_CASE_24
	video offset=CINEMATIC_ALIEN_GLYPH_34, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_24:
	jne [0x06], 0x24, CODEWHEEL_SYMBOL_DISPATCH_CASE_25
	video offset=CINEMATIC_ALIEN_GLYPH_35, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_25:
	jne [0x06], 0x25, CODEWHEEL_SYMBOL_DISPATCH_CASE_26
	video offset=CINEMATIC_ALIEN_GLYPH_36, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_26:
	jne [0x06], 0x26, CODEWHEEL_SYMBOL_DISPATCH_CASE_27
	video offset=CINEMATIC_ALIEN_GLYPH_37, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_27:
	jne [0x06], 0x27, CODEWHEEL_SYMBOL_DISPATCH_CASE_28
	video offset=CINEMATIC_ALIEN_GLYPH_28_DUP_1, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_28:
	jne [0x06], 0x28, SHARED_RET
	video offset=CINEMATIC_ALIEN_GLYPH_38, x=[0x07], y=[0x08], zoom=[0x04]
	ret


.endif

; Shared epilogue: SHARED_RET (the canonical bail-out point used
; throughout CODE_WHEEL), then three infinite blitter-loop routines
; used as channel coroutines for the codewheel input screen, the
; failure-reset hold frame and the alternate-music error screen.
SHARED_RET:
	ret


; Nothing references this address.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
	video offset=CINEMATIC_079, x=160, y=100
.endif

BLITTER_LOOP_WITH_VAR1B_2B:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF
	mov [0x1B], 0x002B
	break
	jmp BLITTER_LOOP_WITH_VAR1B_2B

; Three infinite frame-hold loops with `mov [0x1B], <const>`
; / break / jmp self. The constants 0x2B vs 0x15 set
; different music/sound IDs (var1B is the audio-track
; slot). 10A3 is used both for initial wheel display and
; for failure-reset; 10B2 is the ERROR-screen idle; 10C1
; is the alternate ERROR-screen with a different track,
; triggered when var31==1 AND var1B==0x2B already (i.e.
; re-entering ERROR after a previous attempt).
CODEWHEEL_ERROR_SCREEN_HOLD_FRAME:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF
	mov [0x1B], 0x002B
	break
	jmp CODEWHEEL_ERROR_SCREEN_HOLD_FRAME

CODEWHEEL_ERROR_SCREEN_HOLD_FRAME_ALT_MUSIC:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF
	mov [0x1B], 0x0015
	break
	jmp CODEWHEEL_ERROR_SCREEN_HOLD_FRAME_ALT_MUSIC

; Shared helper: clear video pages 1 and 2, then blit-chain x8 — used at scene transitions.
.include "_helpers/CLEAR_PAGES_1_2_AND_BLIT.inc"

; No caller reaches these bytes — the preceding `ret` doesn't fall
; through and no label references this address.
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
	killChannel
.if BRANCH == "chahi_amiga_1991"
	db 0x00
.endif
.endif

