;@if BRANCH in ("chahi_amiga_1991", "dos_1992")
COMPUTE_VAR07_TIMES_44_PLUS_20:
	shl [0x07], 0x0003
	mov [0xF8], [0x07]
	shl [0xF8], 0x0002
	add [0x07], [0xF8]
	add [0x07], 0x0014
	ret
;@endif

