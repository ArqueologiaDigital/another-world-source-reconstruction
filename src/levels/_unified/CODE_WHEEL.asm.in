;@if BRANCH in ("chahi_amiga_1991", "dos_1992")
INIT_PROGRESS_HASH_VARS:
	add [0x63], 0x0001
	add [0x5A], 0x000D
	add [0x4F], 0x0005
	add [0x68], 0x0007
	add [0x69], 0x0204
	add [0x6A], 0x0002
	add [0x70], 0x1A0C
	add [0x71], 0x004F
	add [0x82], 0x0001
	or [0x83], 0x000F
	or [0x90], 0x0059
	and [0x96], 0x1BD6
	shl [0x4E], 0x0001
	ret
;@endif

