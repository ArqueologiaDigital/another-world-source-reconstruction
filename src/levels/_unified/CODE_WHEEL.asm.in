COPY_HERO_VARS_TO_29_2A_2B_2C:
	mov [0x0A], [0x29]
	mov [0x0C], [0x2A]
	mov [0x14], [0x2B]
	mov [0x17], [0x2C]
	mov [0x21], 0x0000
;@endif

