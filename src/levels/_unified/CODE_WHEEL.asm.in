COMPUTE_VAR07_TIMES_44_PLUS_20:
	shl [0x07], 0x0003	;@raw=0x16,0x07,0x00,0x03
	mov [0xF8], [0x07]	;@raw=0x01,0xF8,0x07
	shl [0xF8], 0x0002	;@raw=0x16,0xF8,0x00,0x02
	add [0x07], [0xF8]	;@raw=0x02,0x07,0xF8
	add [0x07], 0x0014	;@raw=0x03,0x07,0x00,0x14
	ret	;@raw=0x05
