	video offset=CINEMATIC_ALIEN_GLYPH_17, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_13:
	jne [0x06], 0x13, CODEWHEEL_SYMBOL_DISPATCH_CASE_14
	video offset=CINEMATIC_ALIEN_GLYPH_18, x=[0x07], y=[0x08], zoom=[0x04]
	ret


