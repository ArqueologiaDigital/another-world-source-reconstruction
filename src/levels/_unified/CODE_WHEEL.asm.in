; Unified source for CODE_WHEEL with two folded shared bodies.
;
; Each per-arm `.inc` file is split into chunks separated by the byte
; addresses of the shared routines. Shared bodies live at the top
; level and are emitted into the assembled output for each branch at
; the natural assembled layout's byte address (no `org` directive
; needed).
;
; Currently folded routines (in byte-address order within the file):
;   INIT_PROGRESS_HASH_VARS  (53 bytes — entry-init: progress vars hash setup)
;     amiga: 0x0015   dos: 0x0015
;   CLEAR_PAGES_1_2_AND_BLIT  (15 bytes — clear pages 1,2 and blit; cross-stage shared)
;     amiga: 0x0DC6   dos: 0x10D0
;
; Per-arm split layout (each arm has 3 chunks: pre1, pre2, post):
;   pre1:  [0x0000 .. before INIT_PROGRESS_HASH_VARS]
;   pre2:  [after INIT_PROGRESS .. before CLEAR_PAGES_1_2_AND_BLIT]
;   post:  [after CLEAR_PAGES .. EOF]

;@if BRANCH == "dos_1992"
;@include "code_wheel/dos_pre1.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "code_wheel/amiga_pre1.inc"
;@endif

INIT_PROGRESS_HASH_VARS:
	add [0x63], 0x0001	;@raw=0x03,0x63,0x00,0x01
	add [0x5A], 0x000D	;@raw=0x03,0x5A,0x00,0x0D
	add [0x4F], 0x0005	;@raw=0x03,0x4F,0x00,0x05
	add [0x68], 0x0007	;@raw=0x03,0x68,0x00,0x07
	add [0x69], 0x0204	;@raw=0x03,0x69,0x02,0x04
	add [0x6A], 0x0002	;@raw=0x03,0x6A,0x00,0x02
	add [0x70], 0x1A0C	;@raw=0x03,0x70,0x1A,0x0C
	add [0x71], 0x004F	;@raw=0x03,0x71,0x00,0x4F
	add [0x82], 0x0001	;@raw=0x03,0x82,0x00,0x01
	or [0x83], 0x000F	;@raw=0x15,0x83,0x00,0x0F
	or [0x90], 0x0059	;@raw=0x15,0x90,0x00,0x59
	and [0x96], 0x1BD6	;@raw=0x14,0x96,0x1B,0xD6
	shl [0x4E], 0x0001	;@raw=0x16,0x4E,0x00,0x01
	ret	;@raw=0x05

;@if BRANCH == "dos_1992"
;@include "code_wheel/dos_pre2.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "code_wheel/amiga_pre2.inc"
;@endif

CLEAR_PAGES_1_2_AND_BLIT:
	fill page=0x01, color=0x00	;@raw=0x0E,0x01,0x00
	fill page=0x02, color=0x00	;@raw=0x0E,0x02,0x00
	selectVideoPage 0x01	;@raw=0x0D,0x01
	blitFramebuffer 0x01	;@raw=0x10,0x01
	blitFramebuffer 0xFF	;@raw=0x10,0xFF
	blitFramebuffer 0x02	;@raw=0x10,0x02
	ret	;@raw=0x05

;@if BRANCH == "dos_1992"
;@include "code_wheel/dos_post.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "code_wheel/amiga_post.inc"
;@endif
