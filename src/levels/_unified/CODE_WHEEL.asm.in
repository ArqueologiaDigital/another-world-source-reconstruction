	video offset=CINEMATIC_ALIEN_GLYPH_23, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_19:
	jne [0x06], 0x19, CODEWHEEL_SYMBOL_DISPATCH_CASE_1A
	video offset=CINEMATIC_ALIEN_GLYPH_24, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_1A:
	jne [0x06], 0x1A, CODEWHEEL_SYMBOL_DISPATCH_CASE_1B
	video offset=CINEMATIC_ALIEN_GLYPH_25, x=[0x07], y=[0x08], zoom=[0x04]
	ret


CODEWHEEL_SYMBOL_DISPATCH_CASE_1B:
	jne [0x06], 0x1B, CODEWHEEL_SYMBOL_DISPATCH_CASE_1C
	video offset=CINEMATIC_ALIEN_GLYPH_26, x=[0x07], y=[0x08], zoom=[0x04]
	ret


