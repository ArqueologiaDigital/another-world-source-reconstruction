HERO_AI_DISPATCH:
;@if BRANCH in ("cartridge_1992", "gba_2004")
	jne [HERO_POS_JUMP_DOWN], 0xFFFF, HERO_AI_DISPATCH_AIRBORNE
	jne [0x63], 0x05, DISPATCH_HERO_RUN_RIGHT
	setup channel=0x14, address=HERO_RUN_LEFT_LOOP
	mov [0x63], 0x0064
	jmp HERO_AI_TICK_WAIT_LOOP

DISPATCH_HERO_RUN_RIGHT:
	jne [0x63], 0x06, DISPATCH_HERO_WALK_LEFT
	setup channel=0x14, address=HERO_RUN_RIGHT_LOOP
	mov [0x63], 0x0064
	jmp HERO_AI_TICK_WAIT_LOOP

DISPATCH_HERO_WALK_LEFT:
	jne [0x63], 0x01, DISPATCH_HERO_WALK_RIGHT
	setup channel=0x14, address=HERO_WALK_LEFT_LOOP
	jmp HERO_AI_TICK_WAIT_LOOP

DISPATCH_HERO_WALK_RIGHT:
	jne [0x63], 0x02, HERO_AI_DISPATCH_AIRBORNE
	setup channel=0x14, address=HERO_WALK_RIGHT_LOOP
	jmp HERO_AI_TICK_WAIT_LOOP

HERO_AI_DISPATCH_AIRBORNE:
;@endif
;@if BRANCH == "dos_1992"
	jne [HERO_POS_JUMP_DOWN], 0xFFFF, HERO_AI_DISPATCH_AIRBORNE
	jne [0x63], 0x05, DISPATCH_HERO_RUN_RIGHT
	setup channel=0x14, address=HERO_RUN_LEFT_LOOP
	mov [0x63], 0x0064
	jmp HERO_AI_TICK_WAIT_LOOP

DISPATCH_HERO_RUN_RIGHT:
	jne [0x63], 0x06, DISPATCH_HERO_WALK_LEFT
	setup channel=0x14, address=HERO_RUN_RIGHT_LOOP
	mov [0x63], 0x0064
	jmp HERO_AI_TICK_WAIT_LOOP

DISPATCH_HERO_WALK_LEFT:
	jne [0x63], 0x01, DISPATCH_HERO_WALK_RIGHT
	setup channel=0x14, address=HERO_WALK_LEFT_LOOP
	jmp HERO_AI_TICK_WAIT_LOOP

DISPATCH_HERO_WALK_RIGHT:
	jne [0x63], 0x02, HERO_AI_DISPATCH_AIRBORNE
	setup channel=0x14, address=HERO_WALK_RIGHT_LOOP
	jmp HERO_AI_TICK_WAIT_LOOP

HERO_AI_DISPATCH_AIRBORNE:
;@endif
	jge [HERO_ACTION_POS_MASK], 0x80, AIRBORNE_TRY_LEAP_L
	jne [HERO_POS_LEFT_RIGHT], 0xFFFF, AIRBORNE_TRY_FALL_R
	je [0x63], 0x01, AIRBORNE_TRY_FALL_R
	setup channel=0x14, address=HERO_FALL_LEFT_LOOP
	je [0x63], 0x05, AIRBORNE_SET_STATE_WALK_L
	setup channel=0x14, address=HERO_FALL_LEFT_PRELUDE

AIRBORNE_SET_STATE_WALK_L:
	mov [0x63], 0x0001

AIRBORNE_TRY_FALL_R:
	jne [HERO_POS_LEFT_RIGHT], 0x01, AIRBORNE_TRY_CROUCH_R
	je [0x63], 0x02, AIRBORNE_TRY_CROUCH_R
	setup channel=0x14, address=HERO_FALL_RIGHT_LOOP
	je [0x63], 0x06, AIRBORNE_SET_STATE_WALK_R
	setup channel=0x14, address=HERO_FALL_RIGHT_PRELUDE

AIRBORNE_SET_STATE_WALK_R:
	mov [0x63], 0x0002

AIRBORNE_TRY_CROUCH_R:
	je [0x63], 0x05, AIRBORNE_TRY_CROUCH_L
	je [0x63], 0x01, AIRBORNE_TRY_CROUCH_L
	jne [HERO_ACTION_POS_MASK], 0x04, AIRBORNE_TRY_CROUCH_L
	mov [0x63], 0x0064
	setup channel=0x14, address=HERO_CROUCH_RIGHT_LOOP
	jmp AIRBORNE_DISPATCH_EXIT

AIRBORNE_TRY_CROUCH_L:
	jne [HERO_ACTION_POS_MASK], 0x04, AIRBORNE_DISPATCH_EXIT
	mov [0x63], 0x0064
	setup channel=0x14, address=HERO_CROUCH_LEFT_LOOP

AIRBORNE_DISPATCH_EXIT:
	jmp HERO_AI_TICK_WAIT_LOOP

AIRBORNE_TRY_LEAP_L:
	jne [HERO_ACTION_POS_MASK], 0x82, AIRBORNE_TRY_LEAP_R
	je [0x63], 0x05, AIRBORNE_TRY_LEAP_R
	setup channel=0x14, address=HERO_LEAP_LEFT_LOOP
	jne [0x63], 0x02, AIRBORNE_SET_STATE_RUN_L
	setup channel=0x14, address=HERO_LEAP_LEFT_PRELUDE

AIRBORNE_SET_STATE_RUN_L:
	mov [0x63], 0x0005

AIRBORNE_TRY_LEAP_R:
	jne [HERO_ACTION_POS_MASK], 0x81, AIRBORNE_TRY_KICK_R
	je [0x63], 0x06, AIRBORNE_TRY_KICK_R
	setup channel=0x14, address=HERO_LEAP_RIGHT_LOOP
	jne [0x63], 0x01, AIRBORNE_SET_STATE_RUN_R
	setup channel=0x14, address=HERO_LEAP_RIGHT_PRELUDE

AIRBORNE_SET_STATE_RUN_R:
	mov [0x63], 0x0006

AIRBORNE_TRY_KICK_R:
	je [0x63], 0x01, AIRBORNE_TRY_KICK_L
	je [0x63], 0x05, AIRBORNE_TRY_KICK_L
	jne [HERO_ACTION_POS_MASK], 0x80, AIRBORNE_KICK_EXIT
	mov [0x63], 0x0064
	setup channel=0x14, address=HERO_KICK_RIGHT_LOOP

AIRBORNE_KICK_EXIT:
	jmp HERO_AI_TICK_WAIT_LOOP

AIRBORNE_TRY_KICK_L:
	jne [HERO_ACTION_POS_MASK], 0x80, HERO_AI_TICK_WAIT_LOOP
	mov [0x63], 0x0064
	setup channel=0x14, address=HERO_KICK_LEFT_LOOP

HERO_AI_TICK_WAIT_LOOP:
	break
	je [0x63], 0x64, HERO_AI_TICK_WAIT_LOOP
	jmp HERO_AI_DISPATCH
	killChannel
	break
	add [0x01], 0x0002
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_VIDEO_064_065_AND_CINEMATIC_HERO_SHADOW_RET
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_HERO_FALL_LEFT_F2, x=[0x01], y=[0x02], zoom=[0x03]
;@endif

