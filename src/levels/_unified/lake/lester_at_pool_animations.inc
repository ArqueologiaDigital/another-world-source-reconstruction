CINEMATIC_LAKE_LESTER_AT_POOL		EQU 0xCFD0
.endif
.if BRANCH == "chahi_amiga_1991"
CINEMATIC_LAKE_ENTITY_DROP		EQU 0xDB5A
CINEMATIC_LAKE_LESTER_AT_POOL		EQU 0xE3E0
.endif

.if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F1		EQU 0xD41A
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F2		EQU 0xD4A6
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F3		EQU 0xD512
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F4		EQU 0xD576
CINEMATIC_LAKE_LESTER_FALL_F0		EQU 0xC5FA
CINEMATIC_LAKE_LESTER_FALL_F1		EQU 0xC69A
CINEMATIC_LAKE_SHOOTER_AIM_LEFT_F0		EQU 0xDFE6
CINEMATIC_LAKE_LESTER_FALLING		EQU 0xC556
CINEMATIC_LAKE_SHOT_BEAM_IMPACT		EQU 0xD2D2
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F0		EQU 0xD37A
.endif
.if BRANCH == "chahi_amiga_1991"
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F1		EQU 0xE82A
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F2		EQU 0xE8B6
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F3		EQU 0xE922
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F4		EQU 0xE986
CINEMATIC_LAKE_LESTER_FALL_F0		EQU 0xDA0A
CINEMATIC_LAKE_LESTER_FALL_F1		EQU 0xDAAA
CINEMATIC_LAKE_SHOOTER_AIM_LEFT_F0		EQU 0xFDAE
CINEMATIC_LAKE_LESTER_FALLING		EQU 0xD966
CINEMATIC_LAKE_SHOT_BEAM_IMPACT		EQU 0xE6E2
CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F0		EQU 0xE78A
.endif

LESTER_AT_POOL_LOOP:
	mov [0x28], 0x0014

LESTER_AT_POOL_HOLD:
	video offset=CINEMATIC_LAKE_LESTER_AT_POOL, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_AT_POOL_HOLD
	copyVideoPage src=0x00, dst=0x03
	mov [PAUSE_SLICES], 0x0005
	setup channel=0x15, address=SHOT_BEAM_SWEEP_LEFT
	setup channel=0x16, address=SHOT_MUZZLE_BEAM_LOOP
	video offset=CINEMATIC_LAKE_LESTER_AT_POOL, x=[HERO_X], y=[HERO_Y]
	selectVideoPage 0x00
	video offset=CINEMATIC_LAKE_SHOOTER_AIM_LEFT_F0, x=327, y=164
	selectVideoPage 0xFF
	break
	video offset=CINEMATIC_LAKE_LESTER_FALLING, x=[HERO_X], y=[HERO_Y]
	break
	sub [HERO_X], 0x0003
	sub [HERO_Y], 0x0002
	video offset=CINEMATIC_LAKE_SHOT_BEAM_IMPACT, x=[HERO_X], y=[HERO_Y]
	play id=0x003C, freq=0x0A, vol=0x18, channel=0x01
	break
	copyVideoPage src=0x03, dst=0x00
	selectVideoPage 0x00
	video offset=CINEMATIC_LAKE_SHOOTER_AIM_LEFT_F1, x=327, y=164
	selectVideoPage 0xFF
	mov [0x28], 0x0002

LESTER_KNOCKED_BACK_F0_LOOP:
	sub [HERO_X], 0x000C
	add [HERO_Y], 0x0003
	video offset=CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F0, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_KNOCKED_BACK_F0_LOOP
	mov [0x28], 0x0002

LESTER_KNOCKED_BACK_F1_LOOP:
	sub [HERO_X], 0x000A
	add [HERO_Y], 0x0005
	video offset=CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F1, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_KNOCKED_BACK_F1_LOOP
	mov [0x28], 0x0004

LESTER_KNOCKED_BACK_F2_LOOP:
	sub [HERO_X], 0x0003
	video offset=CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F2, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_KNOCKED_BACK_F2_LOOP
	sub [HERO_X], 0x0002
	video offset=CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F3, x=[HERO_X], y=[HERO_Y]
	break
	sub [HERO_X], 0x0001
	video offset=CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F4, x=[HERO_X], y=[HERO_Y]
	setup channel=0x16, address=LAKE_PALETTE_FADE_IN

LESTER_KNOCKED_BACK_F4_HOLD_LOOP:
	break
	video offset=CINEMATIC_LAKE_LESTER_KNOCKED_BACK_F4, x=[HERO_X], y=[HERO_Y]
	jmp LESTER_KNOCKED_BACK_F4_HOLD_LOOP
	killChannel

LESTER_FALLING_PLAY_AND_ANIM:
	break
	mov [HERO_X], 0x0135
	mov [HERO_Y], 0x00B6
	break
	play id=0x0051, freq=0x0A, vol=0x30, channel=0x01
	video offset=CINEMATIC_LAKE_LESTER_FALLING, x=[HERO_X], y=[HERO_Y]
	break
	sub [HERO_X], 0x0003
	sub [HERO_Y], 0x0002
	video offset=CINEMATIC_LAKE_LESTER_FALL_F0, x=[HERO_X], y=[HERO_Y]
	break
	mov [0x28], 0x0002

LESTER_FALL_PHASE_1:
	sub [HERO_X], 0x000C
	add [HERO_Y], 0x0003
	video offset=CINEMATIC_LAKE_LESTER_FALL_F0, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_FALL_PHASE_1
	mov [0x28], 0x0002

LESTER_FALL_PHASE_2:
	sub [HERO_X], 0x000A
	add [HERO_Y], 0x0005
	video offset=CINEMATIC_LAKE_LESTER_FALL_F1, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_FALL_PHASE_2
	mov [0x28], 0x0005
	mov [0x29], 0xFFFB

LESTER_FALL_BOUNCE_LOOP:
	add [HERO_X], [0x29]
	add [0x29], 0x0001
	video offset=CINEMATIC_LAKE_ENTITY_DROP, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_FALL_BOUNCE_LOOP
	mov [0x28], 0x0003

LESTER_FALL_FINAL_PHASE:
	sub [HERO_X], 0x0001
	video offset=CINEMATIC_LAKE_ENTITY_DROP, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x28], LESTER_FALL_FINAL_PHASE

LESTER_FALL_HOLD_LOOP:
	video offset=CINEMATIC_LAKE_ENTITY_DROP, x=[HERO_X], y=[HERO_Y]
	break
	jmp LESTER_FALL_HOLD_LOOP
	killChannel

