;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_BEAST_HOLD_POSE		EQU 0x5C02
;@endif
;@if BRANCH == "chahi_amiga_1991"
CINEMATIC_BEAST_HOLD_POSE		EQU 0x7012
;@endif

;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_BEAST_APPROACH_FAST_0		EQU 0x5C72
;@endif
;@if BRANCH == "chahi_amiga_1991"
CINEMATIC_BEAST_APPROACH_FAST_0		EQU 0x7082
;@endif

BEAST_SPAWN_MID_RIGHT:
	mov [0x0E], 0x0104
	mov [0x0F], 0x00B6
	mov [COUNTER], 0x001A

BEAST_SPAWN_MR_HOLD_LOOP:
	jne [HACK_VAR_67], 0x05, BEAST_SPAWN_MR_DRAW_BODY
	jg [HERO_X], 0x96, BEAST_SPAWN_MR_AFTER_HOLD

BEAST_SPAWN_MR_DRAW_BODY:
	video offset=CINEMATIC_BEAST_HOLD_POSE, x=[0x0e], y=[0x0f]
	break
	djnz [COUNTER], BEAST_SPAWN_MR_HOLD_LOOP

BEAST_SPAWN_MR_AFTER_HOLD:
	sub [0x0E], 0x000F
	video offset=CINEMATIC_BEAST_APPROACH_FAST_0, x=[0x0e], y=[0x0f]
	break

