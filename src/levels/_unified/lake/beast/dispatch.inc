BEAST_AI_DISPATCH_BY_HERO_SIDE_AND_PHASE:
	jg [0x0C], [HERO_X], BEAST_AI_DISPATCH_RIGHT_OF_HERO_BY_PHASE
	je [0x0D], 0x01, SLUG_PHASE_1_LEFT_INIT
	jg [0x0D], 0x01, SLUG_WALK_GROUND_INIT
	jmp BEAST_BRANCH_ON_VAR_66_AND_2C
	killChannel

BEAST_AI_DISPATCH_RIGHT_OF_HERO_BY_PHASE:
	je [0x0D], 0x01, SLUG_PHASE_1_RIGHT_INIT
	jg [0x0D], 0x01, BEAST_RAND_PICK_FRAME
	jmp BEAST_BRANCH_ON_VAR_66_AND_2C
	killChannel

BEAST_RAND_PICK_FRAME:
	mov [0x0D], 0x00B7
	call COMPUTE_RANDOM_BIT_MASKS
	je [0x39], 0x01, SLUG_F1_PROXIMITY_CHK
	je [0x39], 0x02, SLUG_F3_PROXIMITY_CHK
	je [0x39], 0x03, SLUG_F5_PROXIMITY_CHK

