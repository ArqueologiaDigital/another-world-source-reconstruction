CHECK_HORIZONTAL_PROXIMITY:
	mov [0x07], 0x0000
	mov [0x12], [HERO_X]
	sub [0x12], 0x0007
	jl [0x0C], [0x12], EXIT_PATH_FROM_PROXIMITY_OUT_OF_RANGE
	add [0x12], 0x000F
	jg [0x0C], [0x12], EXIT_PATH_FROM_PROXIMITY_OUT_OF_RANGE
	mov [0x07], 0x0001

EXIT_PATH_FROM_PROXIMITY_OUT_OF_RANGE:
	je [0x06], 0x00, BEAST_RANGE_CHECK_OUT_OF_RANGE_RET
	jg [0x06], 0x02, BEAST_RANGE_CHECK_OUT_OF_RANGE_RET
;@if BRANCH in ("cartridge_1992", "gba_2004")
	jg [HERO_X], [0x04], BEAST_RANGE_CHECK_INIT_CART
;@endif
	mov [0x12], [0x04]
	mov [0x13], [0x04]
;@if BRANCH in ("cartridge_1992", "gba_2004")
	add [0x12], 0x0008
	sub [0x13], 0x000C
	jmp BEAST_RANGE_CHECK_VAR_39
;@elif BRANCH in ("chahi_amiga_1991", "dos_1992")
	sub [0x13], 0x0007
	jl [HERO_X], [0x04], BEAST_RANGE_CHECK_INIT_CART
	mov [0x13], [0x04]
	mov [0x12], [0x04]
	add [0x12], 0x0007
;@endif

BEAST_RANGE_CHECK_INIT_CART:
;@if BRANCH in ("cartridge_1992", "gba_2004")
	mov [0x13], [0x04]
	mov [0x12], [0x04]
	sub [0x13], 0x0008
	add [0x12], 0x000C

BEAST_RANGE_CHECK_VAR_39:
	mov [0x3A], [0x0C]
	sub [0x3A], 0x0004
	je [0x39], 0x01, BEAST_RANGE_BOUNDS_CHK
	add [0x3A], 0x0008

BEAST_RANGE_BOUNDS_CHK:
	jg [0x3A], [0x12], BEAST_RANGE_CHECK_OUT_OF_RANGE_RET
	jl [0x3A], [0x13], BEAST_RANGE_CHECK_OUT_OF_RANGE_RET
;@elif BRANCH in ("chahi_amiga_1991", "dos_1992")
	jg [0x0C], [0x12], BEAST_RANGE_CHECK_OUT_OF_RANGE_RET
	jl [0x0C], [0x13], BEAST_RANGE_CHECK_OUT_OF_RANGE_RET
;@endif
	mov [0x07], 0x0002

BEAST_RANGE_CHECK_OUT_OF_RANGE_RET:
	ret


BEAST_OR_SLUG_PROXIMITY_DISPATCH:
	je [0x07], 0x01, BEAST_PROXIMITY_AI_FRAMES_WITH_HIT_SOUND
	je [0x07], 0x02, SLUG_PROXIMITY_RECOIL_LEFT_THEN_ANIMATE
	killChannel

SLUG_FLIP_OR_PROXIMITY_DISPATCH:
	je [0x07], 0x01, SLUG_FLIP_WALKS
	je [0x07], 0x02, SLUG_PROXIMITY_ANIMATION_FRAMES
	killChannel

