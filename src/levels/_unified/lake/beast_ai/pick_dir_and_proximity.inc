BEAST_AI_BRANCH_ON_VAR_66_AND_2C:
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x0D], 0xFFFF
	jne [0x66], 0x03, BEAST_AI_DECREMENT_VAR_2D
	sub [0x2C], 0x0001
	jl [0x2C], 0x00, KILL_IF_VAR_2D_NEGATIVE

BEAST_AI_DECREMENT_VAR_2D:
	jne [0x66], 0x04, BEAST_AI_PICK_RANDOM_DIR
	sub [0x2D], 0x0001
	jl [0x2D], 0x00, KILL_IF_VAR_2D_NEGATIVE

BEAST_AI_PICK_RANDOM_DIR:
	mov [0x0C], [0x3F]
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x13], [0x3E]
	add [0x13], 0x0014
	jg [0x0C], [HERO_X], SLUG_PHASE_1_RIGHT_INIT
	jmp SLUG_PHASE_1_LEFT_INIT

KILL_IF_VAR_2D_NEGATIVE:
	killChannel

FLAG_PROXIMITY_TRUE_THEN_CHECK:
;@if BRANCH in ("cartridge_1992", "gba_2004")
	mov [0x39], 0x0001
;@endif
	jmp CHECK_HORIZONTAL_PROXIMITY
	ret
;@if BRANCH in ("cartridge_1992", "gba_2004")

CLEAR_PROXIMITY_FLAG_THEN_CHECK:
	mov [0x39], 0x0000
;@endif

