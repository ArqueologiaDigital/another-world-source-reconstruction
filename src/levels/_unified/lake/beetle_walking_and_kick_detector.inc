BEETLE_WALKING_RIGHT:
	video type=1, offset=CINEMATIC_BEETLE_WALKING_RIGHT_0, x=[0x0a], y=[0x0b], zoom=0x40
	break
	video type=1, offset=CINEMATIC_BEETLE_WALKING_RIGHT_0, x=[0x0a], y=[0x0b], zoom=0x40
	add [0x0A], 0x0001
	break
	video type=1, offset=CINEMATIC_BEETLE_WALKING_RIGHT_1, x=[0x0a], y=[0x0b], zoom=0x40
	break
