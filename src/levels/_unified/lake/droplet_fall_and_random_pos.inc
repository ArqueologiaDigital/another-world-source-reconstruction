CINEMATIC_DROPLET_FALL_TRAIL		EQU 0x00A4

;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_DROPLET_IMPACT_0		EQU 0xDDFA
CINEMATIC_DROPLET_IMPACT_1		EQU 0xDE0E
CINEMATIC_DROPLET_IMPACT_2		EQU 0xDE2E
;@endif
;@if BRANCH == "chahi_amiga_1991"
CINEMATIC_DROPLET_IMPACT_0		EQU 0xF20A
CINEMATIC_DROPLET_IMPACT_1		EQU 0xF21E
CINEMATIC_DROPLET_IMPACT_2		EQU 0xF23E
;@endif

DROPLET_FALL_AND_IMPACT_LOOP:
	mov [0x82], 0x00A7
	mov [0x83], 0x0000
	mov [0x84], 0x004E

DROPLET_FALL_LOOP_BODY:
	break
	video type=1, offset=CINEMATIC_DROPLET_FALL_TRAIL, x=[0x82], y=[0x83], zoom=0x40
	add [0x83], 0x000E
	jl [0x83], [0x84], DROPLET_FALL_LOOP_BODY
	break
	video type=1, offset=CINEMATIC_DROPLET_IMPACT_0, x=[0x82], y=[0x84], zoom=0x40
	break
	video type=1, offset=CINEMATIC_DROPLET_IMPACT_1, x=[0x82], y=[0x84], zoom=0x40
	break
	video type=1, offset=CINEMATIC_DROPLET_IMPACT_2, x=[0x82], y=[0x84], zoom=0x40
	break
	call COMPUTE_RANDOM_BIT_MASKS
	jne [0x3B], 0x00, DROPLET_POS_CHECK_CASE_1
	mov [0x82], 0x00B4
	mov [0x84], 0x003C

DROPLET_POS_CHECK_CASE_1:
	jne [0x3B], 0x01, DROPLET_POS_CHECK_CASE_2
	mov [0x82], 0x00A4
	mov [0x84], 0x0010

DROPLET_POS_CHECK_CASE_2:
	jne [0x3B], 0x02, DROPLET_POS_CHECK_CASE_3
	mov [0x82], 0x0069
	mov [0x84], 0x0004

DROPLET_POS_CHECK_CASE_3:
	jne [0x3B], 0x03, DROPLET_POS_CHECK_CASE_4
	mov [0x82], 0x006D
	mov [0x84], 0x0039

DROPLET_POS_CHECK_CASE_4:
	jne [0x3B], 0x04, DROPLET_POS_CHECK_CASE_5
	mov [0x82], 0x005F
	mov [0x84], 0x0075

DROPLET_POS_CHECK_CASE_5:
	jne [0x3B], 0x05, DROPLET_POS_CHECK_CASE_6
	mov [0x82], 0x00D7
	mov [0x84], 0x0029

DROPLET_POS_CHECK_CASE_6:
	jne [0x3B], 0x06, DROPLET_POS_CHECK_CASE_7
	mov [0x82], 0x0054
	mov [0x84], 0x0021

DROPLET_POS_CHECK_CASE_7:
	jne [0x3B], 0x07, DROPLET_POS_CHECK_CASE_8
	mov [0x82], 0x0054
	mov [0x84], 0x003C

DROPLET_POS_CHECK_CASE_8:
	jne [0x3B], 0x08, DROPLET_POS_CHECK_CASE_9
	mov [0x82], 0x0059
	mov [0x84], 0x0065

DROPLET_POS_CHECK_CASE_9:
	jne [0x3B], 0x09, DROPLET_POS_CHECK_CASE_10
	mov [0x82], 0x00B3
	mov [0x84], 0x0018

DROPLET_POS_CHECK_CASE_10:
	jne [0x3B], 0x0A, DROPLET_POS_CHECK_CASE_11
	mov [0x82], 0x0032
	mov [0x84], 0x009F

DROPLET_POS_CHECK_CASE_11:
	jne [0x3B], 0x0B, DROPLET_POS_CHECK_CASE_12
	mov [0x82], 0x00D4
	mov [0x84], 0x0072

DROPLET_POS_CHECK_CASE_12:
	jne [0x3B], 0x0C, DROPLET_POS_CHECK_CASE_13
	mov [0x82], 0x005B
	mov [0x84], 0x0071

DROPLET_POS_CHECK_CASE_13:
	jne [0x3B], 0x0D, DROPLET_POS_CHECK_CASE_14
	mov [0x82], 0x00A7
	mov [0x84], 0x004E

DROPLET_POS_CHECK_CASE_14:
	jl [0x3B], 0x0E, DROPLET_POS_AFTER_SWITCH
	mov [0x82], 0x0190
	mov [0x84], 0x0064

DROPLET_POS_AFTER_SWITCH:
	mov [0x83], [RANDOM_SEED]
	add [0x83], 0x0001

DROPLET_POST_SWITCH_DELAY:
	break
	djnz [0x83], DROPLET_POST_SWITCH_DELAY
	mov [0x83], 0x0001
	jmp DROPLET_FALL_LOOP_BODY
	killChannel

