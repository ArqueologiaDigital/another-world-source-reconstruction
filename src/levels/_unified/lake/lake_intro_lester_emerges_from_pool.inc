; LAKE intro narrative: Lester emerges from the pool. The
; ENTITY_DROP_THEN_F15_LOOP plays the entity-drop animation 10
; times at HERO_X / HERO_Y, then transitions through F15..F18
; followed by the RIGHT_CROUCHING_2/1/0 frames (Lester landing
; in a crouch), the LESTER_RAISES_A_HAND chain, and finally
; LESTER_AT_POOL_HOLD_LOOP (idle hold) until the next channel
; takes over.

CINEMATIC_LESTER_FRAME		EQU 0x1668
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_RIGHT_CROUCHING_0		EQU 0x0A5A
CINEMATIC_RIGHT_CROUCHING_1		EQU 0x09F6
CINEMATIC_RIGHT_CROUCHING_2		EQU 0x0992
;@endif
;@if BRANCH == "chahi_amiga_1991"
CINEMATIC_RIGHT_CROUCHING_0		EQU 0x1E1A
CINEMATIC_RIGHT_CROUCHING_1		EQU 0x1DB6
CINEMATIC_RIGHT_CROUCHING_2		EQU 0x1D52
;@endif

;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_DECOR_AT_305_155_F15		EQU 0xCFF0
CINEMATIC_DECOR_AT_305_155_F16		EQU 0xD08C
CINEMATIC_DECOR_AT_305_155_F17		EQU 0xD134
CINEMATIC_DECOR_AT_305_155_F18		EQU 0xD1C2
CINEMATIC_LESTER_RAISE_HAND_0		EQU 0xCF2C
CINEMATIC_LESTER_RAISE_HAND_1		EQU 0xCF4C
CINEMATIC_LESTER_RAISE_HAND_2		EQU 0xCF78
CINEMATIC_LESTER_RAISE_HAND_3		EQU 0xCFA4
;@endif
;@if BRANCH == "chahi_amiga_1991"
CINEMATIC_DECOR_AT_305_155_F15		EQU 0xE400
CINEMATIC_DECOR_AT_305_155_F16		EQU 0xE49C
CINEMATIC_DECOR_AT_305_155_F17		EQU 0xE544
CINEMATIC_DECOR_AT_305_155_F18		EQU 0xE5D2
CINEMATIC_LESTER_RAISE_HAND_0		EQU 0xE33C
CINEMATIC_LESTER_RAISE_HAND_1		EQU 0xE35C
CINEMATIC_LESTER_RAISE_HAND_2		EQU 0xE388
CINEMATIC_LESTER_RAISE_HAND_3		EQU 0xE3B4
;@endif

ENTITY_DROP_THEN_F15_LOOP:
	mov [PAUSE_SLICES], 0x0006
	mov [0x1A], 0x000A

ENTITY_DROP_LOOP_BODY:
	video offset=CINEMATIC_LAKE_ENTITY_DROP, x=[HERO_X], y=[HERO_Y]
	break
	djnz [0x1A], ENTITY_DROP_LOOP_BODY
	video offset=CINEMATIC_DECOR_AT_305_155_F15, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_DECOR_AT_305_155_F16, x=[HERO_X], y=[HERO_Y]
	play id=0x0051, freq=0x0A, vol=0x30, channel=0x01
	break
	video offset=CINEMATIC_DECOR_AT_305_155_F17, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_DECOR_AT_305_155_F18, x=[HERO_X], y=[HERO_Y]
	break
	sub [HERO_X], 0x0007
	sub [HERO_Y], 0x000E
	video offset=CINEMATIC_RIGHT_CROUCHING_2, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_RIGHT_CROUCHING_2, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_RIGHT_CROUCHING_1, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_RIGHT_CROUCHING_1, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_RIGHT_CROUCHING_0, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_RIGHT_CROUCHING_0, x=[HERO_X], y=[HERO_Y]
	play id=0x0051, freq=0x0A, vol=0x1C, channel=0x01
	mov [0x1A], 0x0014

LESTER_RAISES_A_HAND:
	break
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_LESTER_FRAME_BUNDLE
;@elif BRANCH == "chahi_amiga_1991"
	video offset=CINEMATIC_LESTER_FRAME, x=[HERO_X], y=[HERO_Y]
;@endif
	djnz [0x1A], LESTER_RAISES_A_HAND
	break
	video offset=CINEMATIC_LESTER_RAISE_HAND_0, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_LESTER_RAISE_HAND_1, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_LESTER_RAISE_HAND_2, x=[HERO_X], y=[HERO_Y]
	break
	video offset=CINEMATIC_LESTER_RAISE_HAND_3, x=[HERO_X], y=[HERO_Y]

LESTER_AT_POOL_HOLD_LOOP:
	break
	video offset=CINEMATIC_LAKE_LESTER_AT_POOL, x=[HERO_X], y=[HERO_Y]
	mov [PAUSE_SLICES], 0x0004
	jmp LESTER_AT_POOL_HOLD_LOOP
	killChannel

