SCATTER_3DOTS_INIT_RIGHT:
	mov [0xA2], 0x00D2
	mov [0xA4], 0x014A
	mov [0xA6], 0x0096
	mov [0xA3], 0x007A
	mov [0xA5], 0x0078
	mov [0xA7], 0x0078
	mov [0x93], 0x0006

WAIT_VAR_93_AND_SETUP_CH34:
	break
	djnz [0x93], WAIT_VAR_93_AND_SETUP_CH34
	setup channel=0x34, address=DRAW_3_SCATTER_DOTS_CYCLE
	mov [0x93], 0x0028

SCATTER_3DOTS_DRIFT_LOOP:
	break
	add [0xA2], 0x0002
	add [0xA4], 0x0003
	add [0xA6], 0x0002
	call CLASSIFY_ALL_REGIONS_VARS
	break
	add [0xA2], 0x0002
	add [0xA4], 0x0002
	add [0xA6], 0x0001
	call CLASSIFY_ALL_REGIONS_VARS
	djnz [0x93], SCATTER_3DOTS_DRIFT_LOOP
	setup channel=0x34, address=KILL_CHANNEL_ROUTINE
	break
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0xA2], 0x00A5
	mov [0xA4], 0x0063
	mov [0xA6], 0x0096
	mov [0xA3], 0x007A
	mov [0xA5], 0x0078
	mov [0xA7], 0x0078
	mov [0x93], [0x3D]
	jne [0x38], 0x01, SCATTER_3DOTS_RAND_X_LEFT_OVR
	mov [0xA4], 0x014A

SCATTER_3DOTS_RAND_X_LEFT_OVR:
	and [0x39], 0x0002
	jne [0x39], 0x00, SCATTER_3DOTS_RAND_X_RIGHT_OVR
	mov [0xA2], 0x014A

SCATTER_3DOTS_RAND_X_RIGHT_OVR:
	and [0x3A], 0x0004
	jne [0x3A], 0x00, WAIT_VAR_93_AND_SETUP_CH34
	mov [0xA6], 0x014A
	jmp WAIT_VAR_93_AND_SETUP_CH34
	killChannel

CLASSIFY_ALL_REGIONS_VARS:
	mov [0x6C], [0xA2]
	mov [0x6D], [0xA3]
	call CLASSIFY_VAR_6C_INTO_REGIONS_LARGE
	mov [0xA2], [0x6C]
	mov [0xA3], [0x6D]
	mov [0x6C], [0xA4]
	mov [0x6D], [0xA5]
	call CLASSIFY_VAR_6C_INTO_REGIONS_LARGE
	mov [0xA4], [0x6C]
	mov [0xA5], [0x6D]
	mov [0x6C], [0xA6]
	mov [0x6D], [0xA7]
	call CLASSIFY_VAR_6C_INTO_REGIONS_LARGE
	mov [0xA6], [0x6C]
	mov [0xA7], [0x6D]
	ret
	killChannel

CLASSIFY_VAR_6C_INTO_REGIONS_LARGE:
	jge [0x6C], 0x0105, WRAP_VAR_6D_IF_OVERFLOW_BACKWARD
	jg [0x6C], 0xDC, WRAP_VAR_6D_IF_UNDERFLOW_FORWARD
	jge [0x6C], 0xD0, WRAP_VAR_6D_IF_OVERFLOW_BACKWARD
	jg [0x6C], 0xA6, WRAP_VAR_6D_IF_UNDERFLOW_FORWARD
	jge [0x6C], 0xA5, WRAP_VAR_6D_IF_OVERFLOW_BACKWARD
	jg [0x6C], 0x9F, WRAP_VAR_6D_IF_UNDERFLOW_FORWARD
	jge [0x6C], 0x92, WRAP_VAR_6D_IF_OVERFLOW_BACKWARD
	ret

WRAP_VAR_6D_IF_OVERFLOW_BACKWARD:
	jl [0x6D], 0x00, RET_TARGET_0BB1
	sub [0x6D], 0x0190

RET_TARGET_0BB1:
	ret

WRAP_VAR_6D_IF_UNDERFLOW_FORWARD:
	jge [0x6D], 0x00, RET_TARGET_0BB1
	jl [0x6D], 0xFE70, RET_TARGET_0BB1
	add [0x6D], 0x0190
	ret

CLASSIFY_VAR_6C_INTO_REGIONS_SMALL:
	jge [0x6C], 0x0115, WRAP_VAR_6D_IF_OVERFLOW_BACKWARD
	jg [0x6C], 0x2F, WRAP_VAR_6D_IF_UNDERFLOW_FORWARD
	jge [0x6C], 0x23, WRAP_VAR_6D_IF_OVERFLOW_BACKWARD
	ret

