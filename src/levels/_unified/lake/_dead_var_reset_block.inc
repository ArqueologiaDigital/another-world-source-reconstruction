; UNREACHABLE bytecode preserved verbatim for round-trip byte
; identity. After PARTICLE_BURST_CYCLE_LOOP_2's `jmp ... ;
; killChannel`, the disassembler picked up these ~70 `mov [varN],
; 0x0000` instructions plus a trailing `ret`. They sit at the
; next byte address in every port's bytecode (cart, dos, amiga,
; gba) but no label points at them and they are never reached
; via fall-through (the jmp is unconditional).
;
; Two plausible origins:
;   - Leftover debug / scratch from an earlier compile that the
;     production build never trimmed.
;   - Padding the bytecode bank to a specific length / alignment.
;
; The block has no labels of its own; if any code ever did want
; to call into it, every entry would be a "label-less interior
; address" and round-trip would catch the change.

	mov [HERO_X], 0x0000
	mov [HERO_Y], 0x0000
	mov [0x03], 0x0000
	mov [0x04], 0x0000
