;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_BEAST_APPROACH_FAST_1		EQU 0x5CCE
CINEMATIC_BEAST_APPROACH_FAST_2		EQU 0x5D2A
CINEMATIC_BEAST_APPROACH_FAST_3		EQU 0x5D82
CINEMATIC_BEAST_APPROACH_FAST_4		EQU 0x5DDA
CINEMATIC_BEAST_DRIFT_FRAME		EQU 0x5E8A
CINEMATIC_BEAST_DRIFT_LEFT_0		EQU 0x5EE6
CINEMATIC_BEAST_DRIFT_LEFT_1		EQU 0x5F9A
CINEMATIC_BEAST_DRIFT_LEFT_2		EQU 0x5F3E
CINEMATIC_BEAST_PREROLL		EQU 0x5E32
;@endif
;@if BRANCH == "chahi_amiga_1991"
CINEMATIC_BEAST_APPROACH_FAST_1		EQU 0x70DE
CINEMATIC_BEAST_APPROACH_FAST_2		EQU 0x713A
CINEMATIC_BEAST_APPROACH_FAST_3		EQU 0x7192
CINEMATIC_BEAST_APPROACH_FAST_4		EQU 0x71EA
CINEMATIC_BEAST_DRIFT_FRAME		EQU 0x729A
CINEMATIC_BEAST_DRIFT_LEFT_0		EQU 0x72F6
CINEMATIC_BEAST_DRIFT_LEFT_1		EQU 0x73AA
CINEMATIC_BEAST_DRIFT_LEFT_2		EQU 0x734E
CINEMATIC_BEAST_PREROLL		EQU 0x7242
;@endif

SHIFT_X_LEFT_F_AND_JMP:
	sub [0x0E], 0x000F
	jmp BEAST_APPROACH_F1_TICK

BEAST_APPROACH_FAST_LOOP:
	video type=1, offset=CINEMATIC_BEAST_APPROACH_FAST_1, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x000F
	video type=1, offset=CINEMATIC_BEAST_APPROACH_FAST_2, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x000D
	video type=1, offset=CINEMATIC_BEAST_APPROACH_FAST_3, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x000D
	video type=1, offset=CINEMATIC_BEAST_APPROACH_FAST_4, x=[0x0e], y=[0x0f], zoom=0x40
	mov [SCROLL_Y], 0x0001
	setup channel=0x3C, address=RENDER_FRAME_DISPATCH
	break
	play id=0x003A, freq=0x0A, vol=0x18, channel=0x00
	sub [0x0E], 0x000D
	jmp BEAST_ARRIVAL_DECEL

DRAW_BEAST_DRIFT_LEFT_PREROLL_FRAME:
	video type=1, offset=CINEMATIC_BEAST_PREROLL, x=[0x0e], y=[0x0f], zoom=0x40
	break

DRAW_BEAST_DRIFT_LEFT_LOOP:
	sub [0x0E], 0x000B
	video type=1, offset=CINEMATIC_BEAST_DRIFT_FRAME, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x000D
	video type=1, offset=CINEMATIC_BEAST_DRIFT_LEFT_0, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x0006
	video type=1, offset=CINEMATIC_BEAST_DRIFT_LEFT_1, x=[0x0e], y=[0x0f], zoom=0x40
	call RANDOM_BEAST_AMBIENT_SOUND
	break
	sub [0x0E], 0x000C
	video type=1, offset=CINEMATIC_BEAST_DRIFT_LEFT_2, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x0001
	jmp SHIFT_X_LEFT_F_AND_JMP
	killChannel

ADVANCE_X_FORWARD_ONE_SCREEN:
	jl [0x2A], 0x04, SHIFT_X_RIGHT_320
	add [0x0E], 0x0172

SHIFT_X_RIGHT_320:
	add [0x0A], 0x0140
	ret

ADVANCE_X_BACKWARD_ONE_SCREEN:
	jl [0x2A], 0x04, SHIFT_X_LEFT_320
	sub [0x0E], 0x0172

SHIFT_X_LEFT_320:
	sub [0x0A], 0x0140
	ret

