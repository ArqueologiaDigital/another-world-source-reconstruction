; STAGE PASSCODE: password-entry screen for save-state restoration.
;
; Gameplay role: shown before the game starts (or between sessions)
; to let players resume from a stored checkpoint. Hashes the entered
; characters into per-stage save vectors. Replaces the checkpoint
; system on platforms without battery-backed save.
;
; Branches that ship PASSCODE:
;   chahi_amiga_1991, dos_1992, cartridge_1992 (genesis_eu).
;
; Smallest unified file (only 6 folded bodies). The hashing logic
; (PASSCODE_ACCUMULATE_VALIDATION_HASH) is one of the most analyzed routines
; in the genealogy work — it's structurally identical across all
; three branches.
;
; Engine-managed special-purpose VM variables (HERO_POS_*, RANDOM_SEED, PAUSE_SLICES, etc.).
.include "../_common_vars.inc"

; Level-entry bytecode (level start through the first shared folded routine).
.if BRANCH == "chahi_amiga_1991"
.include "passcode/amiga__entry.inc"
.elif BRANCH == "cartridge_1992"
.include "passcode/cart__entry.inc"
.else
.include "passcode/dos__entry.inc"
.endif

.if BRANCH in ("chahi_amiga_1991", "dos_1992")
PASSCODE_ACCUMULATE_VALIDATION_HASH:
	add [0x37], [HERO_ACTION]
	add [0x37], [HERO_POS_JUMP_DOWN]
	add [0x37], [HACK_VAR_F7]
	add [0x37], [HERO_ACTION_POS_MASK]
	add [0x37], [0x0A]
	add [0x37], [0x14]
	add [0x37], [0x0B]
	add [0x37], [0x28]
	add [0x37], [0x01]
	add [0x37], [0x04]
	ret


.endif

; Port-specific body chunk after the shared `PASSCODE_ACCUMULATE_VALIDATION_HASH` routine.
.if BRANCH == "chahi_amiga_1991"
.include "passcode/amiga__post_SUM_HASH_VARS_TO_VAR_37.inc"
.elif BRANCH == "dos_1992"
.include "passcode/dos__post_SUM_HASH_VARS_TO_VAR_37.inc"
.endif

.if BRANCH in ("cartridge_1992", "dos_1992")
PASSCODE_CURSOR_SNAP_TO_TARGET_CELL:
	mov [0x07], [0x27]
	mov [0x08], [0x28]
.endif

.if BRANCH in ("cartridge_1992", "dos_1992")
CURSOR_ANIM_DONE_WAIT_RELEASE:
	video offset=CINEMATIC_PASSCODE_CURSOR, x=[0x07], y=[0x08]
	break
	jne [HERO_POS_UP_DOWN], 0x00, CURSOR_ANIM_DONE_WAIT_RELEASE
	jne [HERO_POS_MASK], 0x00, CURSOR_ANIM_DONE_WAIT_RELEASE
	jmp HANDLE_PASSCODE_INPUT_OR_DISPATCH

; Cursor-redraw branch: an earlier chunk's `jne [0x07], [0x27], JUNK__<HEX>`
; (and same for var08/28) lands here when var07 != var27 or var08 !=
; var28 (cursor still moving). Body re-emits the cursor and jmps back
; to the per-port cursor-animation-loop entry. Both the label name and
; the jmp target are port-specific (cart 0x0467 → 0x03F5, dos 0x0733
; → 0x06C1) — the labels live in cart__entry.inc and
; dos__post_SUM_HASH_VARS_TO_VAR_37.inc respectively.
.if BRANCH == "cartridge_1992"
JUNK__0467:
	video offset=CINEMATIC_PASSCODE_CURSOR, x=[0x07], y=[0x08]
	break
	jmp JUNK__03F5
.else
PASSCODE_CURSOR_SLIDE_FRAME_TICK:
	video offset=CINEMATIC_PASSCODE_CURSOR, x=[0x07], y=[0x08]
	break
	jmp CURSOR_ANIM_X_RIGHT_STEP_LOOP
.endif

; Trailing `db 0x11` filler — unreachable (preceding `jmp` doesn't
; fall through).
.if INCLUDE_UNREACHABLE_CODE == on
	killChannel
.endif

VALIDATE_PASSCODE_LDKD:
	jne [0x1E], 0x15, VALIDATE_PASSCODE_HTDC
	jne [0x1F], 0x0D, VALIDATE_PASSCODE_HTDC
	jne [0x20], 0x14, VALIDATE_PASSCODE_HTDC
	jne [0x21], 0x0D, VALIDATE_PASSCODE_HTDC
	mov [0x00], 0x000A
	bankSwitch 2;  Arrival at the Lake & Beast Chase
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_HTDC:
	jne [0x1E], 0x11, VALIDATE_PASSCODE_CLLD
	jne [0x1F], 0x1D, VALIDATE_PASSCODE_CLLD
	jne [0x20], 0x0D, VALIDATE_PASSCODE_CLLD
	jne [0x21], 0x0C, VALIDATE_PASSCODE_CLLD
	mov [0x00], 0x0014
	bankSwitch 3;  Prison Escape
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_CLLD:
	jne [0x1E], 0x0C, VALIDATE_PASSCODE_FXLC
	jne [0x1F], 0x15, VALIDATE_PASSCODE_FXLC
	jne [0x20], 0x15, VALIDATE_PASSCODE_FXLC
	jne [0x21], 0x0D, VALIDATE_PASSCODE_FXLC
	mov [0x00], 0x001E
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_FXLC:
	jne [0x1E], 0x0F, VALIDATE_PASSCODE_KRFK
	jne [0x1F], 0x21, VALIDATE_PASSCODE_KRFK
	jne [0x20], 0x15, VALIDATE_PASSCODE_KRFK
	jne [0x21], 0x0C, VALIDATE_PASSCODE_KRFK
	mov [0x00], 0x0023
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_KRFK:
	jne [0x1E], 0x14, VALIDATE_PASSCODE_XDDJ
	jne [0x1F], 0x1B, VALIDATE_PASSCODE_XDDJ
	jne [0x20], 0x0F, VALIDATE_PASSCODE_XDDJ
	jne [0x21], 0x14, VALIDATE_PASSCODE_XDDJ
	mov [0x00], 0x0025
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_XDDJ:
	jne [0x1E], 0x21, VALIDATE_PASSCODE_LBKG
	jne [0x1F], 0x0D, VALIDATE_PASSCODE_LBKG
	jne [0x20], 0x0D, VALIDATE_PASSCODE_LBKG
	jne [0x21], 0x13, VALIDATE_PASSCODE_LBKG
	mov [0x00], 0x0021
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_LBKG:
	jne [0x1E], 0x15, VALIDATE_PASSCODE_KLFB
	jne [0x1F], 0x0B, VALIDATE_PASSCODE_KLFB
	jne [0x20], 0x14, VALIDATE_PASSCODE_KLFB
	jne [0x21], 0x10, VALIDATE_PASSCODE_KLFB
	mov [0x00], 0x001F
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_KLFB:
	jne [0x1E], 0x14, VALIDATE_PASSCODE_TTCT
	jne [0x1F], 0x15, VALIDATE_PASSCODE_TTCT
	jne [0x20], 0x0F, VALIDATE_PASSCODE_TTCT
	jne [0x21], 0x0B, VALIDATE_PASSCODE_TTCT
	mov [0x00], 0x0027
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_TTCT:
	jne [0x1E], 0x1D, VALIDATE_PASSCODE_DDRX
	jne [0x1F], 0x1D, VALIDATE_PASSCODE_DDRX
	jne [0x20], 0x0C, VALIDATE_PASSCODE_DDRX
	jne [0x21], 0x1D, VALIDATE_PASSCODE_DDRX
	mov [0x00], 0x0029
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_DDRX:
	jne [0x1E], 0x0D, VALIDATE_PASSCODE_TBHK
	jne [0x1F], 0x0D, VALIDATE_PASSCODE_TBHK
	jne [0x20], 0x1B, VALIDATE_PASSCODE_TBHK
	jne [0x21], 0x21, VALIDATE_PASSCODE_TBHK
	mov [0x00], 0x002A
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_TBHK:
	jne [0x1E], 0x1D, VALIDATE_PASSCODE_BRTD
	jne [0x1F], 0x0B, VALIDATE_PASSCODE_BRTD
	jne [0x20], 0x11, VALIDATE_PASSCODE_BRTD
	jne [0x21], 0x14, VALIDATE_PASSCODE_BRTD
	mov [0x00], 0x002B
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_BRTD:
	jne [0x1E], 0x0B, VALIDATE_PASSCODE_CKJL
	jne [0x1F], 0x1B, VALIDATE_PASSCODE_CKJL
	jne [0x20], 0x1D, VALIDATE_PASSCODE_CKJL
	jne [0x21], 0x0D, VALIDATE_PASSCODE_CKJL
	mov [0x00], 0x0031
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_CKJL:
	jne [0x1E], 0x0C, VALIDATE_PASSCODE_LFCK
	jne [0x1F], 0x14, VALIDATE_PASSCODE_LFCK
	jne [0x20], 0x13, VALIDATE_PASSCODE_LFCK
	jne [0x21], 0x15, VALIDATE_PASSCODE_LFCK
	mov [0x00], 0x0032
	bankSwitch 5;  Tank in the Battle Arena
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_LFCK:
	jne [0x1E], 0x15, VALIDATE_PASSCODE_BFLX
	jne [0x1F], 0x0F, VALIDATE_PASSCODE_BFLX
	jne [0x20], 0x0C, VALIDATE_PASSCODE_BFLX
	jne [0x21], 0x14, VALIDATE_PASSCODE_BFLX
	mov [0x00], 0x003C
	bankSwitch 6;  Capsule Lands at the Bath
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_BFLX:
	jne [0x1E], 0x0B, VALIDATE_PASSCODE_XJRT
	jne [0x1F], 0x0F, VALIDATE_PASSCODE_XJRT
	jne [0x20], 0x15, VALIDATE_PASSCODE_XJRT
	jne [0x21], 0x21, VALIDATE_PASSCODE_XJRT
	mov [0x00], 0x002C
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_XJRT:
	jne [0x1E], 0x21, VALIDATE_PASSCODE_HRTB
	jne [0x1F], 0x13, VALIDATE_PASSCODE_HRTB
	jne [0x20], 0x1B, VALIDATE_PASSCODE_HRTB
	jne [0x21], 0x1D, VALIDATE_PASSCODE_HRTB
	mov [0x00], 0x002D
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_HRTB:
	jne [0x1E], 0x11, VALIDATE_PASSCODE_HBHK
	jne [0x1F], 0x1B, VALIDATE_PASSCODE_HBHK
	jne [0x20], 0x1D, VALIDATE_PASSCODE_HBHK
	jne [0x21], 0x0B, VALIDATE_PASSCODE_HBHK
	mov [0x00], 0x002E
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_HBHK:
	jne [0x1E], 0x11, VALIDATE_PASSCODE_JCGB
	jne [0x1F], 0x0B, VALIDATE_PASSCODE_JCGB
	jne [0x20], 0x11, VALIDATE_PASSCODE_JCGB
	jne [0x21], 0x14, VALIDATE_PASSCODE_JCGB
	mov [0x00], 0x002F
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_JCGB:
	jne [0x1E], 0x13, VALIDATE_PASSCODE_HHFL
	jne [0x1F], 0x0C, VALIDATE_PASSCODE_HHFL
	jne [0x20], 0x10, VALIDATE_PASSCODE_HHFL
	jne [0x21], 0x0B, VALIDATE_PASSCODE_HHFL
	mov [0x00], 0x0030
	bankSwitch 4;  Gas tunnels, Caves and Pool
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_HHFL:
	jne [0x1E], 0x11, VALIDATE_PASSCODE_TFBB
	jne [0x1F], 0x11, VALIDATE_PASSCODE_TFBB
	jne [0x20], 0x0F, VALIDATE_PASSCODE_TFBB
	jne [0x21], 0x15, VALIDATE_PASSCODE_TFBB
	mov [0x00], 0x003E
	bankSwitch 6;  Capsule Lands at the Bath
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_TFBB:
	jne [0x1E], 0x1D, VALIDATE_PASSCODE_TXHF
	jne [0x1F], 0x0F, VALIDATE_PASSCODE_TXHF
	jne [0x20], 0x0B, VALIDATE_PASSCODE_TXHF
	jne [0x21], 0x0B, VALIDATE_PASSCODE_TXHF
	mov [0x00], 0x0040
	bankSwitch 6;  Capsule Lands at the Bath
	jmp SET_PAL_0_AND_RESTART

VALIDATE_PASSCODE_TXHF:
.if BRANCH == "cartridge_1992"
	jne [0x1E], 0x1D, VALIDATE_PASSCODE_KRTD
	jne [0x1F], 0x21, VALIDATE_PASSCODE_KRTD
	jne [0x20], 0x11, VALIDATE_PASSCODE_KRTD
	jne [0x21], 0x0F, VALIDATE_PASSCODE_KRTD
.else
	jne [0x1E], 0x1D, VALIDATE_PASSCODE_JHJL
	jne [0x1F], 0x21, VALIDATE_PASSCODE_JHJL
	jne [0x20], 0x11, VALIDATE_PASSCODE_JHJL
	jne [0x21], 0x0F, VALIDATE_PASSCODE_JHJL
.endif
	mov [0x00], 0x0042
	bankSwitch 6;  Capsule Lands at the Bath
	jmp SET_PAL_0_AND_RESTART

.if BRANCH == "dos_1992"
VALIDATE_PASSCODE_JHJL:
	jne [0x1E], 0x13, VALIDATE_PASSCODE_KRTD
	jne [0x1F], 0x11, VALIDATE_PASSCODE_KRTD
	jne [0x20], 0x13, VALIDATE_PASSCODE_KRTD
	jne [0x21], 0x15, VALIDATE_PASSCODE_KRTD
	mov [0x00], 0x0044
	bankSwitch 6;  Capsule Lands at the Bath
	jmp SET_PAL_0_AND_RESTART
.endif

VALIDATE_PASSCODE_KRTD:
	jne [0x1E], 0x14, CHECK_PASSCODE_OR_GOTO_PRISON
	jne [0x1F], 0x1B, CHECK_PASSCODE_OR_GOTO_PRISON
	jne [0x20], 0x1D, CHECK_PASSCODE_OR_GOTO_PRISON
	jne [0x21], 0x0D, CHECK_PASSCODE_OR_GOTO_PRISON
	mov [0x00], 0x0046
	bankSwitch 7;  Game Ending Sequence
	jmp SET_PAL_0_AND_RESTART

CHECK_PASSCODE_OR_GOTO_PRISON:
	jne [0x1E], 0xFFFF, PASSCODE_INVALID_MESSAGE_PRELUDE
	jne [0x1F], 0xFFFF, PASSCODE_INVALID_MESSAGE_PRELUDE
	jne [0x20], 0xFFFF, PASSCODE_INVALID_MESSAGE_PRELUDE
	jne [0x21], 0xFFFF, PASSCODE_INVALID_MESSAGE_PRELUDE
	mov [0x00], 0x0000
	bankSwitch 1;  Intro Sequence
	jmp SET_PAL_0_AND_RESTART
.endif

; PASSCODE var init (PASSCODE_INVALID_MESSAGE_PRELUDE).
.include "passcode/passcode_var_init.inc"
