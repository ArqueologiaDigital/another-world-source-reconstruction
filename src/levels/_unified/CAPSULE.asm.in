;@if BRANCH in ("cartridge_1992", "dos_1992")
INIT_BIRD_AI_VARS:
	mov [0x01], 0x0091	;@raw=0x00,0x01,0x00,0x91
	mov [0x02], 0x008F	;@raw=0x00,0x02,0x00,0x8F
	mov [0x0F], 0x0000	;@raw=0x00,0x0F,0x00,0x00
	mov [0x28], [0x01]	;@raw=0x01,0x28,0x01
	mov [0x04], 0x0020	;@raw=0x00,0x04,0x00,0x20
	mov [0x05], 0x0000	;@raw=0x00,0x05,0x00,0x00
	mov [0x06], 0x03DE	;@raw=0x00,0x06,0x03,0xDE
	mov [0x0A], 0x0001	;@raw=0x00,0x0A,0x00,0x01
	mov [0x63], 0x0001	;@raw=0x00,0x63,0x00,0x01
	mov [0x2A], 0x000F	;@raw=0x00,0x2A,0x00,0x0F
	ret	;@raw=0x05
;@endif

