DERIVE_VAR12_11_10_FROM_VAR9:
	and [0x09], 0x03FF	;@raw=0x14,0x09,0x03,0xFF
	mov [0x12], [0x09]	;@raw=0x01,0x12,0x09
	shr [0x12], 0x0007	;@raw=0x17,0x12,0x00,0x07
	mov [0x11], [0x12]	;@raw=0x01,0x11,0x12
	shr [0x11], 0x0001	;@raw=0x17,0x11,0x00,0x01
	mov [0x10], [0x11]	;@raw=0x01,0x10,0x11
	shr [0x10], 0x0001	;@raw=0x17,0x10,0x00,0x01
	and [0x12], 0x0001	;@raw=0x14,0x12,0x00,0x01
	and [0x11], 0x0001	;@raw=0x14,0x11,0x00,0x01
	mov [0x13], [0x10]	;@raw=0x01,0x13,0x10
	add [0x13], [0x11]	;@raw=0x02,0x13,0x11
	add [0x13], [0x12]	;@raw=0x02,0x13,0x12
	and [0x09], 0x007F	;@raw=0x14,0x09,0x00,0x7F
	mov [0x0E], [0x09]	;@raw=0x01,0x0E,0x09
	shr [0x0E], 0x0003	;@raw=0x17,0x0E,0x00,0x03
	mov [0x0D], [0x0E]	;@raw=0x01,0x0D,0x0E
	shr [0x0D], 0x0002	;@raw=0x17,0x0D,0x00,0x02
	and [0x0E], 0x0003	;@raw=0x14,0x0E,0x00,0x03
	and [0x09], 0x0007	;@raw=0x14,0x09,0x00,0x07
	ret	;@raw=0x05

;@if BRANCH == "cartridge_1992"
