; Unified source for CAPSULE with two folded shared bodies.
;
; Architecture: each per-arm `.inc` file is split into chunks separated
; by the byte addresses of the shared routines. The shared bodies live
; at the top level and are emitted into the assembled output for each
; branch at the correct byte address (the natural assembled layout
; takes care of address alignment — no `org` directives needed).
;
; Currently folded routines (in byte-address order within the file):
;   COPY_HASH_VAR_37_TO_RANGE  (117 bytes — also in PRISON, CAVES)
;     amiga: 0x231A   cart: 0x31BE   dos: 0x3041
;   DERIVE_VAR12_11_10_FROM_VAR9  (69 bytes — also in PRISON, CAVES)
;     amiga: 0x2CDF   cart: 0x4261   dos: 0x428F
;
; Per-arm split layout (each arm has 3 chunks: pre, mid1, post2):
;   pre:    [0x0000 ..  before COPY_HASH_VAR_37_TO_RANGE]
;   mid1:   [after COPY_HASH .. before DERIVE_VAR12_11_10_FROM_VAR9]
;   post2:  [after DERIVE .. EOF]

;@if BRANCH == "cartridge_1992"
;@include "capsule/cart_pre.inc"
;@elif BRANCH == "dos_1992"
;@include "capsule/dos_pre.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "capsule/amiga_pre.inc"
;@endif

COPY_HASH_VAR_37_TO_RANGE:
	mov [0x38], [0x37]	;@raw=0x01,0x38,0x37
	mov [0x39], [0x37]	;@raw=0x01,0x39,0x37
	mov [0x3A], [0x37]	;@raw=0x01,0x3A,0x37
	mov [0x3B], [0x37]	;@raw=0x01,0x3B,0x37
	mov [RANDOM_SEED], [0x37]	;@raw=0x01,0x3C,0x37
	mov [0x3D], [0x37]	;@raw=0x01,0x3D,0x37
	mov [0x3E], [0x37]	;@raw=0x01,0x3E,0x37
	mov [0x3F], [0x37]	;@raw=0x01,0x3F,0x37
	and [0x38], 0x0001	;@raw=0x14,0x38,0x00,0x01
	and [0x39], 0x0002	;@raw=0x14,0x39,0x00,0x02
	and [0x3A], 0x0004	;@raw=0x14,0x3A,0x00,0x04
	and [0x3B], 0x0008	;@raw=0x14,0x3B,0x00,0x08
	and [RANDOM_SEED], 0x0010	;@raw=0x14,0x3C,0x00,0x10
	and [0x3D], 0x0020	;@raw=0x14,0x3D,0x00,0x20
	and [0x3E], 0x0040	;@raw=0x14,0x3E,0x00,0x40
	and [0x3F], 0x0080	;@raw=0x14,0x3F,0x00,0x80
	shl [0x38], 0x0007	;@raw=0x16,0x38,0x00,0x07
	shl [0x39], 0x0002	;@raw=0x16,0x39,0x00,0x02
	shl [0x3A], 0x0003	;@raw=0x16,0x3A,0x00,0x03
	shl [0x3B], 0x0003	;@raw=0x16,0x3B,0x00,0x03
	shr [RANDOM_SEED], 0x0003	;@raw=0x17,0x3C,0x00,0x03
	shr [0x3D], 0x0001	;@raw=0x17,0x3D,0x00,0x01
	shr [0x3E], 0x0006	;@raw=0x17,0x3E,0x00,0x06
	shl [0x3F], 0x0005	;@raw=0x16,0x3F,0x00,0x05
	and [0x37], 0xFF01	;@raw=0x14,0x37,0xFF,0x01
	add [0x37], [0x38]	;@raw=0x02,0x37,0x38
	add [0x37], [0x39]	;@raw=0x02,0x37,0x39
	add [0x37], [0x3A]	;@raw=0x02,0x37,0x3A
	add [0x37], [0x3B]	;@raw=0x02,0x37,0x3B
	add [0x37], [RANDOM_SEED]	;@raw=0x02,0x37,0x3C
	add [0x37], [0x3D]	;@raw=0x02,0x37,0x3D
	add [0x37], [0x3E]	;@raw=0x02,0x37,0x3E
	add [0x37], [0x3F]	;@raw=0x02,0x37,0x3F
	ret	;@raw=0x05

;@if BRANCH == "cartridge_1992"
;@include "capsule/cart_mid1.inc"
;@elif BRANCH == "dos_1992"
;@include "capsule/dos_mid1.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "capsule/amiga_mid1.inc"
;@endif

DERIVE_VAR12_11_10_FROM_VAR9:
	and [0x09], 0x03FF	;@raw=0x14,0x09,0x03,0xFF
	mov [0x12], [0x09]	;@raw=0x01,0x12,0x09
	shr [0x12], 0x0007	;@raw=0x17,0x12,0x00,0x07
	mov [0x11], [0x12]	;@raw=0x01,0x11,0x12
	shr [0x11], 0x0001	;@raw=0x17,0x11,0x00,0x01
	mov [0x10], [0x11]	;@raw=0x01,0x10,0x11
	shr [0x10], 0x0001	;@raw=0x17,0x10,0x00,0x01
	and [0x12], 0x0001	;@raw=0x14,0x12,0x00,0x01
	and [0x11], 0x0001	;@raw=0x14,0x11,0x00,0x01
	mov [0x13], [0x10]	;@raw=0x01,0x13,0x10
	add [0x13], [0x11]	;@raw=0x02,0x13,0x11
	add [0x13], [0x12]	;@raw=0x02,0x13,0x12
	and [0x09], 0x007F	;@raw=0x14,0x09,0x00,0x7F
	mov [0x0E], [0x09]	;@raw=0x01,0x0E,0x09
	shr [0x0E], 0x0003	;@raw=0x17,0x0E,0x00,0x03
	mov [0x0D], [0x0E]	;@raw=0x01,0x0D,0x0E
	shr [0x0D], 0x0002	;@raw=0x17,0x0D,0x00,0x02
	and [0x0E], 0x0003	;@raw=0x14,0x0E,0x00,0x03
	and [0x09], 0x0007	;@raw=0x14,0x09,0x00,0x07
	ret	;@raw=0x05

;@if BRANCH == "cartridge_1992"
;@include "capsule/cart_post2.inc"
;@elif BRANCH == "dos_1992"
;@include "capsule/dos_post2.inc"
;@elif BRANCH == "chahi_amiga_1991"
;@include "capsule/amiga_post2.inc"
;@endif
