	break	;@raw=0x06
	add [0x01], 0x0003	;@raw=0x03,0x01,0x00,0x03
	break	;@raw=0x06
	add [0x01], 0x0002	;@raw=0x03,0x01,0x00,0x02
	break	;@raw=0x06
	add [0x01], 0x0001	;@raw=0x03,0x01,0x00,0x01
	break	;@raw=0x06
	add [0x01], 0x0001	;@raw=0x03,0x01,0x00,0x01
	killChannel	;@raw=0x11

