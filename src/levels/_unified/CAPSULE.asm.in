HERO_X		EQU 0x01
HERO_Y		EQU 0x02
BUDDY_X		EQU 0x07
BUDDY_Y		EQU 0x08
; STAGE CAPSULE: alien city, capsule ride, escape sequences.
;
; Gameplay role: after the cave-flooding rescue, Lester is in the
; alien city. He boards a flying capsule (or is captured into one)
; and traverses the city. Includes:
;   - Multiple alien character animations (sub-anim dispatchers
;     for hero AND alien sprites — see issue 0080 for divergent
;     CIN ranges between cart/dos/amiga arms).
;   - Capsule travel sequence with parallax scrolling.
;   - Setup for the TANK arena combat that follows.
;
; Branches that ship CAPSULE:
;   chahi_amiga_1991, dos_1992, cartridge_1992 (genesis_eu).
;
; Notable per-arm divergence: the alien sprite uses entirely
; different cinematic indices in amiga 1991 vs cart/dos 1992 —
; suggesting the 1992 ports renumbered indices rather than preserving
; the 1991 layout (issue 0080).
;
; Engine-managed special-purpose VM variables (HERO_POS_*, RANDOM_SEED, PAUSE_SLICES, etc.).
.include "../_common_vars.inc"

; Cross-stage helper EQUs (LABEL_<HEX> / ADDR_AT_* placeholders shared between levels).
.include "_helpers/_helpers_equ_aliases.inc"

; Level-entry bytecode (level start through the first shared folded routine).
.if BRANCH == "chahi_amiga_1991"
.include "capsule/amiga__entry.inc"
.elif BRANCH == "cartridge_1992"
.include "capsule/cart__entry.inc"
.else
.include "capsule/dos__entry.inc"
.endif

; CAPSULE per-frame state-init cluster (var07/varBB/var73 increments + var29 reset).
.include "capsule/capsule_init_vars_cluster.inc"

; CAPSULE inline single-instruction setters (INLINE_SET_VAR29_TO_4, etc.).
.include "capsule/capsule_inline_setters_and_init.inc"

; CAPSULE init dispatcher (INIT_VARS_2F_29_12 + early state dispatch).
.include "capsule/capsule_init_dispatch.inc"

; CAPSULE resource-load helpers (LOAD_RES90 + page-copy) + var-22 setters / projections + INIT_BIRD_AI_VARS (the "ride the bird" scene's hero-position reset that overwrites HERO_X / HERO_Y to 0x91 / 0x8F and saves prior X to var 0x28; cart/dos only) + the SET_VAR04_* / INLINE_SET_VAR63_* shared-helper chain + WALK_LEFT/RIGHT_DRAW_CV multistep helpers.
.include "capsule/capsule_load_helpers_and_anim.inc"
