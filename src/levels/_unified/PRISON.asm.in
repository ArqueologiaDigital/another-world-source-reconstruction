	and [0x3E], 0x0040	;@raw=0x14,0x3E,0x00,0x40
	and [0x3F], 0x0080	;@raw=0x14,0x3F,0x00,0x80
	shl [0x38], 0x0007	;@raw=0x16,0x38,0x00,0x07
	shl [0x39], 0x0002	;@raw=0x16,0x39,0x00,0x02
	shl [0x3A], 0x0003	;@raw=0x16,0x3A,0x00,0x03
	shl [0x3B], 0x0003	;@raw=0x16,0x3B,0x00,0x03
	shr [RANDOM_SEED], 0x0003	;@raw=0x17,0x3C,0x00,0x03
	shr [0x3D], 0x0001	;@raw=0x17,0x3D,0x00,0x01
	shr [0x3E], 0x0006	;@raw=0x17,0x3E,0x00,0x06
	shl [0x3F], 0x0005	;@raw=0x16,0x3F,0x00,0x05
	and [0x37], 0xFF01	;@raw=0x14,0x37,0xFF,0x01
	add [0x37], [0x38]	;@raw=0x02,0x37,0x38
	add [0x37], [0x39]	;@raw=0x02,0x37,0x39
	add [0x37], [0x3A]	;@raw=0x02,0x37,0x3A
	add [0x37], [0x3B]	;@raw=0x02,0x37,0x3B
	add [0x37], [RANDOM_SEED]	;@raw=0x02,0x37,0x3C
	add [0x37], [0x3D]	;@raw=0x02,0x37,0x3D
	add [0x37], [0x3E]	;@raw=0x02,0x37,0x3E
	add [0x37], [0x3F]	;@raw=0x02,0x37,0x3F
