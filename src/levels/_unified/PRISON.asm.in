HERO_X		EQU 0x01
HERO_Y		EQU 0x02
BUDDY_X		EQU 0x07
BUDDY_Y		EQU 0x08
CACHED_SCREEN_NUM	EQU 0x66
; STAGE PRISON: alien cell, cage break-out, gun pickup, jailbreak.
;
; Gameplay role: after capture in LAKE, player wakes up caged
; alongside another prisoner (the alien friend). Player must:
;   1. Swing the cage left/right alternately to break it off.
;   2. Pick up the dropped pistol from a stunned guard.
;   3. Shoot guards across several screens, using shields when
;      needed (charge-shot mechanics introduced here).
;   4. Reach the elevator, descend, destroy the power-source on the
;      lower wall, ride back up, super-blast a door.
;   5. Use teleporters to reach the vent panel — alien friend opens
;      the floor panel and Lester drops into the ventilation shafts.
;
; Branches that ship PRISON:
;   chahi_amiga_1991, dos_1992, cartridge_1992 (genesis_eu only —
;   snes_eu and gba_2004 stop at LAKE).
;
; Notable per-arm divergence:
;   - cart bytecode has FEWER sub-anim dispatch cases than dos/amiga
;     (issue 0079) — only 2 single-case dispatchers vs 4 cases each
;     elsewhere. This is concrete evidence cart was built from a
;     simplified or earlier source revision.
;
; Engine-managed special-purpose VM variables (HERO_POS_*, RANDOM_SEED, PAUSE_SLICES, etc.).
.include "../_common_vars.inc"


; PRISON: auto-generated EQU aliases for stuck literal-address operands.
.include "prison/prison_equ_aliases.inc"

; Level-entry bytecode (level start through the first shared folded routine).
.if BRANCH == "chahi_amiga_1991"
.include "prison/amiga__entry.inc"
.elif BRANCH == "cartridge_1992"
.include "prison/cart__entry.inc"
.else
.include "prison/dos__entry.inc"
.endif

; PRISON delay-then-preload resources (DELAY_4_QUANTUMS gating).
.include "prison/prison_delay_preload_resources.inc"

; PRISON inline single-instruction setters and small init helpers.
.include "prison/prison_inline_setters_and_init.inc"

; INLINE_SET_VAR29_TO_N setter helpers (5, 6, 28, A, …) + DRAW_CIN_406_408_BLOCK and DECREMENT_VAR29_BY_1 — the shared draw/set helpers that the var-29 state machine (in arm-specific entry chunks) dispatches into.
.include "prison/prison_var29_state_machine.inc"

; SET_VAR2F_TO_NN setters + INIT_VARS_2F_29_* helpers — same pattern as var29 above: shared setter helpers called BY the var-2F state machine (in arm-specific entry chunks), not the state machine itself.
.include "prison/prison_var2f_state_machine.inc"

; PRISON SFX players + deduplicated helpers (PLAY_SFX_005C_CH01).
.include "prison/prison_sfx_and_dedup_helpers.inc"

; PRISON page-fill var inits (INIT_VARS_16_17 et al.).
.include "prison/prison_pagefill_inits.inc"

; PRISON deduplicated short-body routines + landing-kill chains.
.include "prison/prison_dedups_and_landing_kill.inc"

; PRISON late-phase var setup (INIT_VARS_02_06 et al.).
.include "prison/prison_late_phase_var_setup.inc"

; PRISON late-phase scroll-up + page management.
.include "prison/prison_late_phase_scroll_and_pages.inc"

; PRISON step-draws (PRISON_HERO_WALK_LEFT_TURN_PRELUDE) — buddy walking animations.
.include "prison/prison_step_draws_and_breaks.inc"
