LABEL_0AAF:
	db 0x11

INTERPRET_KEY_TO_LETTER:
	jne [LAST_KEYCHAR], 0x0D, HANDLE_BACKSPACE_KEY	;@raw=0x0A,0x01,0xDA,0x0D,0x0A,0xBB
	mov [0x06], 0x0063	;@raw=0x00,0x06,0x00,0x63
	ret	;@raw=0x05

HANDLE_BACKSPACE_KEY:
	jne [LAST_KEYCHAR], 0x08, MAP_KEY_A_TO_Z_TO_INDEX	;@raw=0x0A,0x01,0xDA,0x08,0x0A,0xC6
	mov [0x06], 0x0062	;@raw=0x00,0x06,0x00,0x62
	ret	;@raw=0x05

MAP_KEY_A_TO_Z_TO_INDEX:
	jl [LAST_KEYCHAR], 0x41, CLEAR_LAST_KEYCHAR	;@raw=0x0A,0x04,0xDA,0x41,0x0A,0xDA
	jg [LAST_KEYCHAR], 0x5A, CLEAR_LAST_KEYCHAR	;@raw=0x0A,0x02,0xDA,0x5A,0x0A,0xDA
	mov [0x06], [LAST_KEYCHAR]	;@raw=0x01,0x06,0xDA
	sub [0x06], 0x0037	;@raw=0x03,0x06,0xFF,0xC9
	ret	;@raw=0x05
