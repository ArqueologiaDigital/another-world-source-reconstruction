HANDLE_PASSCODE_INPUT_OR_DISPATCH:
	call PASSCODE_ACCUMULATE_VALIDATION_HASH
	jne [LAST_KEYCHAR], 0x00, KEY_PRESSED_DISPATCH
	jne [HERO_ACTION], 0x00, KEY_PRESSED_DISPATCH
	mov [0x23], [0x01]
	jne [HERO_POS_UP_DOWN], 0x01, HANDLE_UP_KEY
	jg [0x01], 0x07, HANDLE_HORIZONTAL_KEY
	add [0x01], 0x0008
	jmp HANDLE_HORIZONTAL_KEY

HANDLE_UP_KEY:
	jne [HERO_POS_UP_DOWN], 0xFFFF, HANDLE_HORIZONTAL_KEY
	jl [0x01], 0x08, HANDLE_HORIZONTAL_KEY
	sub [0x01], 0x0008

HANDLE_HORIZONTAL_KEY:
	jmp MOVE_CURSOR_HORIZONTAL
	jne [HERO_POS_LEFT_RIGHT], 0x01, HANDLE_LEFT_KEY_EDGE_CHECK
	je [0x01], 0x07, PASSCODE_CURSOR_DRAW_AT_GRID
	je [0x01], 0x0F, PASSCODE_CURSOR_DRAW_AT_GRID

HANDLE_LEFT_KEY_EDGE_CHECK:
	jne [HERO_POS_LEFT_RIGHT], 0xFFFF, MOVE_CURSOR_HORIZONTAL
	je [0x01], 0x00, PASSCODE_CURSOR_DRAW_AT_GRID
	je [0x01], 0x08, PASSCODE_CURSOR_DRAW_AT_GRID

MOVE_CURSOR_HORIZONTAL:
	add [0x01], [HERO_POS_LEFT_RIGHT]
	and [0x01], 0x000F
	jne [0x01], 0x06, CHECK_RIGHT_WRAP_THEN_REDRAW
	add [0x01], [HERO_POS_LEFT_RIGHT]

CHECK_RIGHT_WRAP_THEN_REDRAW:
	jne [0x01], 0x0E, PASSCODE_CURSOR_DRAW_AT_GRID
	add [0x01], [HERO_POS_LEFT_RIGHT]

PASSCODE_CURSOR_DRAW_AT_GRID:
	mov [0x05], [0x01]
	mov [0x25], [0x07]
	mov [0x26], [0x08]
	call PASSCODE_GRID_CELL_POSITION
	mov [0x27], [0x07]
	mov [0x28], [0x08]
	jne [0x25], [0x27], ANIMATE_CURSOR_TRANSITION
	jne [0x26], [0x28], ANIMATE_CURSOR_TRANSITION
	video offset=CINEMATIC_PASSCODE_CURSOR, x=[0x07], y=[0x08]
	break
	jmp HANDLE_PASSCODE_INPUT_OR_DISPATCH
LABEL_06B3:
	db 0x11

ANIMATE_CURSOR_TRANSITION:
	mov [0x07], [0x25]
	mov [0x08], [0x26]
	mov [0x24], 0x0003
	jmp PASSCODE_CURSOR_SNAP_TO_TARGET_CELL

CURSOR_ANIM_X_RIGHT_STEP_LOOP:
	jg [0x25], [0x27], CURSOR_ANIM_X_AXIS_STEP
	add [0x07], [0x24]
	jl [0x07], [0x27], CURSOR_ANIM_X_AXIS_STEP
	mov [0x07], [0x27]

CURSOR_ANIM_X_AXIS_STEP:
	jl [0x25], [0x27], CURSOR_ANIM_Y_AXIS_STEP
	sub [0x07], [0x24]
	jg [0x07], [0x27], CURSOR_ANIM_Y_AXIS_STEP
	mov [0x07], [0x27]

CURSOR_ANIM_Y_AXIS_STEP:
	jg [0x26], [0x28], CURSOR_ANIM_Y_BACKWARD_STEP
	add [0x08], [0x24]
	jl [0x08], [0x28], CURSOR_ANIM_Y_BACKWARD_STEP
	mov [0x08], [0x28]

CURSOR_ANIM_Y_BACKWARD_STEP:
	jl [0x26], [0x28], CURSOR_ANIM_CHECK_DESTINATION
	sub [0x08], [0x24]
	jg [0x08], [0x28], CURSOR_ANIM_CHECK_DESTINATION
	mov [0x08], [0x28]

CURSOR_ANIM_CHECK_DESTINATION:
	jne [0x07], [0x27], PASSCODE_CURSOR_SLIDE_FRAME_TICK
	jne [0x08], [0x28], PASSCODE_CURSOR_SLIDE_FRAME_TICK
	jmp HANDLE_PASSCODE_INPUT_OR_DISPATCH
