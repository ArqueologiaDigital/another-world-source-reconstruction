SUM_HASH_VARS_TO_VAR_64:
	add [0x64], 0x0071
	add [0x64], [0x32]
	add [0x64], [0x01]
	add [0x64], [0x0A]
	add [0x64], [0x0B]
	add [0x64], [HERO_ACTION_POS_MASK]
	mov [0x65], [0x64]
	and [0x65], 0x00FF
	ret

;@if BRANCH == "chahi_amiga_1991"
