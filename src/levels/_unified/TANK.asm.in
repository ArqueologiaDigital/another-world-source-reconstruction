; STAGE TANK: alien arena tank-combat sequence.
;
; Gameplay role: Lester pilots an alien tank in an arena, fighting
; enemy tanks and obstacles. The smallest of the action stages.
;
; Branches that ship TANK:
;   chahi_amiga_1991, dos_1992, cartridge_1992 (genesis_eu).
;
; Structure: only 24 folded shared bodies (vs 264 in CAVES) — the
; bytecode is tightly focused on tank movement, projectile state
; machines, and HUD updates. Most of the per-arm divergence is
; concentrated in initial banker setups and music marks.
;
; Engine-managed special-purpose VM variables (HERO_POS_*, RANDOM_SEED, PAUSE_SLICES, etc.).
.include "../_common_vars.inc"

; Cross-stage helper EQUs (LABEL_<HEX> / ADDR_AT_* placeholders shared between levels).
.include "_helpers/_helpers_equ_aliases.inc"

; Level-entry bytecode (level start through the first shared folded routine).
.if BRANCH == "chahi_amiga_1991"
.include "tank/amiga__entry.inc"
.elif BRANCH == "cartridge_1992"
.include "tank/cart__entry.inc"
.else
.include "tank/dos__entry.inc"
.endif

.if BRANCH in ("cartridge_1992", "dos_1992")
INLINE_SET_VAR6D_TO_0:
	mov [0x6D], 0x0000
.endif

; Port-specific body chunk after the shared `INLINE_SET_VAR6D_TO_0` routine.
.if BRANCH == "cartridge_1992"
.include "tank/cart__post_INLINE_SET_VAR6D_TO_0.inc"
.elif BRANCH == "dos_1992"
.include "tank/dos__post_INLINE_SET_VAR6D_TO_0.inc"
.endif

.if BRANCH in ("chahi_amiga_1991", "dos_1992")
SETUP_TANK_HERO_VARS_PLAY_4SFX:
	mov [0x01], 0x00AA
	mov [0x02], 0x0064
	mov [0x03], 0x0040
	mov [0x2B], 0x0014
	play id=0x0084, freq=0x0F, vol=0x20, channel=0x03
	play id=0x0084, freq=0x11, vol=0x40, channel=0x02
	play id=0x008B, freq=0x0A, vol=0x40, channel=0x01
	play id=0x008B, freq=0x14, vol=0x40, channel=0x00
.endif

; Port-specific body chunk after the shared `SETUP_TANK_HERO_VARS_PLAY_4SFX` routine.
.if BRANCH == "chahi_amiga_1991"
.include "tank/amiga__post_SETUP_TANK_HERO_VARS_PLAY_4SFX.inc"
.elif BRANCH == "dos_1992"
.include "tank/dos__post_SETUP_TANK_HERO_VARS_PLAY_4SFX.inc"
.endif

.if BRANCH in ("cartridge_1992", "dos_1992")
INLINE_SET_VAR6B_TO_50:
	mov [0x6B], 0x0050
.endif

; Port-specific body chunk after the shared `INLINE_SET_VAR6B_TO_50` routine.
.if BRANCH == "cartridge_1992"
.include "tank/cart__post_INLINE_SET_VAR6B_TO_50.inc"
.elif BRANCH == "dos_1992"
.include "tank/dos__post_INLINE_SET_VAR6B_TO_50.inc"
.endif

.if BRANCH in ("cartridge_1992", "dos_1992")
INCR_VAR_6C_BY_10_3X:
	add [0x6C], 0x000A
	break
	add [0x6C], 0x000A
	break
	add [0x6C], 0x000A
.endif

; Port-specific body chunk after the shared `INCR_VAR_6C_BY_10_3X` routine.
.if BRANCH == "cartridge_1992"
.include "tank/cart__post_INCR_VAR_6C_BY_10_3X.inc"
.elif BRANCH == "dos_1992"
.include "tank/dos__post_INCR_VAR_6C_BY_10_3X.inc"
.endif

.if BRANCH in ("cartridge_1992", "dos_1992")
BANKSWITCH_6_FOR_CODE_ENTRY:
	mov [0x00], 0x003C
		bankSwitch 6;  Secret Code Entry Screen	;  Secret Code Entry Screen
	killChannel
.endif

; Port-specific body chunk after the shared `BANKSWITCH_6_FOR_CODE_ENTRY` routine.
.if BRANCH == "cartridge_1992"
.include "tank/cart__post_BANKSWITCH_6_FOR_CODE_ENTRY.inc"
.elif BRANCH == "dos_1992"
.include "tank/dos__post_BANKSWITCH_6_FOR_CODE_ENTRY.inc"
.endif

; TANK var-5F manipulation (INCREMENT_VAR5F_BY_8 et al.).
.include "tank/tank_var5f_manipulation.inc"

; TANK inline setters + hash bookkeeping.
.include "tank/tank_inline_setters_and_hash.inc"

; TANK drive vars (INCREMENT_VAR44_BY_37 et al.).
.include "tank/tank_drive_vars.inc"

; TANK animation timing (ALTERNATE_VAR06_VAR04_TIMING).
.include "tank/tank_animation_timing.inc"

; TANK drawing helpers (INIT_VARS_A_B_PAL_1).
.include "tank/tank_drawing_helpers.inc"
