;@if BRANCH in ("cartridge_1992", "dos_1992")
INCR_VAR_6C_BY_10_3X:
	add [0x6C], 0x000A
	break
	add [0x6C], 0x000A
	break
	add [0x6C], 0x000A
;@endif

