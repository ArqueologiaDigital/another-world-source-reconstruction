INIT_VAR1_NEG50_PLAY_8B_TWICE:
	mov [0x01], 0xFFCE
	mov [0x02], 0x0064
	mov [0x03], 0x0040
	mov [0x2B], 0x0023
	play id=0x008B, freq=0x22, vol=0x40, channel=0x01
	play id=0x008B, freq=0x14, vol=0x40, channel=0x00
	mov [PAUSE_SLICES], 0x0006
;@endif

