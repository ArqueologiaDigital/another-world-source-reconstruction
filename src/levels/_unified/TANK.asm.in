ALTERNATE_VAR06_VAR04_TIMING:
	mov [0x06], 0x0002	;@raw=0x00,0x06,0x00,0x02
	mov [0x04], 0x0001	;@raw=0x00,0x04,0x00,0x01
	break	;@raw=0x06
	break	;@raw=0x06
	mov [0x06], 0x0001	;@raw=0x00,0x06,0x00,0x01
	mov [0x04], 0x0002	;@raw=0x00,0x04,0x00,0x02
	break	;@raw=0x06
	break	;@raw=0x06
	mov [0x06], 0x0001	;@raw=0x00,0x06,0x00,0x01
	mov [0x04], 0x0003	;@raw=0x00,0x04,0x00,0x03
	break	;@raw=0x06
	break	;@raw=0x06
	mov [0x06], 0x0005	;@raw=0x00,0x06,0x00,0x05
	mov [0x04], 0x0004	;@raw=0x00,0x04,0x00,0x04
	sub [0x05], 0x0004	;@raw=0x03,0x05,0xFF,0xFC
	break	;@raw=0x06
	mov [0x06], 0x0006	;@raw=0x00,0x06,0x00,0x06
	break	;@raw=0x06
	mov [0x06], 0x0007	;@raw=0x00,0x06,0x00,0x07
	mov [0x06], 0x0008	;@raw=0x00,0x06,0x00,0x08
	break	;@raw=0x06
	sub [0x07], 0x0001	;@raw=0x03,0x07,0xFF,0xFF
	break	;@raw=0x06
	mov [0x04], 0x0000	;@raw=0x00,0x04,0x00,0x00
	killChannel	;@raw=0x11

