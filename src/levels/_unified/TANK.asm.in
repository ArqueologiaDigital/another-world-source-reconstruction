INIT_TANK_DRIVE_VARS:
	mov [0x0F], 0x008C
	mov [0x10], 0x0064
	mov [0x01], 0x00A0
	mov [0x02], 0x0064
	mov [0x03], 0x0040
	mov [0x3E], 0x0000
	mov [0x41], 0x0000
	mov [0x37], 0x0000
	mov [0x45], 0x0000
	mov [0x46], 0x0000
	mov [0x47], 0x0000
	mov [0x4E], 0x0000
	mov [0x4F], 0x0000
	mov [0x56], 0x0000
	mov [0x57], 0x0000
	mov [0x62], 0x000B
	mov [0x5F], 0x000B
	mov [0x63], 0x0000
	mov [HACK_VAR_67], 0x0000
	mov [0x69], 0x00FA
	mov [0x6E], 0x0000
	mov [0x70], 0x0000
	mov [0x71], 0x0000
	mov [0x72], 0x0000
	mov [0x73], 0x0000
	mov [0x74], 0x0000
	mov [0x75], 0x0000
	mov [0x76], 0x0000
	ret
;@endif

