.if BRANCH == "chahi_amiga_1991"
CINEMATIC_LAB_AUTH_ID_SCREEN_BG		EQU 0xF754
CINEMATIC_LAB_AUTH_ID_SCREEN_SCAN_F0		EQU 0xF9A6
CINEMATIC_LAB_AUTH_ID_SCREEN_SCAN_F1		EQU 0xF9F6
CINEMATIC_LAB_AUTH_ID_SCREEN_SCAN_F2		EQU 0xF612
.else
CINEMATIC_IDENT_SCREEN_EDGE_RIGHT_LOWER		EQU 0xCEFA
CINEMATIC_IDENT_SCREEN_EDGE_RIGHT_UPPER		EQU 0xCF0A
CINEMATIC_IDENT_SCREEN_EDGE_LEFT_INNER		EQU 0xCEA6
CINEMATIC_IDENT_SCREEN_EDGE_RIGHT		EQU 0xCE8E
.endif
.if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_IDENT_SCREEN_EDGE_LEFT_OUTER		EQU 0xCE76
.endif
.if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
CINEMATIC_IDENT_SCREEN_GRATICULE		EQU 0xCECE
.endif

INTRO_IDENT_SCREEN_INIT:
	mov [PAUSE_SLICES], 0x0003
	fill page=0xFF, color=0x02
.if BRANCH == "chahi_amiga_1991"
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_RIGHT_LOWER, x=322, y=145
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_RIGHT_UPPER, x=322, y=59
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_LEFT_INNER, x=17, y=100
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_RIGHT, x=322, y=100
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_LEFT_OUTER, x=65534, y=99
	video offset=CINEMATIC_IDENT_SCREEN_GRATICULE, x=160, y=108
.else
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_RIGHT_LOWER, x=322, y=145
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_RIGHT_UPPER, x=322, y=59
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_LEFT_INNER, x=17, y=100
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_RIGHT, x=322, y=100
	video offset=CINEMATIC_IDENT_SCREEN_EDGE_LEFT_OUTER, x=65534, y=99
	video offset=CINEMATIC_IDENT_SCREEN_GRATICULE, x=160, y=108
.endif
	text id=0x0192, x=22, y=16, color=0x05
	copyVideoPage src=0xFF, dst=0x00
	copyVideoPage src=0xFF, dst=0x03
	setPalette 0x0B
	mov [0x04], 0x00DC
	mov [0x06], 0x0040
	setup channel=0x06, address=SCENE_TRANSITION_NEXT_PHASE
	mov [0x01], 0x0032

INTRO_IDENT_SCREEN_GREETING_DELAY:
	break
	djnz [0x01], INTRO_IDENT_SCREEN_GREETING_DELAY
	mov [0x01], 0x0023
.if BRANCH != "chahi_amiga_1991"
	mov [PAUSE_SLICES], 0x0005
.endif

DISPLAY_TEXT_190_LOOP:
	break
	text id=0x0190, x=3, y=168, color=0x0B
	djnz [0x01], DISPLAY_TEXT_190_LOOP
.if BRANCH == "chahi_amiga_1991"
	mov [0x01], 0x0032
.else
	mov [0x01], 0x0031
	mov [PAUSE_SLICES], 0x0005
.endif

DISPLAY_TEXT_191_LOOP:
	break
	text id=0x0191, x=3, y=168, color=0x0B
	djnz [0x01], DISPLAY_TEXT_191_LOOP
	setup channel=0x08, address=DELETE_CHANNELS_0A_TO_1F
.if BRANCH != "chahi_amiga_1991"
	break
	text id=0x0191, x=3, y=168, color=0x0B
.endif
	setup channel=0x02, address=INTRO_TRANSITION_TO_LAKE_SCENE
.if BRANCH != "chahi_amiga_1991"
	setup channel=0x3C, address=BLIT_AND_COPY_PAGE_FF_LOOP
.endif
	killChannel

