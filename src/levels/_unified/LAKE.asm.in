	sub [0x0E], 0x000A
	video type=1, offset=CINEMATIC_BEAST_KILLED_F1, x=[0x0e], y=[0x0f], zoom=0x40
	play id=0x0052, freq=0x1E, vol=0x3F, channel=0x00
	break
	sub [0x0E], 0x0010
	video type=1, offset=CINEMATIC_BEAST_KILLED_F2, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x0018
