BEAST_AI_RANGE_CHECK_VAR_39:
	mov [0x3A], [0x0C]
	sub [0x3A], 0x0004
	je [0x39], 0x01, BEAST_AI_RANGE_BOUNDS_CHK
	add [0x3A], 0x0008

BEAST_AI_RANGE_BOUNDS_CHK:
