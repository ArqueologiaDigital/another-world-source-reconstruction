	setup channel=0x14, address=HERO_STAND_LEFT_LOOP

HERO_Y_FROM_X_RANGE_0:
	jg [0x01], 0x74, HERO_Y_FROM_X_RANGE_1
	mov [0x02], 0x0094
	jmp YIELD_THEN_RESTART_AT_1B22

HERO_Y_FROM_X_RANGE_1:
	jg [0x01], 0x84, HERO_Y_FROM_X_RANGE_2
	mov [0x02], 0x0098
	mov [0x28], 0x0084
	sub [0x28], [0x01]

HERO_Y_FROM_X_RANGE_1_LOOP:
	sub [0x28], 0x000A
	sub [0x02], 0x0001
	jg [0x28], 0x00, HERO_Y_FROM_X_RANGE_1_LOOP
	jmp YIELD_THEN_RESTART_AT_1B22

HERO_Y_FROM_X_RANGE_2:
	jg [0x01], 0xAA, HERO_Y_FROM_X_RANGE_3
	mov [0x02], 0x00A2
	mov [0x28], 0x00AA
	sub [0x28], [0x01]

HERO_Y_FROM_X_RANGE_2_LOOP:
	sub [0x28], 0x0004
	sub [0x02], 0x0001
	jg [0x28], 0x00, HERO_Y_FROM_X_RANGE_2_LOOP
	jmp YIELD_THEN_RESTART_AT_1B22

HERO_Y_FROM_X_RANGE_3:
	jg [0x01], 0xE6, HERO_Y_FROM_X_RANGE_4
	mov [0x02], 0x00B6
	mov [0x28], 0x00E6
	sub [0x28], [0x01]

HERO_Y_FROM_X_RANGE_3_LOOP:
	sub [0x28], 0x0003
	sub [0x02], 0x0001
	jg [0x28], 0x00, HERO_Y_FROM_X_RANGE_3_LOOP
	jmp YIELD_THEN_RESTART_AT_1B22

HERO_Y_FROM_X_RANGE_4:
	jg [0x01], 0xF0, YIELD_THEN_RESTART_AT_1B22
	mov [0x02], 0x00B6
	mov [0x28], 0x00F0
	sub [0x28], [0x01]

HERO_Y_FROM_X_RANGE_4_LOOP:
