	mov [0x13], 0x00A0
	mov [0x0C], 0x0055
	mov [0x0D], [0x0C]
	mov [0x0E], [0x0C]
	mov [0x0F], [0x0C]
	mov [0x10], [0x0C]
	mov [0x11], [0x0C]
	mov [0x12], 0x000F

BUBBLE_UPDATE_PHASE_1:
	sub [0x0C], 0x0009
	sub [0x0D], 0x0007
	sub [0x0E], 0x0006
	sub [0x0F], 0x0004
	sub [0x10], 0x0003
	sub [0x11], 0x0002
	break
	djnz [0x12], BUBBLE_UPDATE_PHASE_1
	mov [0x12], 0x0032

BUBBLE_UPDATE_PHASE_2:
	sub [0x0E], 0x0006
	sub [0x0F], 0x0004
	sub [0x10], 0x0003
	sub [0x11], 0x0002
	break
	djnz [0x12], BUBBLE_UPDATE_PHASE_2
