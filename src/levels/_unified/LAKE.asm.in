CINEMATIC_POOL_SURFACE_WAVES_4		EQU 0x2976
CINEMATIC_POOL_SURFACE_WAVES_5		EQU 0x29CA
CINEMATIC_POOL_SURFACE_WAVES_6		EQU 0x2A12
CINEMATIC_POOL_WATER_WAVY_GLARE_EFFECT		EQU 0x2766
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_0		EQU 0x20BC
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_1		EQU 0x2116
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_2		EQU 0x216A
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_3		EQU 0x229C
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_4		EQU 0x23F2
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_5		EQU 0x2524
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_6		EQU 0x2610
CINEMATIC_INSIDE_ALIEN_POOL_SCENARIO_7		EQU 0x2718
CINEMATIC_INSIDE_ALIEN_POOL_SURFACE_0		EQU 0x2A56
CINEMATIC_INSIDE_ALIEN_POOL_SURFACE_1		EQU 0x2AA0
;@endif


	org 0x0000

ENTRY_POINT_OF_LAKE_LEVEL:
	call INIT_VIDEO_BUFFERS
;@if BRANCH == "gba_2004"
	song id=0x0FA1, delay=0x0000, pos=0x03
;@endif
;@if BRANCH in ("cartridge_1992", "gba_2004")
	mov [0xE3], 0x0000
	je [0xDB], 0x00, EXTRA_RESOURCE_LOADS_BLOCK_2
	load id=0x07D2
	jmp INIT_AUDIO_AND_SCENE_AFTER_LOADS

EXTRA_RESOURCE_LOADS_BLOCK_2:
	load id=0x0030
	load id=0x0032
	load id=0x0039
	load id=0x003E
;@endif
;@if BRANCH == "dos_1992"
	load id=0x0030
	load id=0x0032
	load id=0x0039
	load id=0x003E
;@endif
	load id=0x0010
	load id=0x0008
	load id=0x0051
;@if BRANCH == "chahi_amiga_1991"
	load id=0x0030
;@endif
	load id=0x0031
	load id=0x0032
	load id=0x0035
	load id=0x0039
	load id=0x003A
	load id=0x003D
	load id=0x003E
	load id=0x004A
	load id=0x004B
	load id=0x004C
	load id=0x004D
	load id=0x004E
	load id=0x004F
	load id=0x003B
	load id=0x0050
	load id=0x003C
	load id=0x0052
	load id=0x0054
	load id=0x002D
	jmp INIT_AUDIO_AND_SCENE_AFTER_LOADS
	load id=0x0089
	load id=0x0002
	load id=0x0081
	load id=0x0003

INIT_AUDIO_AND_SCENE_AFTER_LOADS:
	play id=0x0030, freq=0x00, vol=0x00, channel=0x00
	play id=0x0030, freq=0x00, vol=0x00, channel=0x01
	play id=0x0030, freq=0x00, vol=0x00, channel=0x02
	play id=0x0030, freq=0x00, vol=0x00, channel=0x03
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	setup channel=0x3C, address=BLIT_FROM_PAGE_40_LOOP
;@elif BRANCH == "chahi_amiga_1991"
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
	mov [0x0C], 0x0000
	mov [0x04], 0x0000
	mov [HERO_ACTION_POS_MASK], 0x0000
	mov [0x01], 0x0000
;@if BRANCH in ("cartridge_1992", "chahi_amiga_1991", "dos_1992")
	mov [PAUSE_SLICES], 0x0004
;@elif BRANCH == "gba_2004"
	mov [PAUSE_SLICES], 0x0007
;@endif
	break
	call VERIFY_INTEGRITY_OR_HALT
	setup channel=0x03, address=A_CALM_ALIEN_POOL_BEFORE_LESTERS_ARRIVAL
	killChannel

KILL_CHANNEL_ROUTINE:
	killChannel

VERIFY_INTEGRITY_OR_HALT:
;@if BRANCH == "gba_2004"
	ret
;@endif
	and [0xBC], 0x0010
;@if BRANCH in ("cartridge_1992", "gba_2004")
	mov [0xF8], [0xE4]
	and [0xF8], 0x003C
;@if BRANCH == "cartridge_1992"
	ret
;@endif
;@elif BRANCH == "chahi_amiga_1991"
	and [0xC6], 0x0080
;@elif BRANCH == "dos_1992"
	mov [0xF8], [0xE4]
	and [0xF8], 0x003C
;@endif
	je [0xBC], 0x00, SHUTDOWN_VM
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	jne [0xF2], 0x0FA0, SHUTDOWN_VM
;@elif BRANCH == "chahi_amiga_1991"
	je [0xC6], 0x00, SHUTDOWN_VM
	jne [0xF2], 0x1770, SHUTDOWN_VM
;@endif
	jne [HACK_VAR_DC], 0x21, SHUTDOWN_VM
	ret

SHUTDOWN_VM:
	deleteChannels first=0x00, last=0x3F
	setup channel=0x3C, address=KILL_CHANNEL_ROUTINE
	killChannel

LAKE_LEVEL_INIT:
	fill page=0x00, color=0x00
	fill page=0x03, color=0x00
	fill page=0xFF, color=0x00
	mov [PAUSE_SLICES], 0x0005
;@if BRANCH in ("cartridge_1992", "gba_2004")
	or [0xE3], 0x0001
;@endif
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
	call VERIFY_INTEGRITY_OR_HALT
;@if BRANCH in ("cartridge_1992", "gba_2004")
	setPalette 0x1D
;@endif
;@if BRANCH == "gba_2004"
	song id=0x0FA0, delay=0x0000, pos=0x00
;@endif

INTRO_WAIT_KEY_RELEASE:
	break
;@if BRANCH in ("cartridge_1992", "gba_2004")
	text id=0x013D, x=5, y=80, color=0x0C
	text id=0x013C, x=5, y=180, color=0x0D
	text id=0x015E, x=26, y=180, color=0x0E
	call SET_HERO_ACTION_TO_1_IF_GROUNDED_AND_DB_SET
;@endif
;@if BRANCH == "dos_1992"
	call SET_HERO_ACTION_TO_1_IF_GROUNDED_AND_DB_SET
;@endif
	jne [HERO_ACTION], 0x00, INTRO_WAIT_KEY_RELEASE
;@if BRANCH == "chahi_amiga_1991"
	setPalette 0x1D
;@endif
;@if BRANCH == "dos_1992"
	setPalette 0x1D
;@endif

INTRO_WAIT_KEY_PRESS:
	text id=0x013D, x=5, y=80, color=0x0C
	text id=0x013C, x=5, y=180, color=0x0D
	text id=0x015E, x=26, y=180, color=0x0E
	break
;@if BRANCH in ("cartridge_1992", "gba_2004")
	call SET_HERO_ACTION_TO_1_IF_GROUNDED_AND_DB_SET
;@endif
;@if BRANCH == "dos_1992"
	call SET_HERO_ACTION_TO_1_IF_GROUNDED_AND_DB_SET
;@endif
	je [HERO_ACTION], 0x00, INTRO_WAIT_KEY_PRESS
	mov [0x00], 0x000A
	setup channel=0x00, address=ENTRY_POINT_OF_LAKE_LEVEL
	killChannel
;@if BRANCH in ("cartridge_1992", "gba_2004")

SET_HERO_ACTION_TO_1_IF_GROUNDED_AND_DB_SET:
	je [0xDB], 0x00, RET_TARGET_1A88
	jne [HERO_POS_JUMP_DOWN], 0xFFFF, RET_TARGET_1A88
	mov [HERO_ACTION], 0x0001
	ret
;@endif
;@if BRANCH == "dos_1992"

SET_HERO_ACTION_TO_1_IF_GROUNDED_AND_DB_SET:
	je [0xDB], 0x00, RET_TARGET_1A88
	jne [HERO_POS_JUMP_DOWN], 0xFFFF, RET_TARGET_1A88
	mov [HERO_ACTION], 0x0001
	ret
;@endif
	break
	break
	break
	break
	setPalette 0x11
	break
	setPalette 0x12
	break
	setPalette 0x13
	break
	setPalette 0x14
	break
	setPalette 0x15
	break
	setPalette 0x16
	break
	setPalette 0x17
	break
	setPalette 0x18
	play id=0x003D, freq=0x14, vol=0x00, channel=0x00
	play id=0x003D, freq=0x14, vol=0x00, channel=0x01
	play id=0x003D, freq=0x14, vol=0x00, channel=0x02
	play id=0x003D, freq=0x14, vol=0x00, channel=0x03
	fill page=0x00, color=0x00
	deleteChannels first=0x00, last=0x3B
	load id=0x3E80
	killChannel

;@if BRANCH in ("cartridge_1992", "gba_2004")
BLIT_FROM_PAGE_40_LOOP:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x40, dst=0xFF
	break
	jmp BLIT_FROM_PAGE_40_LOOP

;@endif
;@if BRANCH == "dos_1992"
BLIT_FROM_PAGE_40_LOOP:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x40, dst=0xFF
	break
	jmp BLIT_FROM_PAGE_40_LOOP

;@endif
BLIT_FROM_PAGE_0_LOOP:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF
	break
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF
	break
	jmp BLIT_FROM_PAGE_40_LOOP
;@elif BRANCH == "chahi_amiga_1991"
	jmp BLIT_FROM_PAGE_0_LOOP
;@endif

BLIT_AND_SHOW_PAGE_FF_LOOP:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	break
	jmp BLIT_AND_SHOW_PAGE_FF_LOOP

BLIT_FROM_PAGE_3_LOOP:
	blitFramebuffer 0xFF
	selectVideoPage 0xFF
	copyVideoPage src=0x03, dst=0xFF
	break
	jmp BLIT_FROM_PAGE_3_LOOP

RENDER_FRAME_DISPATCH:
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	je [0x1C], 0x00, BLIT_FROM_PAGE_40_LOOP
;@elif BRANCH == "chahi_amiga_1991"
	je [0x1C], 0x00, BLIT_FROM_PAGE_0_LOOP
;@endif
	je [0x1C], 0x02, CLEAR_FRAMEBUFFER_TO_COLOR_4_LOOP
;@if BRANCH in ("cartridge_1992", "gba_2004")
	jg [0x2A], 0x03, BLIT_FROM_PAGE_40_LOOP
	jne [0xDB], 0x00, BLIT_FROM_PAGE_40_VIA_C0
;@endif
;@if BRANCH == "dos_1992"
	jg [0x2A], 0x03, BLIT_FROM_PAGE_40_LOOP
	jne [0xDB], 0x00, BLIT_FROM_PAGE_40_VIA_C0
;@endif
	copyVideoPage src=0xFF, dst=0x03
	copyVideoPage src=0x83, dst=0xFF
	mov [0x65], 0x0000
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	jmp BLIT_FROM_PAGE_40_LOOP

BLIT_FROM_PAGE_40_VIA_C0:
	copyVideoPage src=0xC0, dst=0x00
	jmp BLIT_FROM_PAGE_40_LOOP
;@elif BRANCH == "chahi_amiga_1991"
	jmp BLIT_FROM_PAGE_0_LOOP
	killChannel
;@endif

INIT_VIDEO_BUFFERS:
	fill page=0x01, color=0x00
	fill page=0x02, color=0x00
	fill page=0x03, color=0x00
	fill page=0x00, color=0x00
	selectVideoPage 0x01
	blitFramebuffer 0x01
	blitFramebuffer 0xFF
	blitFramebuffer 0x02
	ret
	killChannel

SHOW_PAGE_0_LOOP:
	selectVideoPage 0x00
	break
	jmp SHOW_PAGE_0_LOOP
	killChannel

SHOW_PAGE_FF_LOOP:
	selectVideoPage 0xFF
	break
	jmp SHOW_PAGE_FF_LOOP
	killChannel

INC_VAR_6E_PER_TICK_LOOP:
	add [0x6E], 0x0001
	break
	jmp INC_VAR_6E_PER_TICK_LOOP
	killChannel

WAIT_FOR_TIMER_AND_HACK_67_THEN_SETUP_31:
	break
	jl [0x6E], 0x64, WAIT_FOR_TIMER_AND_HACK_67_THEN_SETUP_31
	je [HACK_VAR_67], 0x05, WAIT_FOR_TIMER_AND_HACK_67_THEN_SETUP_31
	je [HACK_VAR_67], 0x02, WAIT_FOR_TIMER_AND_HACK_67_THEN_SETUP_31
	setup channel=0x31, address=PICK_RANDOM_X_FOR_DROPLET_AND_PLAY_DROP_SOUND
	deleteChannels first=0x24, last=0x25
	mov [0x71], 0x0001

SCROLL_BG_RANDOM_LOOP:
	setup channel=0x3C, address=RENDER_FRAME_DISPATCH
	break
	call COMPUTE_RANDOM_BIT_MASKS
	mov [SCROLL_Y], [0x38]
	add [SCROLL_Y], 0x0001
	setup channel=0x3C, address=RENDER_FRAME_DISPATCH
	break
	call COMPUTE_RANDOM_BIT_MASKS
	mov [SCROLL_Y], 0xFFFF
	add [SCROLL_Y], [0x38]
	je [HACK_VAR_67], 0x05, INIT_OPENING_BG_THREADS
	je [HACK_VAR_67], 0x02, INIT_OPENING_BG_THREADS
	jl [0x6E], 0x96, SCROLL_BG_RANDOM_LOOP

INIT_OPENING_BG_THREADS:
	mov [0x71], 0x0000
	mov [0x6E], 0x0001
	mov [0x22], 0x0001
	setup channel=0x24, address=AMBIENT_CH24_DELAY_F1
	setup channel=0x25, address=AMBIENT_CH25_RESTART
	jmp WAIT_FOR_TIMER_AND_HACK_67_THEN_SETUP_31
	killChannel

PICK_RANDOM_X_FOR_DROPLET_AND_PLAY_DROP_SOUND:
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x6F], [0x3F]
	mov [0x70], 0xFFEC
	play id=0x0054, freq=0x0A, vol=0x20, channel=0x02

DRAW_FALLING_DROPLET_LOOP_THEN_SPLASH:
	break
	video type=1, offset=CINEMATIC_WATER_DROPLET_FALLING, x=[0x6f], y=[0x70], zoom=0x40
	add [0x70], 0x0020
	jl [0x70], 0xB6, DRAW_FALLING_DROPLET_LOOP_THEN_SPLASH
	mov [0x70], 0x00BA
	break
	video type=1, offset=CINEMATIC_WATER_SPLASH_FRAME_0, x=[0x6f], y=[0x70], zoom=0x40
	break
	video type=1, offset=CINEMATIC_WATER_SPLASH_FRAME_1, x=[0x6f], y=[0x70], zoom=0x40
	je [HACK_VAR_67], 0x01, PICK_RANDOM_X_FOR_DROPLET_005
	selectVideoPage 0x00
	video type=1, offset=CINEMATIC_DROPLET_LARGE, x=[0x6f], y=[0x70], zoom=0x40
	selectVideoPage 0xFF
	jmp PICK_RANDOM_X_FOR_DROPLET_005
	killChannel

PICK_RANDOM_X_FOR_DROPLET_005:
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x6F], [0x3F]
	add [0x6F], [0x3D]
	mov [0x70], 0xFFEC

RAIN_DROPLET_FALL_LOOP:
	break
	video type=1, offset=CINEMATIC_RAIN_DROPLET_F0, x=[0x6f], y=[0x70], zoom=0x40
	add [0x70], 0x0020
	jl [0x70], 0xB6, RAIN_DROPLET_FALL_LOOP
	break
	mov [0x70], 0x00B6
	call COMPUTE_RANDOM_BIT_MASKS
	add [0x70], [0x39]
	video type=1, offset=CINEMATIC_RAIN_DROPLET_F1, x=[0x6f], y=[0x70], zoom=0x40
	play id=0x0054, freq=0x0F, vol=0x20, channel=0x03
	break
	video type=1, offset=CINEMATIC_RAIN_DROPLET_F2, x=[0x6f], y=[0x70], zoom=0x40
	je [HACK_VAR_67], 0x01, PICK_RANDOM_X_FOR_DROPLET_009
	selectVideoPage 0x00
	video type=1, offset=CINEMATIC_RAIN_DROPLET_F3, x=[0x6f], y=[0x70], zoom=0x40
	selectVideoPage 0xFF
	jmp PICK_RANDOM_X_FOR_DROPLET_009
	killChannel

PICK_RANDOM_X_FOR_DROPLET_009:
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x6F], [0x3F]
	add [0x6F], [0x3D]
	mov [0x70], 0xFFF0

DROPLET_009_FALL_LOOP:
	break
	video type=1, offset=CINEMATIC_DROPLET_RANDOM_X, x=[0x6f], y=[0x70], zoom=0x40
	add [0x70], 0x0023
	jl [0x70], 0xFA, DROPLET_009_FALL_LOOP
	je [0x71], 0x01, PICK_RANDOM_X_FOR_DROPLET_AND_PLAY_DROP_SOUND
	killChannel
	mov [0x72], 0x0190
	mov [0x73], 0x012C
	play id=0x0054, freq=0x14, vol=0x10, channel=0x03

DRAW_4_DROPLETS_LOOP:
	break
	add [0x72], 0x0014
	add [0x73], 0x0010
	video type=1, offset=COMMON_VIDEO_074, x=[0x74], y=[0x72], zoom=0x40
	sub [0x72], 0x0014
	video type=1, offset=COMMON_VIDEO_074, x=[0x75], y=[0x72], zoom=0x40
	sub [0x72], 0x0028
	video type=1, offset=COMMON_VIDEO_074, x=[0x76], y=[0x72], zoom=0x40
	video type=1, offset=COMMON_VIDEO_074, x=[0x77], y=[0x73], zoom=0x40
	sub [0x73], 0x003C
	video type=1, offset=COMMON_VIDEO_074, x=[0x78], y=[0x73], zoom=0x40
	add [0x72], 0x003C
	add [0x73], 0x003C
	je [0x71], 0x01, RESET_DROPLET_72_X_IF_OFFSCREEN
	jl [0x72], 0x012C, DRAW_4_DROPLETS_LOOP
	jl [0x73], 0x012C, DRAW_4_DROPLETS_LOOP
	jmp DRAW_4_DROPLETS_END_KILL

RESET_DROPLET_72_X_IF_OFFSCREEN:
	jl [0x72], 0x012C, RESET_DROPLET_73_X_IF_OFFSCREEN
	mov [0x72], 0xFFEC
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x74], [0x3F]
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x75], [0x3F]
	mov [0x76], [RANDOM_SEED]

RESET_DROPLET_73_X_IF_OFFSCREEN:
	jl [0x73], 0x012C, JMP_TO_DRAW_4_DROPLETS_LOOP
	mov [0x73], 0xFFEC
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x77], [0x3F]
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x78], [0x3F]

JMP_TO_DRAW_4_DROPLETS_LOOP:
	jmp DRAW_4_DROPLETS_LOOP

DRAW_4_DROPLETS_END_KILL:
	killChannel

COMPUTE_RANDOM_BIT_MASKS:
	add [0x37], [0x01]
	add [0x37], [HERO_ACTION_POS_MASK]
	add [0x37], [0x0C]
	add [0x37], [0x04]
	mov [0x38], [0x37]
	mov [0x3F], [0x38]
	mov [0x3E], [0x38]
	mov [0x3D], [0x38]
	mov [RANDOM_SEED], [0x38]
	mov [0x3B], [0x38]
	mov [0x3A], [0x38]
	mov [0x39], [0x38]
	and [0x3F], 0x00FF
	and [0x3E], 0x007F
	and [0x3D], 0x003F
	and [RANDOM_SEED], 0x001F
	and [0x3B], 0x000F
	and [0x3A], 0x0007
	and [0x39], 0x0003
	and [0x38], 0x0001
	ret

INIT_LAKE_VARS:
	mov [0x2A], 0x0000
	mov [0x2B], 0x0000
	mov [0x5E], 0x0000
	mov [0x1B], 0x0000
	mov [0x2C], 0x0002
	mov [0x2D], 0x0004
	mov [0x46], 0x00AA
	mov [0x47], 0x00B7
	mov [0x4A], 0x0000
	mov [0x4D], 0x0000
	mov [0x50], 0x0000
	mov [0x52], 0x00A0
	mov [0x53], 0x00B7
	mov [0x55], 0x0064
	mov [0x56], 0x00B7
	mov [0x58], 0x00C8
	mov [0x59], 0x00B7
	mov [0x5C], 0x0000
	mov [SCROLL_Y], 0x0002
	mov [0x1C], 0x0001
	mov [0x6E], 0x0000
;@if BRANCH in ("cartridge_1992", "gba_2004")
	je [0xE2], 0x00, RET_TARGET_1A88
	mov [0x2C], 0x0001
	mov [0x2D], 0x0001
	mov [0x49], 0x00C8
	mov [0x4A], 0x00B7
;@endif
	ret

INIT_CODEWHEEL_PROTECTION_SCENE:
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
	call VERIFY_INTEGRITY_OR_HALT
	mov [PAUSE_SLICES], 0x0004
	mov [0x65], 0x0000
	mov [0x66], 0x0000
	setup channel=0x3F, address=START_LAKE_BG_MUSIC_AND_DELETE_CH_0_2
	killChannel

START_LAKE_BG_MUSIC_AND_DELETE_CH_0_2:
	call INIT_LAKE_VARS
;@if BRANCH == "gba_2004"
	song id=0x0FA2, delay=0x0000, pos=0x03
;@endif
;@if BRANCH in ("cartridge_1992", "gba_2004")
	song id=0x0BB9, delay=0x0000, pos=0x00
;@endif
	deleteChannels first=0x00, last=0x02
	deleteChannels first=0x04, last=0x3B
	deleteChannels first=0x3D, last=0x3E
	setup channel=0x01, address=INIT_HERO_AT_POOL_EXIT
	setup channel=0x14, address=GETTING_OUT_OF_THE_POOL__ANIMATION_PART_4
	setup channel=0x09, address=BEETLE_INIT_POS_THEN_WALK_LEFT
;@if BRANCH in ("cartridge_1992", "gba_2004")
	setup channel=0x09, address=KILL_CHANNEL_ROUTINE
;@endif
;@if BRANCH == "dos_1992"
	setup channel=0x09, address=KILL_CHANNEL_ROUTINE
;@endif
	setup channel=0x2E, address=BEETLE_KICK_DETECTOR
	setup channel=0x2E, address=WAIT_FOR_BEETLE_OFFSCREEN_THEN_KILL
	setup channel=0x2F, address=INC_VAR_6E_PER_TICK_LOOP
	setup channel=0x30, address=WAIT_FOR_TIMER_AND_HACK_67_THEN_SETUP_31
	setup channel=0x24, address=AMBIENT_LOOP_CH24
	setup channel=0x25, address=AMBIENT_LOOP_CH25
	jmp OUTSIDE_POOL_SCREEN
	killChannel

RANDOM_AMBIENT_SOUND_LOOP:
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x24], [0x3A]
	add [0x24], 0x0028
	call PLAY_RANDOM_AMBIENT_SOUND

WAIT_RANDOM_DELAY_THEN_LOOP:
	break
	djnz [0x24], WAIT_RANDOM_DELAY_THEN_LOOP
	jmp RANDOM_AMBIENT_SOUND_LOOP
	killChannel

PLAY_RANDOM_AMBIENT_SOUND:
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0xF8], [0x3A]
	jne [0xF8], 0x00, AMBIENT_RND_CASE_1
	ret

AMBIENT_RND_CASE_1:
	jne [0xF8], 0x01, PLAY_AMBIENT_F16
	ret

PLAY_AMBIENT_F16:
	jne [0xF8], 0x02, AMBIENT_RND_CASE_3
	play id=0x0050, freq=0x16, vol=0x20, channel=0x02
	ret

AMBIENT_RND_CASE_3:
	jne [0xF8], 0x03, PLAY_AMBIENT_F05
	ret

PLAY_AMBIENT_F05:
	jne [0xF8], 0x04, AMBIENT_RND_CASE_5
	play id=0x0050, freq=0x05, vol=0x20, channel=0x02
	ret

AMBIENT_RND_CASE_5:
	jne [0xF8], 0x05, PLAY_AMBIENT_F19
	ret

PLAY_AMBIENT_F19:
	jne [0xF8], 0x06, RET_TARGET_1A88
	play id=0x0050, freq=0x19, vol=0x10, channel=0x02
	ret

AMBIENT_LOOP_CH24:
	play id=0x0010, freq=0x01, vol=0x3F, channel=0x03
	mov [0x22], 0x001E

AMBIENT_CH24_DELAY_F0:
	break
	djnz [0x22], AMBIENT_CH24_DELAY_F0
	play id=0x0010, freq=0x01, vol=0x2E, channel=0x03
	break

AMBIENT_CH24_RESTART:
	mov [0x22], 0x003C

AMBIENT_CH24_DELAY_F1:
	break
	djnz [0x22], AMBIENT_CH24_DELAY_F1
	play id=0x0008, freq=0x03, vol=0x1F, channel=0x03
	mov [0x22], 0x001E

AMBIENT_CH24_DELAY_F2:
	break
	djnz [0x22], AMBIENT_CH24_DELAY_F2
	play id=0x0010, freq=0x04, vol=0x14, channel=0x03
	mov [0x22], 0x005A

AMBIENT_CH24_DELAY_F3:
	break
	djnz [0x22], AMBIENT_CH24_DELAY_F3
	play id=0x0010, freq=0x01, vol=0x18, channel=0x03
	jmp AMBIENT_CH24_RESTART
	killChannel

AMBIENT_LOOP_CH25:
	play id=0x0010, freq=0x09, vol=0x20, channel=0x02
	break

AMBIENT_CH25_RESTART:
	mov [0x23], 0x0033

AMBIENT_CH25_DELAY_F0:
	break
	djnz [0x23], AMBIENT_CH25_DELAY_F0
	play id=0x0008, freq=0x03, vol=0x0A, channel=0x02
	mov [0x23], 0x004B

AMBIENT_CH25_DELAY_F1:
	break
	djnz [0x23], AMBIENT_CH25_DELAY_F1
	play id=0x0008, freq=0x00, vol=0x16, channel=0x02
	mov [0x23], 0x001E

AMBIENT_CH25_DELAY_F2:
	break
	djnz [0x23], AMBIENT_CH25_DELAY_F2
	play id=0x0010, freq=0x09, vol=0x0F, channel=0x02
	jmp AMBIENT_CH25_RESTART
	killChannel

INVOKE_DRAW_HELPER_ON_BG_PAGE:
	selectVideoPage 0x00
	call DRAW_HELPER_BRANCHED_ON_PROXIMITY_FLAG
	selectVideoPage 0xFF
	ret

DRAW_HELPER_AT_Y_PLUS_1:
	selectVideoPage 0x00
	add [0x02], 0x0001
	call DRAW_HELPER_BRANCHED_ON_PROXIMITY_FLAG
	sub [0x02], 0x0001
	selectVideoPage 0xFF
	ret

DRAW_HELPER_BRANCHED_ON_PROXIMITY_FLAG:
	call COMPUTE_RANDOM_BIT_MASKS
	jne [0x39], 0x00, DROPLET_VARIANT_CASE_1
	video type=1, offset=CINEMATIC_DROPLET_VARIANT_0, x=[0x01], y=[0x02], zoom=0x40
	ret

DROPLET_VARIANT_CASE_1:
	jne [0x39], 0x01, DROPLET_VARIANT_CASE_2
	video type=1, offset=CINEMATIC_DROPLET_VARIANT_1, x=[0x01], y=[0x02], zoom=0x40
	ret

DROPLET_VARIANT_CASE_2:
	jne [0x39], 0x00, DROPLET_VARIANT_CASE_3
	video type=1, offset=CINEMATIC_DROPLET_VARIANT_2, x=[0x01], y=[0x02], zoom=0x40
	ret

DROPLET_VARIANT_CASE_3:
	video type=1, offset=CINEMATIC_DROPLET_VARIANT_3, x=[0x01], y=[0x02], zoom=0x40
	ret

PARTICLE_BURST_CYCLE_LOOP_2:
;@if BRANCH in ("cartridge_1992", "dos_1992")
	video type=1, offset=CINEMATIC_PARTICLE_BURST_2_FRAME_0, x=[0x9a], y=[0x9b], zoom=0x40
