	je [0xDB], 0x00, LABEL_3B93
	setup channel=0x07, address=POOL_WATER_WAVY_GLARE_ANIMATION
;@endif

LABEL_3B93:
	break
	add [0x16], 0x0014
	mov [0x02], [0x16]
	jl [0x16], 0x0104, LABEL_3B93
