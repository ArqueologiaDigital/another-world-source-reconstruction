LABEL_49C5:
;@elif BRANCH == "chahi_amiga_1991"
WAIT_RUN_LEFT_THEN_DECEL:
;@endif
	break
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	je [0x63], 0x05, LABEL_49C5
;@elif BRANCH == "chahi_amiga_1991"
	je [0x63], 0x05, WAIT_RUN_LEFT_THEN_DECEL
;@endif
	sub [0x01], 0x0003
	break
	sub [0x01], 0x0002
	break
	sub [0x01], 0x0002
	break
	sub [0x01], 0x0001
	break
	sub [0x01], 0x0001
	break
	sub [0x01], 0x0001
	killChannel

DISPATCH_TO_HERO_ACTION_LEFT:
	mov [0x63], 0x0001
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	jmp LABEL_443D
;@elif BRANCH == "chahi_amiga_1991"
	jmp MAYBE_RESUME_WALK_LEFT_IF_GROUNDED
;@endif
	killChannel

HERO_LEAP_LEFT_PRELUDE:
	sub [0x01], 0x0004
	video type=1, offset=CINEMATIC_HERO_LIFTOFF, x=[0x01], y=[0x02], zoom=[0x03]
	add [0x01], 0x0001
	je [HERO_POS_MASK], 0x00, DISPATCH_TO_HERO_ACTION_LEFT
	break

LABEL_4464:
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_CV_000_001_002_AND_CIN_002
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_HERO_STANDING_LEFT_IDLE, x=[0x01], y=[0x02], zoom=[0x03]
;@endif
	je [HERO_POS_MASK], 0x00, DISPATCH_TO_HERO_ACTION_LEFT
	break
	je [HERO_POS_MASK], 0x00, LABEL_4464

HERO_LEAP_LEFT_LOOP:
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	setup channel=0x15, address=LABEL_49C5
;@elif BRANCH == "chahi_amiga_1991"
	setup channel=0x15, address=WAIT_RUN_LEFT_THEN_DECEL
;@endif
	sub [0x01], 0x0004

LABEL_447F:
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_HERO_SHADOW_2NDSCR_108
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_HERO_LEAP_LEFT_F0, x=[0x01], y=[0x02], zoom=[0x03]
;@endif
	mov [0x29], [0x01]
	sub [0x01], 0x0006
	play id=0x0051, freq=0x0F, vol=0x28, channel=0x01
	break
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_HERO_SHADOW_BUNDLE_109_110
	je [HERO_POS_JUMP_DOWN], 0xFFFF, HERO_RUN_LEFT_ENTRY_WITH_PREP
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_HERO_LEAP_LEFT_F1, x=[0x01], y=[0x02], zoom=[0x03]
	je [HERO_POS_JUMP_DOWN], 0xFFFF, HERO_RUN_LEFT_ENTRY_WITH_PREP
;@endif
	sub [0x01], 0x0008
	break
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_HERO_SHADOW_BUNDLE_111_112
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_HERO_LEAP_LEFT_F2, x=[0x01], y=[0x02], zoom=[0x03]
;@endif
	sub [0x01], 0x0008
	break
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_HERO_SHADOW_BUNDLE_113_114
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_HERO_LEAP_LEFT_F3, x=[0x01], y=[0x02], zoom=[0x03]
;@endif
	mov [0x29], [0x01]
	sub [0x01], 0x0008
	add [0x02], 0x0000
	break
;@if BRANCH in ("cartridge_1992", "dos_1992", "gba_2004")
	call DRAW_HERO_SHADOW_115
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_HERO_LEAP_LEFT_F4, x=[0x01], y=[0x02], zoom=[0x03]
;@endif
	mov [0x29], [0x01]
	add [0x02], 0x0000
	je [HERO_POS_MASK], 0x00, DISPATCH_TO_HERO_ACTION_LEFT
	sub [0x01], 0x000A
	break

