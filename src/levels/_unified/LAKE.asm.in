	video type=1, offset=0xB8A0, x=160, y=100
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_REED_PLANT_6, x=160, y=100
;@endif
	break
;@if BRANCH in ("cartridge_1992", "dos_1992")
	video type=1, offset=CINEMATIC_REED_PLANT_6, x=160, y=100
;@elif BRANCH == "gba_2004"
	video type=1, offset=0xB8A0, x=160, y=100
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_REED_PLANT_6, x=160, y=100
;@endif
	break
;@if BRANCH in ("cartridge_1992", "dos_1992")
	video type=1, offset=CINEMATIC_REED_PLANT_5, x=160, y=100
;@elif BRANCH == "gba_2004"
	video type=1, offset=0xB808, x=160, y=100
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_REED_PLANT_5, x=160, y=100
;@endif
	break
;@if BRANCH in ("cartridge_1992", "chahi_amiga_1991", "dos_1992")
	jmp REED_PLANT_FRAMES_5_TO_7_LOOP
;@elif BRANCH == "gba_2004"
	jmp REED_PLANT_FRAMES_5_TO_7_LOOP
;@endif
	killChannel

SNEAKY_TENTACLE_FROM_THE_POOL:
	call COMPUTE_RANDOM_BIT_MASKS
	mov [0x33], [0x3E]
	add [0x33], 0x000C

SNEAKY_TENTACLE_INIT_DELAY:
	break
	djnz [0x33], SNEAKY_TENTACLE_INIT_DELAY
	mov [0x32], [0x01]
	sub [0x32], 0x0014
	mov [0x33], 0x007C
	mov [0x34], 0x0004

SNEAKY_TENTACLE_GOING_UP:
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_0, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_0, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_1, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_1, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_2, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_2, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_3, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_3, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_4, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_4, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_5, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_5, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	sub [0x33], 0x0001
	break
	djnz [0x34], SNEAKY_TENTACLE_GOING_UP
	mov [0x33], [0x32]
	add [0x33], 0x000A
	jg [0x33], [0x01], SNEAKY_TENTACLE_GIVES_UP_FOR_NOW
	add [0x33], 0x0010
	jl [0x33], [0x01], SNEAKY_TENTACLE_GIVES_UP_FOR_NOW
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F0, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F1, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F2, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F3, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F4, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F5, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F6, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F7, x=[0x32], y=100, zoom=0x40
	add [0x32], 0x0012
	jg [0x32], [0x01], SNEAKY_TENTACLE_HIT_HERO
	add [0x32], 0x0004
	jl [0x32], [0x01], SNEAKY_TENTACLE_HIT_HERO
	deleteChannels first=0x14, last=0x16
	sub [0x32], 0x0012
	break
	setup channel=0x14, address=KILL_CHANNEL_ROUTINE
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F8, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F9, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F10, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F11, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F0, x=[0x32], y=100, zoom=0x40
	mov [PAUSE_SLICES], 0x0004
	break
	play id=0x004B, freq=0x0A, vol=0x3F, channel=0x01
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F1, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F2, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F3, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F4, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F5, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F6, x=[0x32], y=100, zoom=0x40
	break
	video type=1, offset=CINEMATIC_TENTACLE_RISE_F7, x=[0x32], y=100, zoom=0x40
	break
;@if BRANCH in ("cartridge_1992", "gba_2004")
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F12, x=[0x32], y=100, zoom=0x40
	jmp INIT_VAR_03_TO_0x1E
;@elif BRANCH == "chahi_amiga_1991"
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F12, x=[0x32], y=100, zoom=0x40
	jmp INIT_VAR_03_TO_0x1E
;@elif BRANCH == "dos_1992"
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_F12, x=[0x32], y=100, zoom=0x40
	jmp INIT_VAR_03_TO_0x1E
;@endif
	killChannel

SNEAKY_TENTACLE_HIT_HERO:
	break
	sub [0x32], 0x0005
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_0, x=[0x32], y=100, zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	break
	add [0x32], 0x0002
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_2, x=[0x32], y=106, zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	jmp SNEAKY_TENTACLE_FROM_THE_POOL
	killChannel

SNEAKY_TENTACLE_GIVES_UP_FOR_NOW:
	mov [0x34], 0x0002
	mov [0x33], 0x004C

SNEAKY_TENTACLE_GOING_DOWN:
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_0, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_0, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_1, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_1, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_2, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_2, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_3, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_3, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_4, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_4, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_5, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	video type=1, offset=CINEMATIC_SNEAKY_TENTACLE_5, x=[0x32], y=[0x33], zoom=0x40
	video type=1, offset=CINEMATIC_VIDEO_MASK_FOR_SNEAKY_TENTACLE_ANIMATION, x=[0x32], y=100, zoom=0x40
	add [0x33], 0x0002
	break
	djnz [0x34], SNEAKY_TENTACLE_GOING_DOWN
	jmp SNEAKY_TENTACLE_FROM_THE_POOL
	killChannel

CYCLE_VIDEO_PAGES_3WAY:
	jne [HACK_VAR_67], [0x65], CYCLE_VIDEO_PAGES_2WAY
	copyVideoPage src=0x03, dst=0xFF
	copyVideoPage src=0x00, dst=0x03
	copyVideoPage src=0xFF, dst=0x00
	mov [HACK_VAR_67], [0x65]
	mov [0x65], [0x66]
	mov [0x66], [HACK_VAR_67]
	jmp RET_TARGET_1915

CYCLE_VIDEO_PAGES_2WAY:
	copyVideoPage src=0x00, dst=0x03
	mov [0x65], [0x66]

RET_TARGET_1915:
	ret

VINE_SCREEN:
	mov [HACK_VAR_67], 0x0001
;@if BRANCH in ("cartridge_1992", "gba_2004")
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
;@if BRANCH == "dos_1992"
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
	call CYCLE_VIDEO_PAGES_3WAY
	setPalette 0x09
	je [0x66], 0x01, VINE_SCREEN_AFTER_BG_INIT
	mov [0x66], 0x0001
	fill page=0x00, color=0x02
	selectVideoPage 0x00
	call DRAW_SCENARIO_OF_VINE_SCREEN
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF

VINE_SCREEN_AFTER_BG_INIT:
	setup channel=0x38, address=LOOP_DRAW_VINE_FG
	je [0x5E], 0x01, VINE_SCREEN_AFTER_VINE_FG
	setup channel=0x04, address=LOOP_DRAW_CINEMATIC_VINE_SCREEN_BG_DECOR_AT_CENTER

VINE_SCREEN_AFTER_VINE_FG:
	jne [0x2A], 0x04, VINE_SCREEN_AFTER_BEAST_AI
	setup channel=0x28, address=BEAST_AI_SPAWN_FAR_RIGHT

VINE_SCREEN_AFTER_BEAST_AI:
	setup channel=0x01, address=DROPLET_FALL_AND_IMPACT_LOOP
	jmp CHECK_HERO_LAKE_EDGE
	killChannel

OUTSIDE_POOL_SCREEN:
	mov [HACK_VAR_67], 0x0002
;@if BRANCH in ("cartridge_1992", "gba_2004")
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
;@if BRANCH == "dos_1992"
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
	call CYCLE_VIDEO_PAGES_3WAY
	setPalette 0x07
	je [0x66], 0x02, VINE_SCREEN_BEAST_TRIGGER_CHK
	mov [0x66], 0x0002
	fill page=0x00, color=0x0E
	selectVideoPage 0x00
	call DRAW_OUTSIDE_POOL_SCENARIO
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF

VINE_SCREEN_BEAST_TRIGGER_CHK:
	jne [0x2A], 0x00, VINE_SCREEN_SETUP_CHANNELS
	mov [0x2A], 0x0001
	setup channel=0x07, address=THE_BEAST_APPEARS_FOR_THE_FIRST_TIME_IN_THE_BACKGROUND

VINE_SCREEN_SETUP_CHANNELS:
	setup channel=0x02, address=SCATTER_8DOT_LOOP_LEFT
	setup channel=0x03, address=SCATTER_8DOT_LOOP_RIGHT
	setup channel=0x05, address=PLAYBACK_CINEMATIC_TENTACLE_RETREAT_F0_TO_513
	setup channel=0x08, address=SNEAKY_TENTACLE_FROM_THE_POOL
	setup channel=0x33, address=SCATTER_3DOTS_INIT_RIGHT
	setup channel=0x34, address=KILL_CHANNEL_ROUTINE
	setup channel=0x35, address=SCATTER_DOTS_BURST_RIGHT_SEQ
	setup channel=0x36, address=KILL_CHANNEL_ROUTINE
	setup channel=0x37, address=SCATTER_8DOT_F3_BLINK_LOOP
	setup channel=0x38, address=REED_PLANT_ANIMATION
	jmp CHECK_HERO_VINE_SCREEN_EDGE
	killChannel

FIRST_SCREEN_TO_THE_RIGHT:
	mov [HACK_VAR_67], 0x0003
;@if BRANCH in ("cartridge_1992", "gba_2004")
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
;@if BRANCH == "dos_1992"
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
	call CYCLE_VIDEO_PAGES_3WAY
	setPalette 0x05
	je [0x66], 0x03, FIRST_SCREEN_R_BEAST_TRIGGER
	mov [0x66], 0x0003
	fill page=0x00, color=0x0E
	selectVideoPage 0x00
	call DRAW_SCENARIO_OF_FIRST_SCREEN_TO_THE_RIGHT
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF

FIRST_SCREEN_R_BEAST_TRIGGER:
	jne [0x2A], 0x01, FIRST_SCREEN_R_SETUP_CHANNELS
	mov [0x2A], 0x0002
	call COMPUTE_RANDOM_BIT_MASKS
	je [0x38], 0x00, FIRST_SCREEN_R_SETUP_CHANNELS
	mov [0x2A], 0x0003
	setup channel=0x07, address=THE_BEAST_WANDERS_ON_THE_FIRST_SCREEN_TO_THE_RIGHT

FIRST_SCREEN_R_SETUP_CHANNELS:
	setup channel=0x0B, address=MULTIPLEX_ANIM_RING1_SLOT_0
	setup channel=0x0C, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x0D, address=MULTIPLEX_ANIM_RING1_SLOT_1
	setup channel=0x0E, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x0F, address=MULTIPLEX_ANIM_RING1_SLOT_2
	setup channel=0x10, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x11, address=MULTIPLEX_ANIM_RING1_SLOT_3
	setup channel=0x12, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x13, address=MULTIPLEX_RING3_SAVE_LOOP
	setup channel=0x35, address=SCATTER_3DOT_BURST_LEFT
	setup channel=0x36, address=DRAW_8_SCATTER_DOTS_CYCLE
;@if BRANCH in ("cartridge_1992", "chahi_amiga_1991")
	setup channel=0x37, address=PARTICLE_BURST_7X_ENTRY
;@elif BRANCH in ("dos_1992", "gba_2004")
	setup channel=0x37, address=PARTICLE_BURST_7X_ENTRY
;@endif
	setup channel=0x38, address=PARTICLE_BURST_7X_LOOP
	call CLAMP_SCENE_INIT_X_VARS
	jmp CHECK_HERO_FIRST_SCR_R_EDGE
	killChannel

CLAMP_SCENE_INIT_X_VARS:
	mov [0x0C], [0x46]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x46], [0x0C]
	mov [0x0C], [0x49]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x49], [0x0C]
	mov [0x0C], [0x4C]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x4C], [0x0C]
	mov [0x0C], [0x4F]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x4F], [0x0C]
	mov [0x0C], [0x52]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x52], [0x0C]
	mov [0x0C], [0x55]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x55], [0x0C]
	mov [0x0C], [0x58]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x58], [0x0C]
	mov [0x0C], [0x5B]
	call CLAMP_HERO_X_TO_PLAYABLE_AREA
	mov [0x5B], [0x0C]
	ret

CLAMP_HERO_X_TO_PLAYABLE_AREA:
	jg [0x0C], 0x28, CLAMP_VAR_0C_HIGH
	mov [0x0C], 0x0028
	ret

CLAMP_VAR_0C_HIGH:
	jl [0x0C], 0x0118, RET_TARGET_1A88
	mov [0x0C], 0x0118

RET_TARGET_1A88:
	ret

SECOND_SCREEN_TO_THE_RIGHT:
	mov [HACK_VAR_67], 0x0004
;@if BRANCH in ("cartridge_1992", "gba_2004")
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
;@if BRANCH == "dos_1992"
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
	call CYCLE_VIDEO_PAGES_3WAY
	setPalette 0x05
	je [0x66], 0x04, SECOND_SCREEN_R_BEAST_TRIGGER
	mov [0x66], 0x0004
	fill page=0x00, color=0x0E
	selectVideoPage 0x00
	call DRAW_SCENARIO_OF_SECOND_SCREEN_TO_THE_RIGHT
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF

SECOND_SCREEN_R_BEAST_TRIGGER:
	jne [0x2A], 0x02, SECOND_SCREEN_R_SETUP_CHANNELS
	mov [0x2A], 0x0003
	setup channel=0x07, address=THE_BEAST_WANDERS_ON_THE_SECOND_SCREEN_TO_THE_RIGHT

SECOND_SCREEN_R_SETUP_CHANNELS:
	setup channel=0x0B, address=MULTIPLEX_ANIM_RING2_SLOT_0
	setup channel=0x0C, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x0D, address=MULTIPLEX_ANIM_RING2_SLOT_1
	setup channel=0x0E, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x0F, address=MULTIPLEX_ANIM_RING2_SLOT_2
	setup channel=0x10, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x11, address=MULTIPLEX_RING4_SAVE_LOOP
	setup channel=0x12, address=BEAST_AI_DISPATCH_BY_X_AND_VAR_0D
	setup channel=0x13, address=MULTIPLEX_RING5_SAVE_LOOP
	setup channel=0x36, address=SCATTER_3DOT_BURST_RIGHT
	setup channel=0x37, address=DRAW_8_SCATTER_DOTS_CYCLE
	setup channel=0x38, address=LOOP_DRAW_LAKE_018_AT_CENTER
	call CLAMP_SCENE_INIT_X_VARS
	jmp CHECK_HERO_SECOND_SCR_R_EDGE
	killChannel

THIRD_SCREEN_TO_THE_RIGHT:
	mov [HACK_VAR_67], 0x0005
;@if BRANCH in ("cartridge_1992", "gba_2004")
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
;@if BRANCH == "dos_1992"
	setup channel=0x3C, address=BLIT_FROM_PAGE_0_LOOP
;@endif
	call CYCLE_VIDEO_PAGES_3WAY
	setPalette 0x07
	je [0x66], 0x05, THIRD_SCREEN_R_BEAST_TRIGGER
	mov [0x66], 0x0005
	fill page=0x00, color=0x0E
	selectVideoPage 0x00
	call DRAW_SCENARIO_OF_THIRD_SCREEN_TO_THE_RIGHT
	selectVideoPage 0xFF
	copyVideoPage src=0x00, dst=0xFF

THIRD_SCREEN_R_BEAST_TRIGGER:
	jne [0x2A], 0x03, THIRD_SCREEN_R_SETUP_CHANNELS
	setup channel=0x28, address=WAIT_BEAST_TRIGGER_THEN_INIT

THIRD_SCREEN_R_SETUP_CHANNELS:
