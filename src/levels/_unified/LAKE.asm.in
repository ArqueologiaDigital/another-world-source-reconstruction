	jl [0x3A], [0x13], RET_TARGET_313D
;@elif BRANCH in ("chahi_amiga_1991", "dos_1992")
	jg [0x0C], [0x12], RET_TARGET_313D
	jl [0x0C], [0x13], RET_TARGET_313D
;@endif
	mov [0x07], 0x0002

RET_TARGET_313D:
