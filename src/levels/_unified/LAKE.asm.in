	jl [0x01], 0x0159, HERO_INIT_Y_AND_DISPATCH_BY_X
;@if BRANCH in ("cartridge_1992", "gba_2004")

ENTER_OUTSIDE_POOL_FROM_LEFT:
;@endif
;@if BRANCH == "dos_1992"

ENTER_OUTSIDE_POOL_FROM_LEFT:
