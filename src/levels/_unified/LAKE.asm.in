	video type=1, offset=CINEMATIC_SCATTER_8DOT_F2, x=[0x88], y=[0x8a], zoom=0x40
	add [0x88], 0x0064
	video type=1, offset=CINEMATIC_SCATTER_8DOT_F2, x=[0x88], y=[0x89], zoom=0x40
	sub [0x88], 0x0078
	jl [0x88], 0x00, SCATTER_8DOT_RIGHT_BODY

