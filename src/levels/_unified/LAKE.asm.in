	mov [0x01], 0x0000
	call ADVANCE_X_BACKWARD_ONE_SCREEN
	call KILL_CH_01_04_38
	jmp OUTSIDE_POOL_SCREEN

HERO_INIT_Y_AND_DISPATCH_BY_X:
	mov [0x02], 0x00B6
	jg [0x01], 0x6E, HERO_Y_FROM_X_RANGE_0
