	video type=1, offset=CINEMATIC_BEAST_KILLING_LESTER_9, x=160, y=100
	break
	video type=1, offset=CINEMATIC_BEAST_KILLING_LESTER_10, x=160, y=100
	play id=0x004F, freq=0x17, vol=0x3F, channel=0x03
