	video type=1, offset=CINEMATIC_BEAST_KILLED_F8, x=[0x0e], y=[0x0f], zoom=0x40
	break
	sub [0x0E], 0x0002
	video type=1, offset=CINEMATIC_BEAST_KILLED_F8, x=[0x0e], y=[0x0f], zoom=0x40
	mov [0x10], 0x0005

BEAST_KILLED_F8_REPEAT:
