	setup channel=0x10, address=BUBBLES_B_ANIMATION
	setup channel=0x0C, address=SINKING_AT_CONSOLE
	break
	mov [0x04], 0x00CE
	mov [0x06], 0x0028
	mov [0x07], 0x0118
	mov [0x09], 0x0050
;@if BRANCH == "chahi_amiga_1991"
	setup channel=0x07, address=POOL_WATER_WAVY_GLARE_ANIMATION
;@endif
;@if BRANCH == "dos_1992"
